                      }
                    }
                  },
                  {
                    "columnMatch": "InteractiveRetention",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "170px"
                    },
                    "numberFormat": {
                      "unit": 27,
                      "options": {
                        "style": "decimal",
