                          "representation": "Blank",
                          "text": "{0}"
                        }
                      ],
                      "customColumnWidthSetting": "100px"
                    }
                  },
                  {
                    "columnMatch": "BillableGB",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "whiteBlack",
                      "customColumnWidthSetting": "140px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
