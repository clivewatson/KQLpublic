                      "linkTarget": "WorkbookTemplate",
                      "linkLabel": "Click to Open [Security operations efficiency] workbook",
                      "linkIsContextBlade": false
                    }
                  },
                  {
                    "columnMatch": "note",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "100ch"
                    }
                  }
                ],
                "sortBy": [
