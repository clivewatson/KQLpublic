                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "LastSeen",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "190px"
                    }
                  },
                  {
