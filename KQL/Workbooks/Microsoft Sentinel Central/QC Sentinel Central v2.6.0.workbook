        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "retention"
      },
      "name": "group - retention"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Group: Ingestion",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Workspace Ingestion Configuration\r\n//\r\n// Shows Log Analytics workspace and Microsoft Sentinel SKU / capacity\r\n// reservation configuration for the selected Sentinel workspaces.\r\n// ======================================================================\r\n\r\nresources\r\n\r\n// ----------------------------------------------------------------------\r\n// LOG ANALYTICS WORKSPACES\r\n// ----------------------------------------------------------------------\r\n\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n\r\n| project\r\n    Workspace = tolower(name),\r\n    tenantId,\r\n    WorkspaceRetentionDays = toint(properties.retentionInDays),\r\n    WorkspaceSku = tostring(properties.sku.name),\r\n    WorkspaceCapacityGB = toint(properties.sku.capacityReservationLevel),\r\n    WorkspaceSkuLastUpdated = todatetime(properties.sku.lastSkuUpdate)\r\n\r\n// ----------------------------------------------------------------------\r\n// SENTINEL-ENABLED WORKSPACES\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=inner\r\n(\r\n    resources\r\n\r\n    | where type =~ \"microsoft.operationsmanagement/solutions\"\r\n    | where name has \"SecurityInsights\"\r\n\r\n    | parse name with * \"(\" SentinelWorkspace \")\" *\r\n\r\n    | project\r\n        Workspace = tolower(SentinelWorkspace),\r\n        SentinelSku = tostring(properties.sku.name),\r\n        SentinelCapacityGB = toint(properties.sku.capacityReservationLevel),\r\n        SentinelSkuLastUpdated = todatetime(properties.sku.lastSkuUpdate)\r\n)\r\non Workspace\r\n\r\n// ----------------------------------------------------------------------\r\n// SELECTED WORKSPACES\r\n// ----------------------------------------------------------------------\r\n\r\n// Preserve the existing Sentinel Central multi-workspace selection.\r\n| where \"{Workspace:name}\" has Workspace\r\n\r\n// Capacity reservation may be empty for non-capacity SKUs.\r\n| extend\r\n    WorkspaceCapacityGB = coalesce(WorkspaceCapacityGB, 0),\r\n    SentinelCapacityGB = coalesce(SentinelCapacityGB, 0)\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    Workspace,\r\n    [\"Workspace SKU\"] = WorkspaceSku,\r\n    [\"Sentinel SKU\"] = SentinelSku,\r\n    [\"Retention\"] = WorkspaceRetentionDays,\r\n    [\"Capacity Reservation (GB/day)\"] = WorkspaceCapacityGB,\r\n    [\"SKU Last Changed\"] = WorkspaceSkuLastUpdated\r\n\r\n| order by Workspace asc",
              "size": 1,
              "title": "⚙️ Workspace Ingestion Configuration",
              "exportedParameters": [
                {
                  "fieldName": "WorkspaceskuLevel",
                  "parameterName": "skuLevel",
                  "parameterType": 1
                },
                {
                  "fieldName": "Workspace",
                  "parameterName": "wsName",
                  "parameterType": 1
                }
              ],
              "showExportToExcel": true,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Retention",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 27,
                      "options": {
                        "style": "decimal"
                      }
                    }
                  },
                  {
                    "columnMatch": "Capacity Reservation (GB/day)",
                    "formatter": 1
                  },
                  {
                    "columnMatch": "SKU Last Changed",
                    "formatter": 6,
                    "numberFormat": {
                      "unit": 0,
                      "options": {
                        "style": "decimal"
                      }
                    },
                    "dateFormat": {
                      "showUtcTime": true,
                      "formatName": "fullDateTimePattern"
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Capacity Reservation (GB/day)",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "Capacity Reservation (GB/day)",
                  "sortOrder": 2
                }
              ]
            },
            "name": "query - sku details"
          },
          {
            "type": 1,
            "content": {
              "json": "Log Analytics and Microsoft Sentinel ingestion configuration for the selected workspaces. Capacity values show configured reservation levels where applicable; zero indicates that no capacity reservation value is reported."
            },
            "name": "text - 7"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Billable Ingestion by Workspace\r\n//\r\n// Shows billable ingestion across the selected workspaces.\r\n// Selecting a workspace exports it as wsName for the detailed\r\n// workspace analysis below.\r\n// ======================================================================\r\n\r\nUsage\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE CONTEXT\r\n// ----------------------------------------------------------------------\r\n\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n| mv-expand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n\r\n| extend workSpacename =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(split(stringtoSplit, \":\").[1])\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// BILLABLE INGESTION\r\n// ----------------------------------------------------------------------\r\n\r\n| where IsBillable == true\r\n\r\n// Usage.Quantity is MB. Convert to GB.\r\n| summarize\r\n    GBytes = sum(Quantity) / 1000.0\r\n  by\r\n    workSpacename,\r\n    bin(TimeGenerated, {TimeRange:grain})\r\n\r\n| order by TimeGenerated asc",
              "size": 0,
              "title": "📊 Billable Ingestion by Workspace — {TimeRange:label}",
              "timeContextFromParameter": "TimeRange",
              "timeBrushParameterName": "TimeRange",
              "timeBrushExportOnlyWhenBrushed": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "barchart",
              "chartSettings": {
                "ySettings": {
                  "numberFormatSettings": {
                    "unit": 39,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true
                    }
                  }
                }
              }
            },
            "name": "query - 10"
          },
          {
            "type": 1,
            "content": {
              "json": "Billable ingestion volume across the selected workspaces. Select a workspace in the chart for detailed ingestion analysis below, or drag across the chart to refine the Time Range."
            },
            "name": "text - 7"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Top 10 Billable Data Sources\r\n//\r\n// Shows the data types contributing the most billable ingestion across\r\n// all selected workspaces during the selected Time Range.\r\n//\r\n// This complements the workspace ingestion chart:\r\n//   - Workspace chart = WHERE ingestion is occurring\r\n//   - This report     = WHAT data is driving ingestion\r\n// ======================================================================\r\n\r\nUsage\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE CONTEXT\r\n// ----------------------------------------------------------------------\r\n\r\n| extend stringtoSplit =\r\n    split(\r\n        \"{WorkspaceIDguid}\",\r\n        \",\"\r\n    )\r\n\r\n| mv-expand stringtoSplit\r\n\r\n| where stringtoSplit has TenantId\r\n\r\n| extend Workspace =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(\r\n            split(\r\n                stringtoSplit,\r\n                \":\"\r\n            ).[1]\r\n        )\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// BILLABLE INGESTION\r\n// ----------------------------------------------------------------------\r\n\r\n| where IsBillable == true\r\n\r\n// Usage.Quantity is MB.\r\n// Aggregate across all selected workspaces and convert to GB.\r\n| summarize\r\n    BillableGB = sum(Quantity) / 1000.0\r\n  by DataType\r\n\r\n// ----------------------------------------------------------------------\r\n// TOP 10\r\n// ----------------------------------------------------------------------\r\n\r\n| top 10 by BillableGB desc\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    [\"Data Type\"] = DataType,\r\n    [\"Billable GB\"] = round(BillableGB, 2)\r\n\r\n| order by [\"Billable GB\"] desc",
              "size": 0,
              "title": "🏆 Top 10 Billable Data Sources",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Billable GB",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "pink"
                    }
                  }
                ]
              },
              "chartSettings": {
                "ySettings": {
                  "numberFormatSettings": {
                    "unit": 39,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                }
              }
            },
            "customWidth": "40",
            "name": "query - Top 10 by ingestion"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Top Billable Tables by Workspace\r\n//\r\n// Shows the highest billable Workspace + Data Type combinations across\r\n// the selected workspaces during the selected Time Range.\r\n//\r\n// Complements:\r\n//   - Billable Ingestion by Workspace = WHERE volume is occurring\r\n//   - Top 10 Billable Data Sources     = WHAT data types drive volume\r\n//   - This report                     = WHERE + WHAT together\r\n// ======================================================================\r\n\r\nUsage\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE CONTEXT\r\n// ----------------------------------------------------------------------\r\n\r\n| extend stringtoSplit =\r\n    split(\r\n        \"{WorkspaceIDguid}\",\r\n        \",\"\r\n    )\r\n\r\n| mv-expand stringtoSplit\r\n\r\n| where stringtoSplit has TenantId\r\n\r\n| extend Workspace =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(\r\n            split(\r\n                stringtoSplit,\r\n                \":\"\r\n            ).[1]\r\n        )\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// BILLABLE DATA\r\n// ----------------------------------------------------------------------\r\n\r\n| where IsBillable == true\r\n\r\n// Usage.Quantity is MB.\r\n// Calculate billable GB for each Workspace + Data Type combination.\r\n| summarize\r\n    BillableGB = sum(Quantity) / 1000.0\r\n  by\r\n    Workspace,\r\n    DataType\r\n\r\n// ----------------------------------------------------------------------\r\n// RANKING\r\n// ----------------------------------------------------------------------\r\n\r\n| top 20 by BillableGB desc\r\n\r\n// Percentage of the displayed Top 20 volume.\r\n// Useful for understanding relative contribution within this report.\r\n| extend DisplayLabel =\r\n    strcat(\r\n        Workspace,\r\n        \" — \",\r\n        DataType\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    Workspace,\r\n    [\"Data Type\"] = DataType,\r\n    [\"Billable GB\"] = round(BillableGB, 2)\r\n\r\n| order by [\"Billable GB\"] desc",
              "size": 0,
              "title": "🔎 Top Billable Tables by Workspace",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Billable GB",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "pink"
                    }
                  }
                ]
              },
              "chartSettings": {
                "ySettings": {
                  "numberFormatSettings": {
                    "unit": 39,
                    "options": {
                      "style": "decimal",
                      "useGrouping": true,
                      "maximumFractionDigits": 2
                    }
                  }
                }
              }
            },
            "customWidth": "40",
            "name": "query - Top Billable Tables by Workspace"
          },
          {
            "type": 1,
            "content": {
              "json": "Largest contributors to billable ingestion across the selected workspaces. Use this view to identify the data types driving overall ingestion volume."
            },
            "name": "text - 5"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "ingestion"
      },
      "name": "group - ingestion"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "Group: Tables",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Tables by Workspace\r\n//\r\n// Shows the number of distinct data types observed in each selected\r\n// workspace during the selected Time Range.\r\n//\r\n// Select a workspace for detailed table analysis below.\r\n// ======================================================================\r\n\r\nUsage\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE CONTEXT\r\n// ----------------------------------------------------------------------\r\n\r\n| extend stringtoSplit =\r\n    split(\r\n        \"{WorkspaceIDguid}\",\r\n        \",\"\r\n    )\r\n\r\n| mv-expand stringtoSplit\r\n\r\n| where stringtoSplit has TenantId\r\n\r\n| extend Workspace =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(split(stringtoSplit, \":\").[1])\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// TABLE COVERAGE\r\n// ----------------------------------------------------------------------\r\n\r\n| where isnotempty(DataType)\r\n\r\n| summarize\r\n    [\"Active Tables\"] = dcount(DataType)\r\n  by Workspace\r\n\r\n| order by [\"Active Tables\"] desc",
              "size": 0,
              "title": "📚 Active Tables by Workspace — {TimeRange:label}",
              "timeContextFromParameter": "TimeRange",
              "exportFieldName": "Workspace",
              "exportParameterName": "workSpacename",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Active Tables",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "pink",
                      "customColumnWidthSetting": "25ch"
                    }
                  },
                  {
                    "columnMatch": "CountofTables",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed",
                      "customColumnWidthSetting": "25ch"
                    }
                  },
                  {
                    "columnMatch": "TableName",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "150ch"
                    }
                  }
                ],
                "filter": true
              },
              "sortBy": []
            },
            "name": "query - tables by ws"
          },
          {
            "type": 1,
            "content": {
              "json": "Distinct data types observed in each selected workspace during the selected period. Select a workspace to review its individual tables and ingestion activ"
            },
            "name": "text - 7"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "ff66d7b3-6ecd-4d76-9677-7c9496681c58",
                  "version": "KqlParameterItem/1.0",
                  "name": "Solutions",
                  "label": "📦 Content Hub Solutions",
                  "type": 10,
                  "isRequired": true,
                  "isGlobal": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n    { \"value\":\"(@.properties.firstPublishDate.includes('-'))\", \"label\":\"All\"},\r\n    { \"value\":\"(@.properties.installedVersion.includes('.'))\", \"label\":\"Installed\", \"selected\":true}\r\n]"
                },
                {
                  "id": "deb345ad-8829-4871-8171-9482c50ca59f",
                  "version": "KqlParameterItem/1.0",
                  "name": "ws",
                  "label": "Selected Workspace Resource",
                  "type": 5,
                  "isRequired": true,
