                          "representation": "success",
                          "text": "Analytics"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Basic",
                          "representation": "Info",
                          "text": "Basic"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Auxiliary",
                          "representation": "Warning",
                          "text": "Auxiliary"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "Blank",
                          "text": "{0}"
                        }
                      ],
                      "customColumnWidthSetting": "140px"
                    }
                  },
                  {
                    "columnMatch": "IsBillable",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "false",
