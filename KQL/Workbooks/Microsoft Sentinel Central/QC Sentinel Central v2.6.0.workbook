                      }
                    }
                  },
                  {
                    "columnMatch": "ArchiveRetention",
                    "formatter": 4,
                    "formatOptions": {
                      "min": 0,
                      "max": 2555,
                      "palette": "blue",
                      "customColumnWidthSetting": "160px"
                    },
                    "numberFormat": {
