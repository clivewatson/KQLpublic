    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "📚 Query Packs",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### 📚 Query Packs\nQuery Packs are discovered from the **top-level Subscription selection**. Select a Query Pack, choose one of its stored queries, then run that query against the **top-level selected Workspace(s)**."
            },
            "name": "text - Query Pack Guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Log Analytics Query Packs\r\n//\r\n// Subscription scope is supplied by the workbook's top-level\r\n// Subscription parameter through crossComponentResources.\r\n// ======================================================================\r\n\r\nresources\r\n\r\n| where type =~ \"microsoft.operationalinsights/querypacks\"\r\n\r\n| extend\r\n    ProvisioningState = tostring(properties.provisioningState)\r\n\r\n// ----------------------------------------------------------------------\r\n// SUBSCRIPTION NAME\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=leftouter\r\n(\r\n    resourcecontainers\r\n    | where type =~ \"microsoft.resources/subscriptions\"\r\n    | project\r\n        subscriptionId,\r\n        SubscriptionName = name\r\n)\r\non subscriptionId\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n//\r\n// name, resourceGroup and subscriptionId remain under their original\r\n// field names because they are exported when a row is selected.\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    name,\r\n    SubscriptionName,\r\n    location,\r\n    resourceGroup,\r\n    subscriptionId,\r\n    ProvisioningState,\r\n    Open = id\r\n\r\n| order by\r\n    SubscriptionName asc,\r\n    name asc",
              "size": 0,
              "title": "📚 Query Packs — {$rowCount} found",
              "exportedParameters": [
                {
                  "fieldName": "name",
                  "parameterName": "queryPackName",
                  "parameterType": 1
                },
                {
                  "fieldName": "resourceGroup",
                  "parameterName": "resourceGroup",
                  "parameterType": 1
                },
                {
                  "fieldName": "subscriptionId",
                  "parameterName": "subscriptionId",
                  "parameterType": 1
                }
              ],
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "name",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "240px"
                    }
                  },
                  {
                    "columnMatch": "SubscriptionName",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "220px"
                    }
                  },
                  {
                    "columnMatch": "location",
                    "formatter": 17
                  },
                  {
                    "columnMatch": "resourceGroup",
                    "formatter": 16,
                    "formatOptions": {
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "subscriptionId",
                    "formatter": 15,
                    "formatOptions": {
                      "linkTarget": null,
                      "showIcon": true
                    }
                  },
                  {
                    "columnMatch": "Open",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Resource",
                      "linkLabel": "Open Query Pack",
                      "linkIsContextBlade": true
                    }
                  }
                ],
                "rowLimit": 2000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "SubscriptionName",
                    "sortOrder": 1
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "name",
                    "label": "Query Pack"
                  },
                  {
                    "columnId": "SubscriptionName",
                    "label": "Subscription"
                  },
                  {
                    "columnId": "location",
                    "label": "Location"
                  },
                  {
                    "columnId": "resourceGroup",
                    "label": "Resource Group"
                  },
                  {
                    "columnId": "subscriptionId",
                    "label": "Subscription ID"
                  },
                  {
                    "columnId": "ProvisioningState",
                    "label": "Provisioning State"
                  },
                  {
                    "columnId": "Open",
                    "label": "Open"
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "SubscriptionName",
                  "sortOrder": 1
                }
              ]
            },
            "name": "query - Query Pack Inventory"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"/subscriptions/{subscriptionId}/resourceGroups/{resourceGroup}/providers/microsoft.operationalInsights/querypacks/{queryPackName}/Queries\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2026-03-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value\",\"columns\":[{\"path\":\"properties.displayName\",\"columnid\":\"name\"},{\"path\":\"properties.body\",\"columnid\":\"body\"},{\"path\":\"properties.description\",\"columnid\":\"description\"},{\"path\":\"properties.tags\",\"columnid\":\"tags\"},{\"path\":\"systemData.lastModifiedAt\",\"columnid\":\"lastModifiedAt\"},{\"path\":\"systemData.lastModifiedBy\",\"columnid\":\"lastModifiedBy\"},{\"path\":\"systemData.createdBy\",\"columnid\":\"createdBy\"},{\"path\":\"systemData.createdByType\",\"columnid\":\"createdByType\"},{\"path\":\"systemData.createdAt\",\"columnid\":\"createdAt\"}]}}]}",
              "size": 1,
              "title": "📖 Queries in {queryPackName} — {$rowCount} found",
              "noDataMessage": "No queries were found in the selected Query Pack.",
              "exportedParameters": [
