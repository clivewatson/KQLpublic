    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "📚 Query Packs",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### 📚 Query Packs\nQuery Packs are discovered from the **top-level Subscription selection**. Select a Query Pack, choose one of its stored queries, then run that query against the **top-level selected Workspace(s)**."
            },
            "name": "text - Query Pack Guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Log Analytics Query Packs\r\n//\r\n// Subscription scope is supplied by the workbook's top-level\r\n// Subscription parameter through crossComponentResources.\r\n// ======================================================================\r\n\r\nresources\r\n\r\n| where type =~ \"microsoft.operationalinsights/querypacks\"\r\n\r\n| extend\r\n    ProvisioningState = tostring(properties.provisioningState)\r\n\r\n// ----------------------------------------------------------------------\r\n// SUBSCRIPTION NAME\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=leftouter\r\n(\r\n    resourcecontainers\r\n    | where type =~ \"microsoft.resources/subscriptions\"\r\n    | project\r\n        subscriptionId,\r\n        SubscriptionName = name\r\n)\r\non subscriptionId\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n//\r\n// name, resourceGroup and subscriptionId remain under their original\r\n// field names because they are exported when a row is selected.\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    name,\r\n    SubscriptionName,\r\n    location,\r\n    resourceGroup,\r\n    subscriptionId,\r\n    ProvisioningState,\r\n    Open = id\r\n\r\n| order by\r\n    SubscriptionName asc,\r\n    name asc",
              "size": 0,
              "title": "📚 Query Packs — {$rowCount} found",
              "exportedParameters": [
                {
                  "fieldName": "name",
                  "parameterName": "queryPackName",
                  "parameterType": 1
                },
                {
                  "fieldName": "resourceGroup",
                  "parameterName": "resourceGroup",
