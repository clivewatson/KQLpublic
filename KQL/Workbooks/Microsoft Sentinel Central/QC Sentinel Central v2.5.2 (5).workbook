          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Table Usage & Activity\r\n//\r\n// Shows tables observed in the selected workspaces during the selected\r\n// Time Range, whether they are billable, their ingestion volume and\r\n// activity trend.\r\n// ======================================================================\r\n\r\nlet BaseUsage =\r\n    Usage\r\n\r\n    // ------------------------------------------------------------------\r\n    // WORKSPACE CONTEXT\r\n    // ------------------------------------------------------------------\r\n\r\n    | extend stringtoSplit =\r\n        split(\r\n            \"{WorkspaceIDguid}\",\r\n            \",\"\r\n        )\r\n\r\n    | mv-expand stringtoSplit\r\n\r\n    | where stringtoSplit has TenantId\r\n\r\n    | extend workSpacename =\r\n        trim(\r\n            @\"[^\\w]+\",\r\n            tostring(split(stringtoSplit, \":\").[1])\r\n        )\r\n\r\n    | where isnotempty(DataType);\r\n\r\n\r\n// ======================================================================\r\n// TABLE SUMMARY\r\n// ======================================================================\r\n\r\nlet TableSummary =\r\n    BaseUsage\r\n\r\n    | summarize\r\n        BillableGB =\r\n            sumif(\r\n                Quantity,\r\n                IsBillable == true\r\n            ) / 1000.0,\r\n\r\n        TotalGB =\r\n            sum(Quantity) / 1000.0,\r\n\r\n        LastSeen =\r\n            max(TimeGenerated),\r\n\r\n        IsBillable =\r\n            any(IsBillable)\r\n\r\n      by\r\n        workSpacename,\r\n        DataType;\r\n\r\n\r\n// ======================================================================\r\n// TABLE ACTIVITY TREND\r\n// ======================================================================\r\n\r\nlet TableTrend =\r\n    BaseUsage\r\n\r\n    | make-series\r\n        Trend = sum(Quantity) / 1000.0\r\n        on TimeGenerated\r\n        from {TimeRange:start}\r\n        to {TimeRange:end}\r\n        step {TimeRange:grain}\r\n\r\n      by\r\n        workSpacename,\r\n        DataType;\r\n\r\n\r\n// ======================================================================\r\n// FINAL OUTPUT\r\n// ======================================================================\r\n\r\nTableSummary\r\n\r\n| join kind=leftouter\r\n    TableTrend\r\n    on workSpacename, DataType\r\n\r\n| extend BillableDisplay =\r\n    iff(\r\n        IsBillable,\r\n        \"🟢 Yes\",\r\n        \"⚪ No\"\r\n    )\r\n\r\n| project\r\n    workSpacename,\r\n    [\"Table Name\"] = DataType,\r\n    Billable = BillableDisplay,\r\n    [\"Billable GB\"] = round(BillableGB, 2),\r\n    [\"Total GB\"] = round(TotalGB, 2),\r\n    [\"Last Seen\"] = LastSeen,\r\n    Trend\r\n\r\n| order by\r\n    [\"Billable GB\"] desc,\r\n    workSpacename asc,\r\n    [\"Table Name\"] asc",
              "size": 0,
              "title": "📋 Table Usage & Activity — {TimeRange:label}",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "workSpacename",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "160px"
                    }
                  },
                  {
                    "columnMatch": "Table Name",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "220px"
                    }
                  },
                  {
                    "columnMatch": "Billable GB",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "whiteBlack",
                      "customColumnWidthSetting": "140px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "Total GB",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "120px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "Last Seen",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "190px"
                    }
                  },
                  {
                    "columnMatch": "Trend",
                    "formatter": 10,
                    "formatOptions": {
                      "palette": "pink",
                      "customColumnWidthSetting": "220px"
                    }
                  }
                ],
                "filter": true,
                "hierarchySettings": {
                  "treeType": 1,
                  "groupBy": [
                    "workSpacename"
                  ],
                  "expandTopLevel": true,
                  "finalBy": "workSpacename"
                },
                "labelSettings": [
                  {
                    "columnId": "workSpacename",
                    "label": "Workspace"
                  }
                ]
              },
              "sortBy": []
            },
            "name": "query - bill and trend"
          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "tables"
      },
      "name": "group - Tables"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "📐 Analytics Rules",
        "items": [
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "parameters": [
                {
                  "id": "2b1d3b81-3847-4840-86ad-da410dda4854",
                  "version": "KqlParameterItem/1.0",
                  "name": "ws",
                  "label": "Workspace",
                  "type": 5,
                  "isRequired": true,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| extend customerID = tostring(properties.customerId)\r\n| project\r\n    id = tolower(id),\r\n    customerID,\r\n    name = tolower(name)\r\n| where \"{Workspace:name}\" has name\r\n| order by name asc",
                  "crossComponentResources": [
                    "{Workspace}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "above",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "name": "parameters - Rules Workspace"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "d2396b84-e61b-4e41-aef3-0881bf5cfbcc",
                  "version": "KqlParameterItem/1.0",
                  "name": "status_",
                  "label": "Status",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n  { \"value\":\"(@.properties.enabled==true) || (@.properties.enabled==false)\", \"label\":\"All\" },\r\n  { \"value\":\"@.properties.enabled==true\", \"label\":\"Enabled\", \"selected\":true },\r\n  { \"value\":\"@.properties.enabled==false\", \"label\":\"Disabled\" }\r\n]"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "parameters - Rule Status"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "f6a164ad-c1b8-4765-bafa-4b773bf58a67",
                  "version": "KqlParameterItem/1.0",
                  "name": "ruleKind",
                  "label": "Rule Type",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n  { \"value\":\"(@.kind=='MicrosoftSecurityIncidentCreation') || (@.kind=='Fusion') || (@.kind=='NRT') || (@.kind=='MLBehaviorAnalytics') || (@.kind=='ThreatIntelligence') || (@.kind=='Scheduled')\", \"label\":\"All\", \"selected\":true },\r\n  { \"value\":\"@.kind=='Scheduled'\", \"label\":\"Scheduled\" },\r\n  { \"value\":\"@.kind=='NRT'\", \"label\":\"NRT\" },\r\n  { \"value\":\"@.kind=='Fusion'\", \"label\":\"Microsoft Fusion\" },\r\n  { \"value\":\"@.kind=='MicrosoftSecurityIncidentCreation'\", \"label\":\"Incident Creation\" },\r\n  { \"value\":\"@.kind=='MLBehaviorAnalytics'\", \"label\":\"ML Behavior Analytics\" },\r\n  { \"value\":\"@.kind=='ThreatIntelligence'\", \"label\":\"Threat Intelligence\" }\r\n]"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "parameters - Rule Type"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"/subscriptions/{ws:subscription}/resourceGroups/{ws:resourcegroup}/providers/Microsoft.OperationalInsights/workspaces/{ws:name}/providers/Microsoft.SecurityInsights/alertRules\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2025-03-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value[?({ruleKind} && {status_})]\",\"columns\":[{\"path\":\"$.properties.displayName\",\"columnid\":\"RuleName\"},{\"path\":\"$.properties.description\",\"columnid\":\"Description\"},{\"path\":\"$.name\",\"columnid\":\"AlertRuleID\"},{\"path\":\"$.kind\",\"columnid\":\"Kind\"},{\"path\":\"$.properties.productFilter\",\"columnid\":\"ProductName\"},{\"path\":\"$.properties.enabled\",\"columnid\":\"Status\"},{\"path\":\"$.properties.severity\",\"columnid\":\"Severity\"},{\"path\":\"$.properties.lastModifiedUtc\",\"columnid\":\"lastModifiedUtc\"},{\"path\":\"$.properties.tactics\",\"columnid\":\"Tactics\"},{\"path\":\"$.properties.techniques\",\"columnid\":\"Techniques\"},{\"path\":\"$.properties.queryFrequency\",\"columnid\":\"queryFrequency\"},{\"path\":\"$.properties.queryPeriod\",\"columnid\":\"queryPeriod\"},{\"path\":\"$.properties.triggerOperator\",\"columnid\":\"triggerOperator\"},{\"path\":\"$.properties.triggerThreshold\",\"columnid\":\"triggerThreshold\"},{\"path\":\"$.properties.eventGroupingSettings.aggregationKind\",\"columnid\":\"eventGroupingSettings\"},{\"path\":\"$.properties.entityMappings\",\"columnid\":\"entityMappings\"},{\"path\":\"$.properties.incidentConfiguration\",\"columnid\":\"incidentConfiguration\"},{\"path\":\"$.properties.alertDetailsOverride\",\"columnid\":\"alertDetailsOverride\"},{\"path\":\"$.properties\",\"columnid\":\"prop\"}]}}]}",
              "size": 0,
              "title": "📐 Analytics Rules — {ws:name} — {$rowCount} deployed",
              "noDataMessage": "No analytics rules match the selected Status and Rule Type.",
              "exportedParameters": [
                {
                  "fieldName": "AlertRuleID",
                  "parameterName": "AlertRuleID",
                  "parameterType": 1
                },
                {
                  "fieldName": "ProductName",
                  "parameterName": "ProductName",
                  "parameterType": 1
                },
                {
                  "fieldName": "Tactics",
                  "parameterName": "Tactics",
                  "parameterType": 1
                },
                {
                  "fieldName": "RuleName",
                  "parameterName": "RuleName",
                  "parameterType": 1
                },
                {
                  "fieldName": "Status",
                  "parameterName": "Status",
                  "parameterType": 1
                },
                {
                  "fieldName": "prop",
                  "parameterName": "prop",
                  "parameterType": 1
                }
              ],
              "showExportToExcel": true,
              "exportToExcelOptions": "all",
              "queryType": 12,
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "RuleName",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "300px"
                    }
                  },
                  {
                    "columnMatch": "Description",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "400px"
                    }
                  },
                  {
                    "columnMatch": "AlertRuleID",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Kind",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "150px"
                    }
                  },
                  {
                    "columnMatch": "ProductName",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Status",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
