          }
        ]
      },
      "conditionalVisibility": {
        "parameterName": "selectedTab",
        "comparison": "isEqualTo",
        "value": "incidents"
      },
      "name": "group - overview"
    },
    {
      "type": 1,
      "content": {
        "json": "---------------"
      },
      "name": "text - 9"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "🔎 Incident Details",
        "expandable": true,
        "expanded": true,
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SecurityIncident\r\n\r\n// ------------------------------------------------------------\r\n// WORKSPACE NAME\r\n// ------------------------------------------------------------\r\n\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n| mv-expand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n| extend Workspace =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(split(stringtoSplit, \":\").[1])\r\n    )\r\n\r\n// ------------------------------------------------------------\r\n// LATEST INCIDENT STATE\r\n// ------------------------------------------------------------\r\n\r\n| summarize\r\n    arg_max(TimeGenerated, *)\r\n    by TenantId, IncidentNumber\r\n\r\n// ------------------------------------------------------------\r\n// PRODUCT\r\n// ------------------------------------------------------------\r\n\r\n| extend ProductName =\r\n    tostring(\r\n        parse_json(\r\n            tostring(AdditionalData.alertProductNames)\r\n        )[0]\r\n    )\r\n\r\n| where \"All\" in ({Product})\r\n    or ProductName in ({Product})\r\n\r\n// ------------------------------------------------------------\r\n// OWNER\r\n// ------------------------------------------------------------\r\n\r\n| extend OwnerName =\r\n    coalesce(\r\n        tostring(Owner.assignedTo),\r\n        tostring(Owner.email),\r\n        \"Unassigned\"\r\n    )\r\n\r\n| extend OwnerName =\r\n    iff(\r\n        isempty(OwnerName),\r\n        \"Unassigned\",\r\n        OwnerName\r\n    )\r\n\r\n// ------------------------------------------------------------\r\n// FRIENDLY SEVERITY\r\n// ------------------------------------------------------------\r\n\r\n| extend SeverityDisplay =\r\n    case(\r\n        Severity == \"High\",          \"🔴 P1 - High\",\r\n        Severity == \"Medium\",        \"🟠 P2 - Medium\",\r\n        Severity == \"Low\",           \"🟡 P3 - Low\",\r\n        Severity == \"Informational\", \"🔵 P4 - Informational\",\r\n        Severity\r\n    )\r\n\r\n// ------------------------------------------------------------\r\n// FRIENDLY STATUS\r\n// ------------------------------------------------------------\r\n\r\n| extend StatusDisplay =\r\n    case(\r\n        Status == \"New\",    \"🆕 New\",\r\n        Status == \"Active\", \"🔄 Active\",\r\n        Status == \"Closed\", \"✅ Closed\",\r\n        Status\r\n    )\r\n\r\n// ------------------------------------------------------------\r\n// SORT\r\n// ------------------------------------------------------------\r\n\r\n| order by Workspace asc, IncidentNumber desc\r\n\r\n// ------------------------------------------------------------\r\n// FINAL OPERATIONAL VIEW\r\n// ------------------------------------------------------------\r\n\r\n| project\r\n    Workspace,\r\n    IncidentNumber,\r\n    Severity = SeverityDisplay,\r\n    Status = StatusDisplay,\r\n    Title,\r\n    Owner = OwnerName,\r\n    Product = ProductName,\r\n    [\"Last Modified\"] = LastModifiedTime,\r\n    Open = IncidentUrl",
              "size": 0,
              "title": "🚨 {$rowCount} Incidents across selected Workspaces — {TimeRange:label}",
              "timeContextFromParameter": "TimeRange",
              "exportedParameters": [
                {
                  "fieldName": "IncidentNumber",
                  "parameterName": "IncidentNumber",
                  "parameterType": 1
                },
                {
                  "fieldName": "Workspace",
                  "parameterName": "Workspace_export",
                  "parameterType": 1
                }
              ],
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "$gen_group",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "35ch"
                    }
                  },
                  {
                    "columnMatch": "Workspace",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Severity",
                    "formatter": 5
                  },
                  {
                    "columnMatch": "Open",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "Url",
                      "linkLabel": "Open in Microsoft Sentinel"
                    }
                  }
                ],
                "rowLimit": 5000,
                "filter": true,
                "hierarchySettings": {
                  "treeType": 1,
                  "groupBy": [
                    "Workspace",
                    "Severity"
                  ],
                  "expandTopLevel": true
                },
                "labelSettings": [
                  {
                    "columnId": "IncidentNumber",
                    "label": "Incident #"
                  }
                ]
              },
              "sortBy": []
            },
            "name": "query - multi Alerts"
          },
          {
            "type": 1,
            "content": {
              "json": "💡 Results are grouped by Workspace → Severity. The number shown beside a Workspace is the number of severity groups present, not the number of incidents. The number beside each Severity is the incident count."
            },
            "name": "text - Incident Grouping Guidance"
          },
          {
            "type": 1,
            "content": {
              "json": "For further analysis, open the incident directly in Microsoft Sentinel using the link in the table above. If Investigation workbooks have previously been saved in the selected workspace, selecting an incident row can also surface matching Investigation workbooks."
            },
            "customWidth": "50",
            "name": "text - Incident Investigation Guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\r\n| where type == \"microsoft.insights/workbooks\"\r\n| where properties.displayName has \"Investigation\"\r\n| where properties.displayName has \"{Workspace_export}\"\r\n| project\r\n    WorkbookName = tostring(properties.displayName),\r\n    id,\r\n    IncidentNumber = \"{IncidentNumber}\"",
              "size": 4,
              "title": "Investigation Workbooks — {Workspace_export} — Incident {IncidentNumber}",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "id",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "WorkbookTemplate",
                      "linkLabel": "Open Workbook",
                      "linkIsContextBlade": true
                    }
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "WorkbookName",
                    "label": "Workbook Name"
                  },
                  {
                    "columnId": "id",
                    "label": "Open"
                  },
                  {
                    "columnId": "IncidentNumber",
                    "label": "Incident Number"
                  }
                ]
              }
            },
            "customWidth": "50",
            "conditionalVisibility": {
              "parameterName": "Workspace_export",
              "comparison": "isNotEqualTo",
              "value": ""
            },
            "name": "query - Incident Workspace Context"
          },
          {
            "type": 1,
            "content": {
              "json": "### Select a single workspace to see incident-level details"
            },
            "name": "text - Single Workspace Heading"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "{Subscription}"
              ],
              "parameters": [
                {
                  "id": "4383a3f4-7606-41a7-b1cf-e5bffd2d9ecb",
                  "version": "KqlParameterItem/1.0",
                  "name": "iWorkspace",
                  "label": "🚨 Incident Workspace",
                  "type": 5,
                  "isRequired": true,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| extend customerID = tostring(properties.customerId)\r\n| project id, customerID, name = tolower(name)\r\n| join kind=inner (\r\n    resources\r\n    | where type =~ \"microsoft.operationsmanagement/solutions\"\r\n    | where name has \"SecurityInsights\"\r\n    | parse name with * \"(\" SentinelWorkspace \")\" *\r\n    | project name = tolower(SentinelWorkspace)\r\n) on name\r\n| extend Alpha = toupper(substring(name, 0, 1))\r\n| where Alpha in ({group})\r\n| project id = tolower(id), customerID, name\r\n| distinct id, customerID, name\r\n| order by name asc",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "value": "/subscriptions/b578c6ca-414f-49f8-b990-76b4b3d540a1/resourcegroups/soc-sense-qcyber-rg/providers/microsoft.operationalinsights/workspaces/soc-sense-sentinel-qcyber-ws"
                },
                {
                  "id": "c2494755-05cc-4b93-b253-e8a0d4b7c899",
                  "version": "KqlParameterItem/1.0",
                  "name": "iResourceGroup",
                  "label": "Incident Resource Group",
                  "type": 1,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| where tolower(name) == tolower(\"{iWorkspace:label}\")\r\n| project resourceGroup\r\n| take 1",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "isHiddenWhenLocked": true,
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "above",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "customWidth": "20",
            "name": "parameters - Incident Workspace"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "{iWorkspace}"
              ],
              "parameters": [
                {
                  "id": "93c9035c-b33a-4a33-a976-9507a04d908e",
                  "version": "KqlParameterItem/1.0",
                  "name": "selectSeverity",
                  "label": "🎚️ Severity",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "SecurityIncident\r\n| summarize arg_max(TimeGenerated, *) by IncidentNumber\r\n| where CreatedTime >= {TimeRange:start} and CreatedTime <= {TimeRange:end}\r\n| summarize Count = count() by Severity\r\n| extend SeverityOrder = case(\r\n    Severity == \"High\", 1,\r\n    Severity == \"Medium\", 2,\r\n    Severity == \"Low\", 3,\r\n    Severity == \"Informational\", 4,\r\n    5\r\n)\r\n| extend Label = case(\r\n    Severity == \"High\", strcat(\"🔴 P1 - High (\", Count, \")\"),\r\n    Severity == \"Medium\", strcat(\"🟠 P2 - Medium (\", Count, \")\"),\r\n    Severity == \"Low\", strcat(\"🟡 P3 - Low (\", Count, \")\"),\r\n    Severity == \"Informational\", strcat(\"🔵 P4 - Informational (\", Count, \")\"),\r\n    strcat(Severity, \" (\", Count, \")\")\r\n)\r\n| project Value = Severity, Label, SeverityOrder\r\n| order by SeverityOrder asc\r\n| project Value, Label",
                  "crossComponentResources": [
                    "{iWorkspace}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "value": [
                    "value::all"
                  ]
                },
                {
                  "id": "069e318c-ff99-4044-a06e-af9c22a1ce89",
                  "version": "KqlParameterItem/1.0",
                  "name": "selectStatus",
                  "label": "📌 Status",
                  "type": 2,
                  "isRequired": true,
                  "multiSelect": true,
                  "quote": "'",
                  "delimiter": ",",
                  "query": "SecurityIncident\r\n| summarize arg_max(TimeGenerated, *) by IncidentNumber\r\n| where CreatedTime >= {TimeRange:start} and CreatedTime <= {TimeRange:end}\r\n| summarize Count = count() by Status\r\n| extend StatusOrder = case(\r\n    Status == \"New\", 1,\r\n    Status == \"Active\", 2,\r\n    Status == \"Closed\", 3,\r\n    4\r\n)\r\n| extend Label = case(\r\n    Status == \"New\", strcat(\"🆕 New (\", Count, \")\"),\r\n    Status == \"Active\", strcat(\"🔄 Active (\", Count, \")\"),\r\n    Status == \"Closed\", strcat(\"✅ Closed (\", Count, \")\"),\r\n    strcat(Status, \" (\", Count, \")\")\r\n)\r\n| project Value = Status, Label, StatusOrder\r\n| order by StatusOrder asc\r\n| project Value, Label",
                  "crossComponentResources": [
                    "{iWorkspace}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [
                      "value::all"
                    ],
                    "showDefault": false
                  },
                  "defaultValue": "value::all",
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces",
                  "value": [
                    "value::all"
                  ]
                },
                {
                  "id": "dc578da6-0268-483c-a77c-eb126f4d116b",
                  "version": "KqlParameterItem/1.0",
                  "name": "total",
                  "label": "Incident Total",
                  "type": 1,
                  "isRequired": true,
                  "query": "SecurityIncident\r\n| summarize arg_max(TimeGenerated, *) by IncidentNumber\r\n| where CreatedTime >= {TimeRange:start} and CreatedTime <= {TimeRange:end}\r\n| count",
                  "crossComponentResources": [
                    "{iWorkspace}"
                  ],
                  "isHiddenWhenLocked": true,
                  "queryType": 0,
                  "resourceType": "microsoft.operationalinsights/workspaces"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "customWidth": "25",
            "name": "parameters - Incident Detail Filters"
          },
          {
            "type": 1,
            "content": {
              "json": "🔎 **Incident Details** — Select a workspace for incident-level investigation. Severity and Status filters apply to this detailed view. Open an incident directly in Microsoft Sentinel for further investigation."
            },
            "name": "text - Incident Details Guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Single Workspace Incident Details\r\n//\r\n// Shows the latest state of incidents created during the selected\r\n// Time Range.\r\n// ======================================================================\r\n\r\nSecurityIncident\r\n\r\n| summarize\r\n    arg_max(TimeGenerated, *)\r\n    by IncidentNumber\r\n\r\n| where CreatedTime >= {TimeRange:start}\r\n    and CreatedTime <= {TimeRange:end}\r\n\r\n// ----------------------------------------------------------------------\r\n// PRODUCT\r\n// ----------------------------------------------------------------------\r\n\r\n| extend ProductName =\r\n    tostring(\r\n        parse_json(\r\n            tostring(AdditionalData.alertProductNames)\r\n        )[0]\r\n    )\r\n\r\n| where \"All\" in ({Product})\r\n    or ProductName in ({Product})\r\n\r\n// ----------------------------------------------------------------------\r\n// SEVERITY\r\n// ----------------------------------------------------------------------\r\n\r\n| where \"{selectSeverity:label}\" == \"All\"\r\n    or Severity in ({selectSeverity})\r\n\r\n// ----------------------------------------------------------------------\r\n// STATUS\r\n// ----------------------------------------------------------------------\r\n\r\n| where \"{selectStatus:label}\" == \"All\"\r\n    or Status in ({selectStatus})\r\n\r\n// ----------------------------------------------------------------------\r\n// OWNER\r\n// ----------------------------------------------------------------------\r\n\r\n| extend OwnerName =\r\n    coalesce(\r\n        tostring(Owner.assignedTo),\r\n        tostring(Owner.email),\r\n        \"Unassigned\"\r\n    )\r\n\r\n| extend OwnerName =\r\n    iff(\r\n        isempty(OwnerName),\r\n        \"Unassigned\",\r\n        OwnerName\r\n    )\r\n\r\n| where \"All\" in ({Owner})\r\n    or OwnerName in ({Owner})\r\n\r\n// ----------------------------------------------------------------------\r\n// ALERT COUNT\r\n// ----------------------------------------------------------------------\r\n\r\n| extend AlertIdsDyn = todynamic(AlertIds)\r\n\r\n| extend AlertCount =\r\n    iff(\r\n        isnull(AlertIdsDyn),\r\n        0,\r\n        array_length(AlertIdsDyn)\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// MITRE ATT&CK\r\n// ----------------------------------------------------------------------\r\n\r\n| extend Tactics = todynamic(AdditionalData.tactics)\r\n| extend Techniques = todynamic(AdditionalData.techniques)\r\n| extend SubTechniques = todynamic(AdditionalData.subTechniques)\r\n\r\n// ----------------------------------------------------------------------\r\n// LABELS / COMMENTS\r\n// ----------------------------------------------------------------------\r\n\r\n| extend Tags = tostring(Labels)\r\n| extend IncidentComments = tostring(Comments)\r\n\r\n// ----------------------------------------------------------------------\r\n// FRIENDLY SEVERITY\r\n// ----------------------------------------------------------------------\r\n\r\n| extend SeverityDisplay =\r\n    case(\r\n        Severity == \"High\",          \"🔴 P1 - High\",\r\n        Severity == \"Medium\",        \"🟠 P2 - Medium\",\r\n        Severity == \"Low\",           \"🟡 P3 - Low\",\r\n        Severity == \"Informational\", \"🔵 P4 - Informational\",\r\n        Severity\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// FRIENDLY STATUS\r\n// ----------------------------------------------------------------------\r\n\r\n| extend StatusDisplay =\r\n    case(\r\n        Status == \"New\",    \"🆕 New\",\r\n        Status == \"Active\", \"🔄 Active\",\r\n        Status == \"Closed\", \"✅ Closed\",\r\n        Status\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    [\"Incident #\"] = IncidentNumber,\r\n    Severity = SeverityDisplay,\r\n    Status = StatusDisplay,\r\n    Title,\r\n    Owner = OwnerName,\r\n    Product = ProductName,\r\n    Alerts = AlertCount,\r\n    Created = CreatedTime,\r\n    [\"Last Modified\"] = LastModifiedTime,\r\n    Classification,\r\n    Open = IncidentUrl,\r\n    [\"First Modified\"] = FirstModifiedTime,\r\n    Closed = ClosedTime,\r\n    [\"Classification Reason\"] = ClassificationReason,\r\n    [\"Classification Comment\"] = ClassificationComment,\r\n    Tactics,\r\n    Techniques,\r\n    [\"Sub-Techniques\"] = SubTechniques,\r\n    Tags,\r\n    Comments = IncidentComments,\r\n    [\"Modified By\"] = ModifiedBy,\r\n    Provider = ProviderName,\r\n    Description\r\n\r\n| order by [\"Incident #\"] desc",
              "size": 0,
              "title": "🚨 Incident Details — {iWorkspace:label} — {$rowCount} Incidents — {TimeRange:label}",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{iWorkspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Alerts",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "whiteBlack"
                    }
                  },
                  {
                    "columnMatch": "Open",
                    "formatter": 1,
                    "formatOptions": {
