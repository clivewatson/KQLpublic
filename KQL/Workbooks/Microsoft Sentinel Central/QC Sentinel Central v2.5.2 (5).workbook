    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "💾 KQL Saved Searches",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "### 💾 KQL Saved Searches\nSelect one of the **top-level selected Workspaces** to inspect its saved searches. After selecting a saved query, the query can be executed against the workbook's **top-level selected Workspace(s)**."
            },
            "name": "text - Saved Search Guidance"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "54ab7c42-3983-46fd-bb6b-9a1d206eec3a",
                  "version": "KqlParameterItem/1.0",
                  "name": "SavedSearchWorkspace",
                  "label": "💾 Saved Search Workspace",
                  "type": 5,
                  "description": "Select one of the workspaces already selected in the top-level Workspace parameter.",
                  "isRequired": true,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| extend customerID = tostring(properties.customerId)\r\n| project\r\n    id = tolower(id),\r\n    customerID,\r\n    name = tolower(name)\r\n| where \"{Workspace:name}\" has name\r\n| distinct id, customerID, name\r\n| order by name asc",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "above",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "name": "parameters - Saved Search Workspace"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"{SavedSearchWorkspace}/savedSearches\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2021-06-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value\",\"columns\":[{\"path\":\"properties.displayName\",\"columnid\":\"displayName\"},{\"path\":\"properties.category\",\"columnid\":\"category\"},{\"path\":\"properties.query\",\"columnid\":\"query\"},{\"path\":\"properties.version\",\"columnid\":\"version\"},{\"path\":\"name\",\"columnid\":\"name\"}]}}]}",
              "size": 1,
              "title": "💾 Saved Searches — {SavedSearchWorkspace:name} — {$rowCount} found",
              "noDataMessage": "No saved searches were found in {SavedSearchWorkspace:name}.",
              "exportedParameters": [
                {
                  "fieldName": "query",
                  "parameterName": "savedQuery",
                  "parameterType": 1
                },
                {
                  "fieldName": "displayName",
                  "parameterName": "savedQueryName",
                  "parameterType": 1
                }
              ],
              "showExportToExcel": true,
              "queryType": 12,
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "displayName",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "260px"
                    }
                  },
                  {
                    "columnMatch": "category",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "160px"
                    }
                  },
                  {
                    "columnMatch": "query",
                    "formatter": 7,
                    "formatOptions": {
                      "linkTarget": "CellDetails",
                      "linkLabel": "View KQL",
                      "linkIsContextBlade": true
                    }
                  }
                ],
                "rowLimit": 1000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "displayName",
                    "sortOrder": 1
                  }
                ],
                "labelSettings": [
                  {
                    "columnId": "displayName",
                    "label": "Saved Search"
                  },
                  {
                    "columnId": "category",
                    "label": "Category"
                  },
                  {
                    "columnId": "query",
                    "label": "Query"
                  },
                  {
                    "columnId": "version",
                    "label": "Version"
                  },
                  {
                    "columnId": "name",
                    "label": "Saved Search ID"
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "displayName",
                  "sortOrder": 1
                }
              ]
            },
            "conditionalVisibility": {
              "parameterName": "SavedSearchWorkspace",
              "comparison": "isNotEqualTo",
              "value": ""
            },
            "name": "query - Saved Search Inventory"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "f3f7beb8-b287-45fb-8af2-c528ef55b704",
                  "version": "KqlParameterItem/1.0",
                  "name": "queryText",
                  "label": "Saved Query Text",
                  "type": 1,
                  "typeSettings": {
                    "multiLineText": true,
                    "editorLanguage": "kql"
