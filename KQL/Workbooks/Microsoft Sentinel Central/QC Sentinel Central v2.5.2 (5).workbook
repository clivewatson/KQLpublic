    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "title": "🗄️ Workspace & Table Retention",
        "items": [
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "54ab7c42-3983-46fd-bb6b-9a1d206eec3a",
                  "version": "KqlParameterItem/1.0",
                  "name": "Workspace",
                  "label": "🗄️ Retention Workspace",
                  "type": 5,
                  "description": "Select a Microsoft Sentinel workspace to review workspace and table retention.",
                  "isRequired": true,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| extend customerID = tostring(properties.customerId)\r\n| project\r\n    id = tolower(id),\r\n    customerID,\r\n    name = tolower(name)\r\n| join kind=inner\r\n(\r\n    resources\r\n    | where type =~ \"microsoft.operationsmanagement/solutions\"\r\n    | where name has \"SecurityInsights\"\r\n    | parse name with * \"(\" SentinelWorkspace \")\" *\r\n    | project name = tolower(SentinelWorkspace)\r\n)\r\non name\r\n| project id, customerID, name\r\n| distinct id, customerID, name\r\n| order by name asc",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources"
                }
              ],
              "style": "above",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "name": "parameters - Retention Workspace"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"/subscriptions/{Workspace:subscription}/resourceGroups/{Workspace:resourcegroup}/providers/Microsoft.OperationalInsights/workspaces/{Workspace:name}\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2022-10-01\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"columns\":[{\"path\":\"name\",\"columnid\":\"WorkspaceName\"},{\"path\":\"location\",\"columnid\":\"Location\"},{\"path\":\"properties.retentionInDays\",\"columnid\":\"WorkspaceRetentionDays\"},{\"path\":\"properties.workspaceCapping.dailyQuotaGb\",\"columnid\":\"DailyQuotaGb\"},{\"path\":\"properties.sku.name\",\"columnid\":\"SkuName\"}]}}]}",
              "size": 4,
              "title": "⚙️ Workspace Retention Configuration — {Workspace:name}",
              "showExportToExcel": true,
              "queryType": 12,
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "WorkspaceRetentionDays",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 27,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "DailyQuotaGb",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  }
                ],
                "rowLimit": 10,
                "labelSettings": [
                  {
                    "columnId": "WorkspaceName",
                    "label": "Workspace"
                  },
                  {
                    "columnId": "WorkspaceRetentionDays",
                    "label": "Workspace Retention"
                  },
                  {
                    "columnId": "DailyQuotaGb",
                    "label": "Daily Quota"
                  },
                  {
                    "columnId": "SkuName",
                    "label": "Workspace SKU"
                  }
                ]
              }
            },
            "name": "query - Workspace Retention Configuration"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"ARMEndpoint/1.0\",\"data\":null,\"headers\":[],\"method\":\"GET\",\"path\":\"/subscriptions/{Workspace:subscription}/resourceGroups/{Workspace:resourcegroup}/providers/Microsoft.OperationalInsights/workspaces/{Workspace:name}/tables\",\"urlParams\":[{\"key\":\"api-version\",\"value\":\"2021-12-01-preview\"}],\"batchDisabled\":false,\"transformers\":[{\"type\":\"jsonpath\",\"settings\":{\"tablePath\":\"$.value\",\"columns\":[{\"path\":\"name\",\"columnid\":\"TableName\"},{\"path\":\"properties.plan\",\"columnid\":\"TablePlan\"},{\"path\":\"properties.retentionInDays\",\"columnid\":\"InteractiveRetention\"},{\"path\":\"properties.archiveRetentionInDays\",\"columnid\":\"ArchiveRetention\"}]}}]}",
              "size": 1,
              "title": "Table Retention Source — {Workspace:name} — {$rowCount} configured tables",
              "noDataMessage": "No table retention configuration was returned for the selected workspace.",
              "showRefreshButton": true,
              "queryType": 12,
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "TableName",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "280px"
                    }
                  },
                  {
                    "columnMatch": "TablePlan",
                    "formatter": 18,
                    "formatOptions": {
                      "thresholdsOptions": "icons",
                      "thresholdsGrid": [
                        {
                          "operator": "==",
                          "thresholdValue": "Analytics",
                          "representation": "success",
                          "text": "Analytics"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Basic",
                          "representation": "Info",
                          "text": "Basic"
                        },
                        {
                          "operator": "==",
                          "thresholdValue": "Auxiliary",
                          "representation": "Warning",
                          "text": "Auxiliary"
                        },
                        {
                          "operator": "Default",
                          "thresholdValue": null,
                          "representation": "Blank",
                          "text": "{0}"
                        }
                      ]
                    }
                  },
                  {
                    "columnMatch": "InteractiveRetention",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 27,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  },
                  {
                    "columnMatch": "ArchiveRetention",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 27,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 0
                      }
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true,
                "labelSettings": [
                  {
                    "columnId": "TableName",
                    "label": "Table"
                  },
                  {
                    "columnId": "TablePlan",
                    "label": "Plan"
                  },
                  {
                    "columnId": "InteractiveRetention",
                    "label": "Interactive Retention"
                  },
                  {
                    "columnId": "ArchiveRetention",
                    "label": "Archive Retention"
                  }
                ]
              }
            },
            "conditionalVisibility": {
              "parameterName": "Help",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "TableRetentionQuery"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Active Tables for Retention Workspace\r\n//\r\n// This query executes directly against the workspace selected by the\r\n// Retention Workspace parameter.\r\n//\r\n// Usage defines the active table population for the selected Time Range.\r\n// ARM retention configuration is added by the final Merge.\r\n// ======================================================================\r\n\r\nUsage\r\n\r\n| where isnotempty(DataType)\r\n\r\n| summarize\r\n    BillableGB =\r\n        sumif(\r\n            Quantity,\r\n            IsBillable == true\r\n        ) / 1000.0,\r\n\r\n    TotalGB =\r\n        sum(Quantity) / 1000.0,\r\n\r\n    LastSeen =\r\n        max(TimeGenerated),\r\n\r\n    IsBillable =\r\n        any(IsBillable)\r\n\r\n  by DataType\r\n\r\n| project\r\n    Table = DataType,\r\n    BillableGB,\r\n    TotalGB,\r\n    LastSeen,\r\n    IsBillable\r\n\r\n| order by BillableGB desc",
              "size": 1,
              "title": "Active Table Source — {Workspace:name} — {TimeRange:label} — {$rowCount} tables",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Table",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "280px"
                    }
                  },
                  {
                    "columnMatch": "BillableGB",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "whiteBlack",
                      "customColumnWidthSetting": "150px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "TotalGB",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "140px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "LastSeen",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "200px"
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true
              },
              "sortBy": []
            },
            "conditionalVisibility": {
              "parameterName": "Help",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "LAWTableQuery"
          },
          {
            "type": 1,
            "content": {
              "json": "The report below shows tables observed in the selected workspace during the selected Time Range, enriched with their current Azure Resource Manager retention configuration. Use the table filters to review Analytics, Basic or Auxiliary plans, billable status, and archive retention. ARM may expose additional table definitions that have not ingested data during the selected period; those are intentionally excluded from the Active Table Retention report."
            },
            "name": "text - Retention Guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\",\"mergeType\":\"inner\",\"leftTable\":\"LAWTableQuery\",\"rightTable\":\"TableRetentionQuery\",\"leftColumn\":\"Table\",\"rightColumn\":\"TableName\"}],\"projectRename\":[{\"originalName\":\"[LAWTableQuery].Table\",\"mergedName\":\"Table\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].TablePlan\",\"mergedName\":\"TablePlan\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].IsBillable\",\"mergedName\":\"IsBillable\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].BillableGB\",\"mergedName\":\"BillableGB\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].TotalGB\",\"mergedName\":\"TotalGB\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].InteractiveRetention\",\"mergedName\":\"InteractiveRetention\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].ArchiveRetention\",\"mergedName\":\"ArchiveRetention\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].LastSeen\",\"mergedName\":\"LastSeen\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].TableName\"}]}",
              "size": 1,
              "title": "🗄️ Active Table Retention — {Workspace:name} — {$rowCount} tables — {TimeRange:label}",
              "noDataMessage": "No active tables with matching retention configuration were found for the selected workspace and Time Range.",
              "showRefreshButton": true,
              "showExportToExcel": true,
              "queryType": 7,
              "gridSettings": {
