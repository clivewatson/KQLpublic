    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "🚨 **Incident Overview** — Review incidents across the selected Microsoft Sentinel workspaces. Use **Severity, Product and Owner** to refine the reporting population. Incident reporting uses the latest known incident state and incidents created during the selected **Time Range**."
            },
            "name": "text - 18"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SecurityIncident\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n| mv-expand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n| extend workSpacename = trim(@\"[^\\w]+\", tostring(split(stringtoSplit, \":\").[1]))\r\n| summarize arg_max(TimeGenerated, *) by TenantId, IncidentNumber\r\n| where CreatedTime >= {TimeRange:start}\r\n    and CreatedTime <= {TimeRange:end}\r\n| summarize dcount(IncidentNumber) by [\"Workspace\"] = workSpacename",
              "size": 4,
              "title": "Count of Security Incidents for selected {$rowCount} Workspaces",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "piechart",
              "gridSettings": {
                "hierarchySettings": {
                  "treeType": 1,
                  "groupBy": [
                    "wsName"
                  ]
                },
                "sortBy": [
                  {
                    "itemKey": "wsName",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "wsName",
                  "sortOrder": 2
                }
              ]
            },
            "name": "query - 3 - Copy"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "da1cf0b1-f99f-4c9f-8f31-264996c1a446",
                  "version": "KqlParameterItem/1.0",
                  "name": "selectSeverity",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n { \"value\": \"'All'\", \"label\": \"All\", \"selected\":true},\r\n { \"value\": \"'High'\", \"label\": \"High\" },\r\n { \"value\": \"'Medium'\", \"label\": \"Medium\"},\r\n { \"value\": \"'Low'\", \"label\": \"Low\"},\r\n { \"value\": \"'Informational'\", \"label\": \"Informational\"}\r\n]"
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "parameters - 17"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Workspace Customer / Lighthouse Context\r\n//\r\n// CUSTOMER\r\n//   1. Matching Lighthouse directory/customer\r\n//   2. Full Azure subscription name\r\n//   3. Unresolved\r\n//\r\n// LIGHTHOUSE\r\n//   Yes     = matching delegation found for this workspace scope\r\n//   Unknown = no applicable delegation established from available ARG\r\n// ======================================================================\r\n\r\nresources\r\n\r\n// ----------------------------------------------------------------------\r\n// LOG ANALYTICS WORKSPACES\r\n// ----------------------------------------------------------------------\r\n\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| extend workspaceResourceId = tolower(id)\r\n\r\n| project\r\n    workspaceName = tolower(name),\r\n    workspaceResourceId,\r\n    subscriptionId,\r\n    resourceGroup,\r\n    resourceGroupLower = tolower(resourceGroup),\r\n    location,\r\n    tenantId\r\n\r\n// ----------------------------------------------------------------------\r\n// SENTINEL ENABLEMENT\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=inner\r\n(\r\n    resources\r\n    | where type =~ \"microsoft.operationsmanagement/solutions\"\r\n    | where name has \"SecurityInsights\"\r\n    | extend linkedWorkspaceResourceId =\r\n        tolower(tostring(properties.workspaceResourceId))\r\n    | project linkedWorkspaceResourceId\r\n)\r\non $left.workspaceResourceId == $right.linkedWorkspaceResourceId\r\n\r\n// ----------------------------------------------------------------------\r\n// SUBSCRIPTION NAME\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=leftouter\r\n(\r\n    ResourceContainers\r\n    | where type =~ \"microsoft.resources/subscriptions\"\r\n    | project\r\n        subscriptionId,\r\n        SubscriptionName = name\r\n)\r\non subscriptionId\r\n\r\n// ----------------------------------------------------------------------\r\n// AZURE LIGHTHOUSE REGISTRATIONS\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=leftouter\r\n(\r\n    ManagedServicesResources\r\n    | where type =~ \"microsoft.managedservices/registrationassignments\"\r\n\r\n    | extend RegistrationResourceId = tolower(id)\r\n\r\n    | extend LighthouseDirectory =\r\n        coalesce(\r\n            tostring(properties.registrationDefinition.properties.manageeTenantName),\r\n            tostring(properties.manageeTenantName)\r\n        )\r\n\r\n    | extend LighthouseManagedBy =\r\n        tostring(\r\n            properties.registrationDefinition.properties.registrationDefinitionName\r\n        )\r\n\r\n    // Derive the delegated subscription from the registration ID.\r\n    | extend DelegatedSubscriptionId =\r\n        extract(\r\n            @\"/subscriptions/([^/]+)\",\r\n            1,\r\n            RegistrationResourceId\r\n        )\r\n\r\n    // Resource-group scope is present only for RG-scoped delegation.\r\n    | extend DelegatedResourceGroup =\r\n        extract(\r\n            @\"/resourcegroups/([^/]+)\",\r\n            1,\r\n            RegistrationResourceId\r\n        )\r\n\r\n    | extend ScopeType =\r\n        iff(\r\n            isnotempty(DelegatedResourceGroup),\r\n            \"Resource Group\",\r\n            \"Subscription\"\r\n        )\r\n\r\n    | where isnotempty(LighthouseDirectory)\r\n\r\n    | project\r\n        subscriptionId = DelegatedSubscriptionId,\r\n        LighthouseDirectory,\r\n        LighthouseManagedBy,\r\n        DelegatedResourceGroup = tolower(DelegatedResourceGroup),\r\n        ScopeType\r\n)\r\non subscriptionId\r\n\r\n// ----------------------------------------------------------------------\r\n// DOES THIS REGISTRATION APPLY TO THIS WORKSPACE?\r\n// ----------------------------------------------------------------------\r\n\r\n| extend LighthouseMatch =\r\n    case(\r\n        ScopeType == \"Resource Group\"\r\n            and DelegatedResourceGroup == resourceGroupLower, 2,\r\n        ScopeType == \"Subscription\", 1,\r\n        0\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// REDUCE TO ONE ROW PER WORKSPACE\r\n// ----------------------------------------------------------------------\r\n\r\n| summarize\r\n    LighthouseMatch = max(LighthouseMatch),\r\n    LighthouseDirectory = anyif(LighthouseDirectory, LighthouseMatch > 0),\r\n    LighthouseManagedBy = anyif(LighthouseManagedBy, LighthouseMatch > 0),\r\n    LighthouseScope = anyif(ScopeType, LighthouseMatch > 0),\r\n    SubscriptionName = any(SubscriptionName),\r\n    subscriptionId = any(subscriptionId),\r\n    resourceGroup = any(resourceGroup),\r\n    location = any(location),\r\n    tenantId = any(tenantId)\r\n  by workspaceName\r\n\r\n// ----------------------------------------------------------------------\r\n// LIGHTHOUSE STATUS\r\n// ----------------------------------------------------------------------\r\n\r\n| extend AzureLighthouse =\r\n    iff(\r\n        LighthouseMatch > 0,\r\n        \"Yes\",\r\n        \"Unknown\"\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// CUSTOMER\r\n// ----------------------------------------------------------------------\r\n// Preserve the full Azure subscription name exactly as Azure reports it\r\n// whenever a direct Lighthouse customer match is unavailable.\r\n// ----------------------------------------------------------------------\r\n\r\n| extend Customer =\r\n    case(\r\n        LighthouseMatch > 0 and isnotempty(LighthouseDirectory),\r\n            LighthouseDirectory,\r\n        isnotempty(SubscriptionName),\r\n            SubscriptionName,\r\n        \"Unresolved\"\r\n    )\r\n\r\n| extend ManagedBy =\r\n    iff(\r\n        LighthouseMatch > 0 and isnotempty(LighthouseManagedBy),\r\n        LighthouseManagedBy,\r\n        \"\"\r\n    )\r\n\r\n| extend LighthouseScope =\r\n    iff(\r\n        LighthouseMatch > 0 and isnotempty(LighthouseScope),\r\n        LighthouseScope,\r\n        \"Unknown\"\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n// Directory remains the internal field name for Merge compatibility.\r\n// The visible Merge renames it to Customer.\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    Directory = Customer,\r\n    ManagedBy,\r\n    subscriptionId,\r\n    resourceGroup,\r\n    AzureLighthouse,\r\n    workspaceName,\r\n    location,\r\n    tenantId,\r\n    LighthouseScope\r\n\r\n| order by Directory asc, workspaceName asc",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ]
            },
            "conditionalVisibility": {
              "parameterName": "hide",
              "comparison": "isEqualTo",
              "value": "hide"
            },
            "name": "query - ARG to find Azure Lighthouse"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Security Incident Summary\r\n//\r\n// Population:\r\n//   1. Latest state of each incident\r\n//   2. Created during selected Time Range\r\n//   3. Severity / Owner / Product filters\r\n// ======================================================================\r\n\r\nlet Incidents =\r\n    SecurityIncident\r\n\r\n    // Workspace name.\r\n    | extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n    | mv-expand stringtoSplit\r\n    | where stringtoSplit has TenantId\r\n    | extend Workspace =\r\n        trim(\r\n            @\"[^\\w]+\",\r\n            tostring(split(stringtoSplit, \":\").[1])\r\n        )\r\n\r\n    // Latest incident state.\r\n    | summarize\r\n        arg_max(TimeGenerated, *)\r\n        by TenantId, IncidentNumber\r\n\r\n    // Selected reporting period.\r\n    | where CreatedTime >= {TimeRange:start}\r\n        and CreatedTime <= {TimeRange:end}\r\n\r\n    // Severity.\r\n    | where \"All\" in ({selectSeverity})\r\n        or Severity in ({selectSeverity})\r\n\r\n    // Owner.\r\n    | extend OwnerName =\r\n        coalesce(\r\n            tostring(Owner.assignedTo),\r\n            tostring(Owner.email),\r\n            \"Unassigned\"\r\n        )\r\n\r\n    | extend OwnerName =\r\n        iff(isempty(OwnerName), \"Unassigned\", OwnerName)\r\n\r\n    | where \"All\" in ({Owner})\r\n        or OwnerName in ({Owner})\r\n\r\n    // Product.\r\n    | extend ProductName =\r\n        tostring(parse_json(tostring(AdditionalData.alertProductNames))[0])\r\n\r\n    | extend ProductName =\r\n        case(\r\n            ProductName == \"Microsoft Cloud App Security\",\r\n                \"Microsoft Defender for Cloud Apps\",\r\n            ProductName == \"Microsoft Defender Advanced Threat Protection\",\r\n                \"Microsoft Defender for Endpoint\",\r\n            ProductName == \"Office 365 Advanced Threat Protection\",\r\n                \"Microsoft Defender for Office 365\",\r\n            ProductName == \"Azure Advanced Threat Protection\",\r\n                \"Microsoft Defender for Identity\",\r\n            ProductName == \"Azure Sentinel\",\r\n                \"Microsoft Sentinel\",\r\n            ProductName\r\n        )\r\n\r\n    | where \"All\" in ({Product})\r\n        or ProductName in ({Product})\r\n\r\n    // First action in minutes.\r\n    | extend TimeToFirstActionMinutes =\r\n        iff(\r\n            isnotempty(FirstModifiedTime)\r\n                and isnotempty(CreatedTime),\r\n            todouble(\r\n                datetime_diff(\r\n                    \"second\",\r\n                    FirstModifiedTime,\r\n                    CreatedTime\r\n                )\r\n            ) / 60.0,\r\n            real(null)\r\n        )\r\n\r\n    // Close time in minutes.\r\n    | extend TimeToCloseMinutes =\r\n        iff(\r\n            Status == \"Closed\"\r\n                and isnotempty(ClosedTime)\r\n                and isnotempty(CreatedTime),\r\n            todouble(\r\n                datetime_diff(\r\n                    \"second\",\r\n                    ClosedTime,\r\n                    CreatedTime\r\n                )\r\n            ) / 60.0,\r\n            real(null)\r\n        );\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE SUMMARY\r\n// ----------------------------------------------------------------------\r\n\r\nlet WorkspaceSummary =\r\n    Incidents\r\n    | summarize\r\n        High = countif(Severity == \"High\"),\r\n        Medium = countif(Severity == \"Medium\"),\r\n        Low = countif(Severity == \"Low\"),\r\n        Informational = countif(Severity == \"Informational\"),\r\n        Total = count(),\r\n        LastCreated = max(CreatedTime),\r\n        MedianFirstActionMinutes = percentile(TimeToFirstActionMinutes, 50),\r\n        MedianCloseMinutes = percentile(TimeToCloseMinutes, 50)\r\n      by Workspace;\r\n\r\n// ----------------------------------------------------------------------\r\n// INCIDENT TREND\r\n// ----------------------------------------------------------------------\r\n\r\nlet IncidentTrend =\r\n    Incidents\r\n    | make-series\r\n        Trend = count()\r\n        on CreatedTime\r\n        from {TimeRange:start}\r\n        to {TimeRange:end}\r\n        step {TimeRange:grain}\r\n        by Workspace;\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\nWorkspaceSummary\r\n| join kind=leftouter IncidentTrend on Workspace\r\n\r\n| extend LastIncidentMinutes =\r\n    todouble(\r\n        datetime_diff(\r\n            \"second\",\r\n            now(),\r\n            LastCreated\r\n        )\r\n    ) / 60.0\r\n\r\n| project\r\n    workSpacename = Workspace,\r\n    High,\r\n    Medium,\r\n    Low,\r\n    Informational,\r\n    Last_record = round(LastIncidentMinutes, 2),\r\n    Total,\r\n    [\"50th_PercentileMeanTime\"] = round(MedianFirstActionMinutes, 2),\r\n    [\"50th_PercentileCloseTime\"] = round(MedianCloseMinutes, 2),\r\n    IncidentTrend = Trend\r\n\r\n| order by Total desc",
              "size": 2,
              "title": "Security Incident summary for {$rowCount} Workspaces: QueryTime {$queryTime} {selectSeverity}",
              "timeContextFromParameter": "TimeRange",
              "exportFieldName": "workSpacename",
              "exportParameterName": "exportworkSpacename",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "High",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Medium",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Low",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Informational",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Total",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "coldHot"
                    }
                  },
                  {
                    "columnMatch": "Last_record",
                    "formatter": 0,
                    "numberFormat": {
                      "unit": 24,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "50th_PercentileMeanTime",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    },
                    "numberFormat": {
                      "unit": 26,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 3
                      }
                    }
                  },
                  {
                    "columnMatch": "50th_PercentileCloseTime",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "greenRed"
                    },
                    "numberFormat": {
                      "unit": 26,
                      "options": {
                        "style": "decimal",
                        "maximumFractionDigits": 3
                      }
                    }
                  },
                  {
                    "columnMatch": "Trend",
                    "formatter": 10,
                    "formatOptions": {
                      "palette": "blueDark"
                    }
                  }
                ],
                "filter": true
              },
              "sortBy": []
            },
            "conditionalVisibility": {
              "parameterName": "hide",
              "comparison": "isEqualTo",
              "value": "hide"
            },
            "name": "query - SecIncidents"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\",\"mergeType\":\"innerunique\",\"leftTable\":\"query - ARG to find Azure Lighthouse\",\"rightTable\":\"query - SecIncidents\",\"leftColumn\":\"workspaceName\",\"rightColumn\":\"workSpacename\"}],\"projectRename\":[{\"originalName\":\"[query - ARG to find Azure Lighthouse].workspaceName\",\"mergedName\":\"Workspace\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].Directory\",\"mergedName\":\"Customer\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].Total\",\"mergedName\":\"Total\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].High\",\"mergedName\":\"🔴 P1 High\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].Medium\",\"mergedName\":\"🟠 P2 Medium\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].Low\",\"mergedName\":\"🟡 P3 Low\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].Informational\",\"mergedName\":\"🔵 P4 Info\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].Last_record\",\"mergedName\":\"Last Incident\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].IncidentTrend\",\"mergedName\":\"Incident Trend\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].50th_PercentileMeanTime\",\"mergedName\":\"Median First Action\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - SecIncidents].50th_PercentileCloseTime\",\"mergedName\":\"Median Close\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].AzureLighthouse\",\"mergedName\":\"Lighthouse\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].location\",\"mergedName\":\"Region\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].ManagedBy\",\"mergedName\":\"Managed By\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].resourceGroup\",\"mergedName\":\"Resource Group\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].subscriptionId\",\"mergedName\":\"subscriptionId\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].LighthouseScope\",\"mergedName\":\"Lighthouse Scope\",\"fromId\":\"e3e16101-a776-4848-b21d-201c7e84f0e0\"},{\"originalName\":\"[query - ARG to find Azure Lighthouse].tenantId\"},{\"originalName\":\"[query - SecIncidents].workSpacename\"}]}",
