                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Impact",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        }
                      ],
                      "filter": true
                    },
                    "sortBy": [],
                    "tileSettings": {
                      "showBorder": false,
                      "titleContent": {
                        "columnMatch": "workSpacename",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "[\"Collection\"]",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "maximumSignificantDigits": 3,
                            "maximumFractionDigits": 2
                          }
                        }
                      }
                    }
                  },
                  "name": "query - MITRE Tactics"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "MITRE ATT&CK tactics associated with the selected incidents. Each incident is counted once per tactic; incidents containing multiple tactics therefore contribute to multiple columns."
                  },
                  "name": "text - 3"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// ======================================================================\r\n// Sentinel Central - MITRE ATT&CK Techniques\r\n//\r\n// Shows individual MITRE ATT&CK techniques associated with incidents\r\n// created during the selected Incident Overview Time Range.\r\n//\r\n// Each incident is counted once per technique.\r\n// ======================================================================\r\n\r\nlet BaseIncidents =\r\n    SecurityIncident\r\n\r\n    // Latest state of each incident\r\n    | summarize arg_max(TimeGenerated, *) by TenantId, IncidentNumber\r\n\r\n    // Incidents created during selected Time Range\r\n    | where CreatedTime >= {TimeRange:start}\r\n        and CreatedTime <= {TimeRange:end}\r\n\r\n    // Workspace name\r\n    | extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n    | mv-expand stringtoSplit\r\n    | where stringtoSplit has TenantId\r\n    | extend Workspace = trim(@\"[^\\w]+\", tostring(split(stringtoSplit, \":\").[1]))\r\n\r\n    // Severity\r\n    | where \"All\" in ({selectSeverity})\r\n        or Severity in ({selectSeverity})\r\n\r\n    // Owner\r\n    | extend OwnerName = tostring(Owner.assignedTo)\r\n    | extend OwnerName = iff(isempty(OwnerName), \"Unassigned\", OwnerName)\r\n    | where \"All\" in ({Owner})\r\n        or OwnerName in ({Owner})\r\n\r\n    // Product\r\n    | extend ProductName = tostring(parse_json(tostring(AdditionalData.alertProductNames))[0])\r\n    | where \"All\" in ({Product})\r\n        or ProductName in ({Product});\r\n\r\n// Workspace totals used for Incident %\r\nlet WorkspaceTotals =\r\n    BaseIncidents\r\n    | summarize WorkspaceIncidents = dcount(IncidentNumber) by Workspace;\r\n\r\n// Technique summary\r\nlet TechniqueSummary =\r\n    BaseIncidents\r\n    | extend Techniques = todynamic(AdditionalData.techniques)\r\n    | mv-expand Technique = Techniques to typeof(string)\r\n    | where isnotempty(Technique)\r\n\r\n    // Count each incident once per technique\r\n    | distinct Workspace, IncidentNumber, Technique\r\n\r\n    | summarize IncidentCount = dcount(IncidentNumber)\r\n        by Workspace, Technique;\r\n\r\nTechniqueSummary\r\n\r\n| join kind=leftouter WorkspaceTotals on Workspace\r\n\r\n| extend IncidentPercentage =\r\n    iff(\r\n        WorkspaceIncidents > 0,\r\n        round(\r\n            100.0 * todouble(IncidentCount) / todouble(WorkspaceIncidents),\r\n            1\r\n        ),\r\n        0.0\r\n    )\r\n\r\n| project\r\n    Workspace,\r\n    Technique,\r\n    [\"Incident Count\"] = IncidentCount,\r\n    [\"Incident %\"] = IncidentPercentage\r\n\r\n| order by\r\n    [\"Incident Count\"] desc,\r\n    Workspace asc,\r\n    Technique asc",
                    "size": 1,
                    "title": "🔬 MITRE ATT&CK Techniques — {$rowCount} Observed — {TimeRange:label}",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Incident Count",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Incident %",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          },
                          "numberFormat": {
                            "unit": 1,
                            "options": {
                              "style": "decimal",
                              "maximumFractionDigits": 1
                            }
                          }
                        }
                      ],
                      "filter": true
                    },
                    "sortBy": [],
                    "tileSettings": {
                      "showBorder": false,
                      "titleContent": {
                        "columnMatch": "workSpacename",
                        "formatter": 1
                      },
                      "leftContent": {
                        "columnMatch": "[\"Collection\"]",
                        "formatter": 12,
                        "formatOptions": {
                          "palette": "auto"
                        },
                        "numberFormat": {
                          "unit": 17,
                          "options": {
                            "maximumSignificantDigits": 3,
                            "maximumFractionDigits": 2
                          }
                        }
                      }
                    }
                  },
                  "name": "query - MITRE Techniques"
                },
                {
                  "type": 1,
                  "content": {
                    "json": "MITRE ATT&CK techniques associated with incidents created during the selected period. Each incident is counted once per technique. Incident % shows the proportion of selected incidents in that workspace associated with the technique."
                  },
                  "name": "text - 4"
                }
              ]
            },
            "name": "group - classification and tactics"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SecurityIncident\r\n// Get the Workspace Name(s) from a parameter\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\",\",\")\r\n| mvexpand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n| extend workSpacename = trim(@\"[^\\w]+\",tostring(split(stringtoSplit,\":\").[1]))\r\n// end of get workspace name section\r\n| summarize Total  = dcount(IncidentNumber)\r\n            by workSpacename\r\n\r\n\r\n\r\n\r\n",
              "size": 1,
              "title": "Count of Security Incidents for selected Workspaces and Severity",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
