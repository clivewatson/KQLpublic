          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Active Tables for Retention Workspace\r\n//\r\n// This query already executes against the workspace selected by the\r\n// Retention Workspace parameter.\r\n//\r\n// Do NOT re-resolve the workspace through WorkspaceIDguid.\r\n// ======================================================================\r\n\r\nUsage\r\n\r\n| where isnotempty(DataType)\r\n\r\n| summarize\r\n    BillableGB =\r\n        sumif(\r\n            Quantity,\r\n            IsBillable == true\r\n        ) / 1000.0,\r\n\r\n    TotalGB =\r\n        sum(Quantity) / 1000.0,\r\n\r\n    LastSeen =\r\n        max(TimeGenerated),\r\n\r\n    IsBillable =\r\n        any(IsBillable)\r\n\r\n  by DataType\r\n\r\n| project\r\n    Table = DataType,\r\n    BillableGB,\r\n    TotalGB,\r\n    LastSeen,\r\n    IsBillable\r\n\r\n| order by BillableGB desc",
              "size": 1,
              "title": "📊 Table Usage & Activity — {Workspace:name} — {TimeRange:label}, count: {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "Table",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "280px"
                    }
                  },
                  {
                    "columnMatch": "Billable GB",
                    "formatter": 8,
                    "formatOptions": {
                      "palette": "whiteBlack",
                      "customColumnWidthSetting": "150px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "Total GB",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "140px"
                    },
                    "numberFormat": {
                      "unit": 39,
                      "options": {
                        "style": "decimal",
                        "useGrouping": true,
                        "maximumFractionDigits": 2
                      }
                    }
                  },
                  {
                    "columnMatch": "Last Seen",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "200px"
                    }
                  }
                ],
                "rowLimit": 10000,
                "filter": true
              },
              "sortBy": []
            },
            "conditionalVisibility": {
              "parameterName": "Help",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "LAWTableQuery"
          },
          {
            "type": 1,
            "content": {
              "json": "Retention configuration is sourced from Azure Resource Manager and reflects the configured table plan and retention periods. Table Usage & Activity is sourced from Log Analytics Usage data for the selected workbook period; it shows observed ingestion rather than stored table size."
            },
            "name": "text - Retention Guidance"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "{\"version\":\"Merge/1.0\",\"merges\":[{\"id\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\",\"mergeType\":\"inner\",\"leftTable\":\"LAWTableQuery\",\"rightTable\":\"TableRetentionQuery\",\"leftColumn\":\"Table\",\"rightColumn\":\"TableName\"}],\"projectRename\":[{\"originalName\":\"[LAWTableQuery].Table\",\"mergedName\":\"Table\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].TablePlan\",\"mergedName\":\"TablePlan\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].IsBillable\",\"mergedName\":\"IsBillable\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].BillableGB\",\"mergedName\":\"BillableGB\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].TotalGB\",\"mergedName\":\"TotalGB\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].InteractiveRetention\",\"mergedName\":\"InteractiveRetention\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].ArchiveRetention\",\"mergedName\":\"ArchiveRetention\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[LAWTableQuery].LastSeen\",\"mergedName\":\"LastSeen\",\"fromId\":\"e3a3f78c-f05b-458f-85ec-2bc8e5821101\"},{\"originalName\":\"[TableRetentionQuery].TableName\"}]}",
              "size": 1,
              "title": "🗄️ Active Table Retention — {Workspace:name} — {$rowCount} tables",
              "noDataMessage": "No active tables matched the selected retention configuration.",
              "showRefreshButton": true,
