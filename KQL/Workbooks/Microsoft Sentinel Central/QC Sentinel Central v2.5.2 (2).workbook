          {
            "type": 12,
            "content": {
              "version": "NotebookGroup/1.0",
              "groupType": "editable",
              "title": "🧭 Classification & MITRE ATT&CK",
              "expandable": true,
              "items": [
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// ======================================================================\r\n// Sentinel Central - Incident Classification Summary\r\n//\r\n// Shows classification outcomes for CLOSED incidents created during\r\n// the selected Incident Overview Time Range.\r\n//\r\n// Uses the latest known state of each incident and prevents\r\n// SecurityIncident history/update records from inflating counts.\r\n// ======================================================================\r\n\r\nSecurityIncident\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE NAME\r\n// ----------------------------------------------------------------------\r\n\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n| mv-expand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n\r\n| extend Workspace =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(split(stringtoSplit, \":\").[1])\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// LATEST INCIDENT STATE\r\n// ----------------------------------------------------------------------\r\n\r\n| summarize\r\n    arg_max(TimeGenerated, *)\r\n    by TenantId, IncidentNumber\r\n\r\n// ----------------------------------------------------------------------\r\n// TIME RANGE\r\n// ----------------------------------------------------------------------\r\n//\r\n// Incident Overview is based on incidents CREATED during the\r\n// selected workbook Time Range.\r\n//\r\n\r\n| where CreatedTime >= {TimeRange:start}\r\n    and CreatedTime <= {TimeRange:end}\r\n\r\n// ----------------------------------------------------------------------\r\n// CLOSED INCIDENTS\r\n// ----------------------------------------------------------------------\r\n\r\n| where Status == \"Closed\"\r\n\r\n// ----------------------------------------------------------------------\r\n// INCIDENT OVERVIEW FILTERS\r\n// ----------------------------------------------------------------------\r\n\r\n// Severity\r\n| where \"All\" in ({selectSeverity})\r\n    or Severity in ({selectSeverity})\r\n\r\n// Owner\r\n| extend OwnerName =\r\n    tostring(Owner.assignedTo)\r\n\r\n| extend OwnerName =\r\n    iff(\r\n        isempty(OwnerName),\r\n        \"Unassigned\",\r\n        OwnerName\r\n    )\r\n\r\n| where \"All\" in ({Owner})\r\n    or OwnerName in ({Owner})\r\n\r\n// Product\r\n| extend ProductName =\r\n    tostring(\r\n        parse_json(\r\n            tostring(AdditionalData.alertProductNames)\r\n        )[0]\r\n    )\r\n\r\n| where \"All\" in ({Product})\r\n    or ProductName in ({Product})\r\n\r\n// ----------------------------------------------------------------------\r\n// CLASSIFICATION CLEANUP\r\n// ----------------------------------------------------------------------\r\n\r\n| extend Classification =\r\n    iff(\r\n        isempty(Classification),\r\n        \"Unclassified\",\r\n        Classification\r\n    )\r\n\r\n| extend ClassificationReason =\r\n    iff(\r\n        isempty(ClassificationReason),\r\n        \"Not specified\",\r\n        ClassificationReason\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// CLASSIFICATION SUMMARY\r\n// ----------------------------------------------------------------------\r\n//\r\n// Conditional aggregation avoids brittle pivot columns and guarantees\r\n// that every classification column exists even when its value is zero.\r\n//\r\n\r\n| summarize\r\n\r\n    BenignPositive =\r\n        countif(\r\n            Classification == \"BenignPositive\"\r\n        ),\r\n\r\n    FalsePositive =\r\n        countif(\r\n            Classification == \"FalsePositive\"\r\n        ),\r\n\r\n    TruePositive =\r\n        countif(\r\n            Classification == \"TruePositive\"\r\n        ),\r\n\r\n    Undetermined =\r\n        countif(\r\n            Classification == \"Undetermined\"\r\n        ),\r\n\r\n    Unclassified =\r\n        countif(\r\n            Classification == \"Unclassified\"\r\n        ),\r\n\r\n    Total =\r\n        count()\r\n\r\n  by\r\n    Workspace,\r\n    ClassificationReason\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    Workspace,\r\n    [\"Classification Reason\"] = ClassificationReason,\r\n    [\"🟢 Benign Positive\"] = BenignPositive,\r\n    [\"🔵 False Positive\"] = FalsePositive,\r\n    [\"🔴 True Positive\"] = TruePositive,\r\n    [\"🟡 Undetermined\"] = Undetermined,\r\n    [\"⚪ Unclassified\"] = Unclassified,\r\n    Total\r\n\r\n| order by\r\n    Workspace asc,\r\n    Total desc",
                    "size": 1,
                    "title": "🧭 Incident Classification — {TimeRange:label}",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "set_ClassificationComment",
                          "formatter": 7,
                          "formatOptions": {
                            "linkTarget": "CellDetails",
                            "linkIsContextBlade": true
                          }
                        },
                        {
                          "columnMatch": "BenignPositive",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "greenRed",
                            "customColumnWidthSetting": "150px"
                          }
                        },
                        {
                          "columnMatch": "FalsePositive",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "greenRed",
                            "customColumnWidthSetting": "150px"
                          }
                        },
                        {
                          "columnMatch": "TruePositive",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "greenRed",
                            "customColumnWidthSetting": "150px"
                          }
                        },
                        {
                          "columnMatch": "Undetermined",
                          "formatter": 4,
                          "formatOptions": {
                            "palette": "greenRed",
                            "customColumnWidthSetting": "150px"
                          }
