                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Lateral Movement",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Collection",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Command & Control",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Exfiltration",
                          "formatter": 8,
