    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 1,
            "content": {
              "json": "🚨 Incident Overview\r\nReview incidents across the selected Microsoft Sentinel workspaces. Incident counts use the latest known state of each incident and are scoped to incidents created during the selected Time Range. Use Severity, Product and Owner to refine the overview. Classification reports closed incidents only; MITRE reports show tactics and techniques associated with the selected incident population."
            },
            "name": "text - 18"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "SecurityIncident\r\n// Get the Workspace Name(s) from a parameter\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\",\",\")\r\n| mv-expand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n| extend workSpacename = trim(@\"[^\\w]+\",tostring(split(stringtoSplit,\":\").[1]))\r\n// end of get workspace name section\r\n| summarize dcount(IncidentNumber) by   [\"Workspace\"] = workSpacename\r\n\r\n\r\n\r\n",
              "size": 4,
              "title": "Count of Security Incidents for selected {$rowCount} Workspaces",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "piechart",
              "gridSettings": {
                "hierarchySettings": {
                  "treeType": 1,
                  "groupBy": [
                    "wsName"
                  ]
                },
                "sortBy": [
                  {
                    "itemKey": "wsName",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "wsName",
                  "sortOrder": 2
                }
              ]
            },
            "name": "query - 3 - Copy"
          },
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "parameters": [
                {
                  "id": "da1cf0b1-f99f-4c9f-8f31-264996c1a446",
                  "version": "KqlParameterItem/1.0",
                  "name": "selectSeverity",
                  "type": 10,
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n { \"value\": \"'All'\", \"label\": \"All\", \"selected\":true},\r\n { \"value\": \"'High'\", \"label\": \"High\" },\r\n { \"value\": \"'Medium'\", \"label\": \"Medium\"}, \r\n { \"value\": \"'Low'\", \"label\": \"Low\"}, \r\n { \"value\": \"'Informational'\", \"label\": \"Informational\"}\r\n]",
                  "timeContext": {
                    "durationMs": 86400000
                  }
                }
              ],
              "style": "above",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces"
            },
            "name": "parameters - 17"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "resources\r\n// ----------------------------------------------------------------------\r\n// LOG ANALYTICS WORKSPACES\r\n// ----------------------------------------------------------------------\r\n// The workspace itself is authoritative for:\r\n//   - Workspace name\r\n//   - Subscription\r\n//   - Resource Group\r\n//   - Region\r\n//   - Tenant\r\n// ----------------------------------------------------------------------\r\n\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n\r\n| extend workspaceResourceId = tolower(id)\r\n\r\n| project\r\n    workspaceName = tolower(name),\r\n    workspaceResourceId,\r\n    subscriptionId,\r\n    resourceGroup,\r\n    location,\r\n    tenantId\r\n\r\n// ----------------------------------------------------------------------\r\n// SENTINEL ENABLEMENT\r\n// ----------------------------------------------------------------------\r\n// Only retain workspaces where the SecurityInsights solution exists.\r\n// Join using the actual workspace resource ID rather than subscription.\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=inner\r\n(\r\n    resources\r\n    | where type =~ \"microsoft.operationsmanagement/solutions\"\r\n    | where name has \"SecurityInsights\"\r\n\r\n    | extend linkedWorkspaceResourceId =\r\n        tolower(tostring(properties.workspaceResourceId))\r\n\r\n    | project linkedWorkspaceResourceId\r\n)\r\non $left.workspaceResourceId == $right.linkedWorkspaceResourceId\r\n\r\n// ----------------------------------------------------------------------\r\n// AZURE LIGHTHOUSE CONTEXT\r\n// ----------------------------------------------------------------------\r\n// Add Lighthouse information by subscription.\r\n// Workspace resourceGroup remains authoritative and is NOT replaced\r\n// with a Managed Services registration resource group.\r\n// ----------------------------------------------------------------------\r\n\r\n| join kind=leftouter\r\n(\r\n    ManagedServicesResources\r\n\r\n    | extend Directory =\r\n        tostring(\r\n            properties.registrationDefinition.properties.manageeTenantName\r\n        )\r\n\r\n    | extend DirectoryFallback =\r\n        tostring(properties.manageeTenantName)\r\n\r\n    | extend Directory =\r\n        iif(\r\n            isempty(Directory),\r\n            DirectoryFallback,\r\n            Directory\r\n        )\r\n\r\n    | extend ManagedBy =\r\n        tostring(\r\n            properties.registrationDefinition.properties.registrationDefinitionName\r\n        )\r\n\r\n    | where isnotempty(Directory)\r\n\r\n    | summarize\r\n        Directory = any(Directory),\r\n        ManagedBy = any(ManagedBy)\r\n      by subscriptionId\r\n\r\n    | extend AzureLighthouse = \"Yes\"\r\n)\r\non subscriptionId\r\n\r\n// ----------------------------------------------------------------------\r\n// LOCAL / LIGHTHOUSE DISPLAY\r\n// ----------------------------------------------------------------------\r\n\r\n| extend AzureLighthouse =\r\n    iif(\r\n        isempty(AzureLighthouse),\r\n        \"No\",\r\n        AzureLighthouse\r\n    )\r\n\r\n| extend Directory =\r\n    iif(\r\n        AzureLighthouse == \"No\" or isempty(Directory),\r\n        \"Local\",\r\n        Directory\r\n    )\r\n\r\n| extend ManagedBy =\r\n    iif(\r\n        AzureLighthouse == \"No\" or isempty(ManagedBy),\r\n        \"Local tenant\",\r\n        ManagedBy\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    Directory,\r\n    ManagedBy,\r\n    subscriptionId,\r\n    resourceGroup,\r\n    AzureLighthouse,\r\n    workspaceName,\r\n    location\r\n\r\n| order by\r\n    AzureLighthouse asc,\r\n    workspaceName asc",
              "size": 0,
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources",
              "crossComponentResources": [
                "{Subscription}"
              ]
            },
            "conditionalVisibility": {
              "parameterName": "hide",
              "comparison": "isEqualTo",
              "value": "hide"
            },
            "name": "query - ARG to find Azure Lighthouse"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ======================================================================\r\n// Sentinel Central - Security Incident Summary\r\n//\r\n// One canonical incident population is used for:\r\n//   - Severity counts\r\n//   - Total incidents\r\n//   - Last incident record\r\n//   - Median First Action\r\n//   - Median Close\r\n//   - Incident Trend\r\n//\r\n// Duration outputs are in MINUTES to match Workbook formatting.\r\n// ======================================================================\r\n\r\n\r\n// ----------------------------------------------------------------------\r\n// BASE INCIDENT POPULATION\r\n// ----------------------------------------------------------------------\r\n\r\nlet Incidents =\r\n    SecurityIncident\r\n\r\n    // ------------------------------------------------------------\r\n    // WORKSPACE NAME\r\n    // ------------------------------------------------------------\r\n\r\n    // Map TenantId (Workspace ID) to the workspace name\r\n    // from Sentinel Central's selected workspace parameter.\r\n    | extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n    | mv-expand stringtoSplit\r\n    | where stringtoSplit has TenantId\r\n\r\n    | extend Workspace =\r\n        trim(\r\n            @\"[^\\w]+\",\r\n            tostring(split(stringtoSplit, \":\").[1])\r\n        )\r\n\r\n    // ------------------------------------------------------------\r\n    // LATEST INCIDENT STATE\r\n    // ------------------------------------------------------------\r\n\r\n    // SecurityIncident contains multiple records as incidents change.\r\n    // Keep only the latest state of each incident in each workspace.\r\n    | summarize\r\n        arg_max(TimeGenerated, *)\r\n        by TenantId, IncidentNumber\r\n\r\n    // ------------------------------------------------------------\r\n    // SEVERITY FILTER\r\n    // ------------------------------------------------------------\r\n\r\n    | where \"All\" in ({selectSeverity})\r\n        or Severity in ({selectSeverity})\r\n\r\n    // ------------------------------------------------------------\r\n    // OWNER\r\n    // ------------------------------------------------------------\r\n\r\n    | extend OwnerName =\r\n        tostring(Owner.assignedTo)\r\n\r\n    | extend OwnerName =\r\n        iff(\r\n            isempty(OwnerName),\r\n            \"Unassigned\",\r\n            OwnerName\r\n        )\r\n\r\n    | where \"All\" in ({Owner})\r\n        or OwnerName in ({Owner})\r\n\r\n    // ------------------------------------------------------------\r\n    // PRODUCT\r\n    // ------------------------------------------------------------\r\n\r\n    | extend ProductName =\r\n        tostring(\r\n            parse_json(\r\n                tostring(AdditionalData.alertProductNames)\r\n            )[0]\r\n        )\r\n\r\n    | where \"All\" in ({Product})\r\n        or ProductName in ({Product})\r\n\r\n    // ------------------------------------------------------------\r\n    // TIME TO FIRST ACTION\r\n    // ------------------------------------------------------------\r\n    //\r\n    // FirstModifiedTime - CreatedTime\r\n    //\r\n    // Calculate in seconds first and divide by 60 so that\r\n    // sub-minute precision is retained.\r\n    //\r\n    // Output unit = MINUTES\r\n    // ------------------------------------------------------------\r\n\r\n    | extend TimeToFirstActionMinutes =\r\n        iff(\r\n            isnotempty(FirstModifiedTime)\r\n                and isnotempty(CreatedTime),\r\n\r\n            todouble(\r\n                datetime_diff(\r\n                    \"second\",\r\n                    FirstModifiedTime,\r\n                    CreatedTime\r\n                )\r\n            ) / 60.0,\r\n\r\n            real(null)\r\n        )\r\n\r\n    // ------------------------------------------------------------\r\n    // TIME TO CLOSE\r\n    // ------------------------------------------------------------\r\n    //\r\n    // ClosedTime - CreatedTime\r\n    //\r\n    // Only calculate for closed incidents.\r\n    //\r\n    // Output unit = MINUTES\r\n    // ------------------------------------------------------------\r\n\r\n    | extend TimeToCloseMinutes =\r\n        iff(\r\n            Status == \"Closed\"\r\n                and isnotempty(ClosedTime)\r\n                and isnotempty(CreatedTime),\r\n\r\n            todouble(\r\n                datetime_diff(\r\n                    \"second\",\r\n                    ClosedTime,\r\n                    CreatedTime\r\n                )\r\n            ) / 60.0,\r\n\r\n            real(null)\r\n        );\r\n\r\n\r\n// ======================================================================\r\n// WORKSPACE SUMMARY\r\n// ======================================================================\r\n\r\nlet WorkspaceSummary =\r\n    Incidents\r\n\r\n    | summarize\r\n\r\n        High =\r\n            countif(\r\n                Severity == \"High\"\r\n            ),\r\n\r\n        Medium =\r\n            countif(\r\n                Severity == \"Medium\"\r\n            ),\r\n\r\n        Low =\r\n            countif(\r\n                Severity == \"Low\"\r\n            ),\r\n\r\n        Informational =\r\n            countif(\r\n                Severity == \"Informational\"\r\n            ),\r\n\r\n        // Because Incidents has already been reduced to one\r\n        // latest record per IncidentNumber, count() is now\r\n        // the actual number of incidents.\r\n        Total =\r\n            count(),\r\n\r\n        // Latest SecurityIncident record represented\r\n        // in the current filtered population.\r\n        LastRecord =\r\n            max(TimeGenerated),\r\n\r\n        // Median / P50 First Action time.\r\n        MedianFirstActionMinutes =\r\n            percentile(\r\n                TimeToFirstActionMinutes,\r\n                50\r\n            ),\r\n\r\n        // Median / P50 closure time.\r\n        // Null values from non-closed incidents are ignored.\r\n        MedianCloseMinutes =\r\n            percentile(\r\n                TimeToCloseMinutes,\r\n                50\r\n            )\r\n\r\n      by Workspace;\r\n\r\n\r\n// ======================================================================\r\n// INCIDENT TREND\r\n// ======================================================================\r\n//\r\n// Show incidents CREATED during the selected workbook Time Range.\r\n//\r\n// CreatedTime is used instead of TimeGenerated so that the trend\r\n// represents new incidents rather than SecurityIncident update records.\r\n// ======================================================================\r\n\r\nlet IncidentTrend =\r\n    Incidents\r\n\r\n    | where CreatedTime >= {TimeRange:start}\r\n        and CreatedTime <= {TimeRange:end}\r\n\r\n    | make-series\r\n        Trend = count()\r\n        on CreatedTime\r\n        from {TimeRange:start}\r\n        to {TimeRange:end}\r\n        step {TimeRange:grain}\r\n        by Workspace;\r\n\r\n\r\n// ======================================================================\r\n// FINAL RESULT\r\n// ======================================================================\r\n\r\nWorkspaceSummary\r\n\r\n| join kind=leftouter\r\n    IncidentTrend\r\n    on Workspace\r\n\r\n// Calculate age of latest incident record in MINUTES.\r\n| extend LastRecordMinutes =\r\n    todouble(\r\n        datetime_diff(\r\n            \"second\",\r\n            now(),\r\n            LastRecord\r\n        )\r\n    ) / 60.0\r\n\r\n// ----------------------------------------------------------------------\r\n// COMPATIBILITY OUTPUT\r\n// ----------------------------------------------------------------------\r\n//\r\n// Retain the original Sentinel Central field names so that the\r\n// existing Merge continues to work without modification.\r\n//\r\n// All three time values below are MINUTES.\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n\r\n    workSpacename = Workspace,\r\n\r\n    High,\r\n\r\n    Medium,\r\n\r\n    Low,\r\n\r\n    Informational,\r\n\r\n    Last_record =\r\n        round(\r\n            LastRecordMinutes,\r\n            2\r\n        ),\r\n\r\n    Total,\r\n\r\n    [\"50th_PercentileMeanTime\"] =\r\n        round(\r\n            MedianFirstActionMinutes,\r\n            2\r\n        ),\r\n\r\n    [\"50th_PercentileCloseTime\"] =\r\n        round(\r\n            MedianCloseMinutes,\r\n            2\r\n        ),\r\n\r\n    IncidentTrend = Trend\r\n\r\n| order by Total desc",
              "size": 2,
              "title": "Security Incident summary for {$rowCount} Workspaces:  QueryTime {$queryTime}  {selectSeverity}",
              "timeContextFromParameter": "TimeRange",
              "exportFieldName": "workSpacename",
              "exportParameterName": "exportworkSpacename",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{Workspace}"
              ],
              "visualization": "table",
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "High",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Medium",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Low",
                    "formatter": 4,
                    "formatOptions": {
                      "palette": "greenRed"
                    }
                  },
                  {
                    "columnMatch": "Informational",
