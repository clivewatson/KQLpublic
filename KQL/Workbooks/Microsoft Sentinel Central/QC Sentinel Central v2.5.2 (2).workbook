                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Execution",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Persistence",
                          "formatter": 8,
