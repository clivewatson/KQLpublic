                  "jsonData": "[\r\n  { \"value\":\"(@.properties.plan=='Analytics') || (@.properties.plan=='Basic') || (@.properties.plan=='Auxiliary')\", \"label\":\"All\", \"selected\":true },\r\n  { \"value\":\"(@.properties.plan=='Analytics')\", \"label\":\"Analytics Logs\" },\r\n  { \"value\":\"(@.properties.plan=='Basic')\", \"label\":\"Basic Logs\" },\r\n  { \"value\":\"(@.properties.plan=='Auxiliary')\", \"label\":\"Auxiliary Logs\" },\r\n  { \"value\":\"(@.properties.archiveRetentionInDays > 0)\", \"label\":\"Archived Tables\" },\r\n  { \"value\":\"(@.properties.archiveRetentionInDays == 0)\", \"label\":\"No Archive\" }\r\n]"
