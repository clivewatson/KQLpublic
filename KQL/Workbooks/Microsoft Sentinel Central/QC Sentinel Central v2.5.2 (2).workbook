                      "filter": true
                    },
                    "sortBy": []
                  },
                  "name": "query - 10"
                },
                {
                  "type": 3,
                  "content": {
                    "version": "KqlItem/1.0",
                    "query": "// ======================================================================\r\n// Sentinel Central - MITRE ATT&CK Tactics Summary\r\n//\r\n// Shows unique incidents associated with each MITRE ATT&CK tactic\r\n// during the selected Incident Overview Time Range.\r\n//\r\n// Each incident is counted once per tactic.\r\n// ======================================================================\r\n\r\nSecurityIncident\r\n\r\n// ----------------------------------------------------------------------\r\n// WORKSPACE NAME\r\n// ----------------------------------------------------------------------\r\n\r\n| extend stringtoSplit = split(\"{WorkspaceIDguid}\", \",\")\r\n| mv-expand stringtoSplit\r\n| where stringtoSplit has TenantId\r\n\r\n| extend Workspace =\r\n    trim(\r\n        @\"[^\\w]+\",\r\n        tostring(split(stringtoSplit, \":\").[1])\r\n    )\r\n\r\n// ----------------------------------------------------------------------\r\n// LATEST INCIDENT STATE\r\n// ----------------------------------------------------------------------\r\n\r\n| summarize\r\n    arg_max(TimeGenerated, *)\r\n    by TenantId, IncidentNumber\r\n\r\n// ----------------------------------------------------------------------\r\n// TIME RANGE\r\n// ----------------------------------------------------------------------\r\n\r\n| where CreatedTime >= {TimeRange:start}\r\n    and CreatedTime <= {TimeRange:end}\r\n\r\n// ----------------------------------------------------------------------\r\n// INCIDENT OVERVIEW FILTERS\r\n// ----------------------------------------------------------------------\r\n\r\n// Severity\r\n| where \"All\" in ({selectSeverity})\r\n    or Severity in ({selectSeverity})\r\n\r\n// Owner\r\n| extend OwnerName =\r\n    tostring(Owner.assignedTo)\r\n\r\n| extend OwnerName =\r\n    iff(\r\n        isempty(OwnerName),\r\n        \"Unassigned\",\r\n        OwnerName\r\n    )\r\n\r\n| where \"All\" in ({Owner})\r\n    or OwnerName in ({Owner})\r\n\r\n// Product\r\n| extend ProductName =\r\n    tostring(\r\n        parse_json(\r\n            tostring(AdditionalData.alertProductNames)\r\n        )[0]\r\n    )\r\n\r\n| where \"All\" in ({Product})\r\n    or ProductName in ({Product})\r\n\r\n// ----------------------------------------------------------------------\r\n// MITRE ATT&CK TACTICS\r\n// ----------------------------------------------------------------------\r\n\r\n| extend Tactics =\r\n    todynamic(AdditionalData.tactics)\r\n\r\n// One row per tactic.\r\n| mv-expand Tactic = Tactics to typeof(string)\r\n\r\n| where isnotempty(Tactic)\r\n\r\n// An incident can contain several tactics but should only count\r\n// once against each individual tactic.\r\n| distinct\r\n    Workspace,\r\n    IncidentNumber,\r\n    Tactic\r\n\r\n// ----------------------------------------------------------------------\r\n// TACTICS SUMMARY\r\n// ----------------------------------------------------------------------\r\n//\r\n// Tactics are a relatively stable set, so conditional aggregation gives\r\n// Sentinel Central a consistent workspace matrix.\r\n//\r\n\r\n| summarize\r\n\r\n    Reconnaissance =\r\n        countif(Tactic == \"Reconnaissance\"),\r\n\r\n    ResourceDevelopment =\r\n        countif(Tactic == \"ResourceDevelopment\"),\r\n\r\n    InitialAccess =\r\n        countif(Tactic == \"InitialAccess\"),\r\n\r\n    Execution =\r\n        countif(Tactic == \"Execution\"),\r\n\r\n    Persistence =\r\n        countif(Tactic == \"Persistence\"),\r\n\r\n    PrivilegeEscalation =\r\n        countif(Tactic == \"PrivilegeEscalation\"),\r\n\r\n    DefenseEvasion =\r\n        countif(Tactic == \"DefenseEvasion\"),\r\n\r\n    CredentialAccess =\r\n        countif(Tactic == \"CredentialAccess\"),\r\n\r\n    Discovery =\r\n        countif(Tactic == \"Discovery\"),\r\n\r\n    LateralMovement =\r\n        countif(Tactic == \"LateralMovement\"),\r\n\r\n    Collection =\r\n        countif(Tactic == \"Collection\"),\r\n\r\n    CommandAndControl =\r\n        countif(Tactic == \"CommandAndControl\"),\r\n\r\n    Exfiltration =\r\n        countif(Tactic == \"Exfiltration\"),\r\n\r\n    Impact =\r\n        countif(Tactic == \"Impact\")\r\n\r\n  by Workspace\r\n\r\n// ----------------------------------------------------------------------\r\n// FINAL OUTPUT\r\n// ----------------------------------------------------------------------\r\n\r\n| project\r\n    Workspace,\r\n    Reconnaissance,\r\n    [\"Resource Development\"] = ResourceDevelopment,\r\n    [\"Initial Access\"] = InitialAccess,\r\n    Execution,\r\n    Persistence,\r\n    [\"Privilege Escalation\"] = PrivilegeEscalation,\r\n    [\"Defense Evasion\"] = DefenseEvasion,\r\n    [\"Credential Access\"] = CredentialAccess,\r\n    Discovery,\r\n    [\"Lateral Movement\"] = LateralMovement,\r\n    Collection,\r\n    [\"Command & Control\"] = CommandAndControl,\r\n    Exfiltration,\r\n    Impact\r\n\r\n| order by Workspace asc",
                    "size": 1,
                    "title": "🎯 MITRE ATT&CK Tactics by Workspace — {TimeRange:label}",
                    "timeContextFromParameter": "TimeRange",
                    "showExportToExcel": true,
                    "queryType": 0,
                    "resourceType": "microsoft.operationalinsights/workspaces",
                    "crossComponentResources": [
                      "{Workspace}"
                    ],
                    "gridSettings": {
                      "formatters": [
                        {
                          "columnMatch": "Reconnaissance",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Resource Development",
                          "formatter": 8,
                          "formatOptions": {
                            "palette": "whiteBlack"
                          }
                        },
                        {
                          "columnMatch": "Initial Access",
                          "formatter": 8,
