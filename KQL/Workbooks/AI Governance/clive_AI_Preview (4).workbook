{
  "version": "Notebook/1.0",
  "items": [
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 9,
            "content": {
              "version": "KqlParameterItem/1.0",
              "crossComponentResources": [
                "value::all"
              ],
              "parameters": [
                {
                  "id": "ccd5adcd-8d59-4cfe-99ec-98075de2e253",
                  "version": "KqlParameterItem/1.0",
                  "name": "DefaultSubscription_Internal",
                  "type": 1,
                  "isRequired": true,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| take 1\r\n| project subscriptionId",
                  "crossComponentResources": [
                    "value::all"
                  ],
                  "isHiddenWhenLocked": true,
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "value": "b298f2a5-df16-4d7e-a31d-82ba3eeb30ff"
                },
                {
                  "id": "1ca69445-60fc-4806-b43d-ac7e6aad630a",
                  "version": "KqlParameterItem/1.0",
                  "name": "Subscription",
                  "label": "☁️ Customer",
                  "type": 6,
                  "description": "Select a subscription grouped by Azure Lighthouse customer directory",
                  "query": "// ======================================================================\r\n// Customer Info - Customer / Subscription Selector\r\n// ======================================================================\r\n\r\nresources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| summarize by subscriptionId\r\n\r\n| join kind=leftouter\r\n(\r\n    ManagedServicesResources\r\n    | where type =~ \"microsoft.managedservices/registrationassignments\"\r\n    | extend Directory = coalesce(\r\n        tostring(properties.registrationDefinition.properties.manageeTenantName),\r\n        tostring(properties.manageeTenantName)\r\n    )\r\n    | extend Directory = trim(@\"[^\\w\\s\\.-]+\", Directory)\r\n    | where isnotempty(Directory)\r\n    | summarize Directory = any(Directory) by subscriptionId\r\n)\r\non subscriptionId\r\n\r\n| extend SubscriptionResourceId = strcat(\"/subscriptions/\", subscriptionId)\r\n| extend selected = subscriptionId =~ \"{DefaultSubscription_Internal}\"\r\n| extend group = iff(isnotempty(Directory), Directory, \"Local / Other\")\r\n| project SubscriptionResourceId, selected, group\r\n| distinct SubscriptionResourceId, selected, group\r\n| order by group asc, SubscriptionResourceId asc",
                  "crossComponentResources": [
                    "value::all"
                  ],
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "value": null
                },
                {
                  "id": "e94aafa3-c5d9-4523-89f0-4e87aa754511",
                  "version": "KqlParameterItem/1.0",
                  "name": "ws",
                  "label": "🗂️ Workspace",
                  "type": 5,
                  "isRequired": true,
                  "query": "resources\r\n| where type =~ \"microsoft.operationalinsights/workspaces\"\r\n| project\r\n    value = id,\r\n    label = name\r\n| order by label asc",
                  "crossComponentResources": [
                    "{Subscription}"
                  ],
                  "typeSettings": {
                    "resourceTypeFilter": {
                      "microsoft.operationalinsights/workspaces": true
                    },
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "queryType": 1,
                  "resourceType": "microsoft.resourcegraph/resources",
                  "value": ""
                },
                {
                  "id": "c4b69c01-2263-4ada-8d9c-43433b739ff3",
                  "version": "KqlParameterItem/1.0",
                  "name": "TimeRange",
                  "type": 4,
                  "value": {
                    "durationMs": 1209600000
                  },
                  "typeSettings": {
                    "selectableValues": [
                      {
                        "durationMs": 300000
                      },
                      {
                        "durationMs": 900000
                      },
                      {
                        "durationMs": 1800000
                      },
                      {
                        "durationMs": 3600000
                      },
                      {
                        "durationMs": 14400000
                      },
                      {
                        "durationMs": 43200000
                      },
                      {
                        "durationMs": 86400000
                      },
                      {
                        "durationMs": 172800000
                      },
                      {
                        "durationMs": 259200000
                      },
                      {
                        "durationMs": 604800000
                      },
                      {
                        "durationMs": 1209600000
                      },
                      {
                        "durationMs": 2419200000
                      },
                      {
                        "durationMs": 2592000000
                      },
                      {
                        "durationMs": 5184000000
                      },
                      {
                        "durationMs": 7776000000
                      }
                    ],
                    "allowCustom": true
                  },
                  "label": "⏱️ Time Range"
                },
                {
                  "id": "c71f3009-a3f4-4aa5-aaf0-d0f667100e56",
                  "version": "KqlParameterItem/1.0",
                  "name": "Help",
                  "label": "📖 Help",
                  "type": 10,
                  "description": "Show workbook help or change log information",
                  "isRequired": true,
                  "typeSettings": {
                    "additionalResourceOptions": [],
                    "showDefault": false
                  },
                  "jsonData": "[\r\n  { \"value\": \"Yes\", \"label\": \"Yes\" },\r\n  { \"value\": \"No\", \"label\": \"No\", \"selected\": true },\r\n  { \"value\": \"Change Log\", \"label\": \"Change Log\" }\r\n]"
                }
              ],
              "style": "above",
              "queryType": 1,
              "resourceType": "microsoft.resourcegraph/resources"
            },
            "customWidth": "75",
            "name": "parameters - 1"
          },
          {
            "type": 1,
            "content": {
              "json": "# Change Log\n\n| Version | Changes |\n|---|---|\n| **v1.1 — 22 September 2026** | Refined AI governance mapping around stable **PolicyKey** identifiers, supporting both domain-based services and process-only AI tools. |\n| | Added optional **AIGovernance** watchlist support for customer-specific AI products, local catalogue overrides and automatic selection of entries marked `Sanctioned=TRUE`. |\n| | Added **AI Usage & Adoption**, including active days, observed sessions, users, devices and activity volume across the selected Time Range. |\n| | Added **AI Usage by User**, providing per-user activity patterns, product usage, observed sessions and supporting telemetry. |\n| | Clarified the separation between **governance status** and **risk classification** for AI agents and tools. |\n| | Expanded workbook guidance for catalogue configuration, telemetry interpretation and inferred usage measures. |\n| **v1.0** | Initial public preview of the **AI Governance** workbook. |\n| | Added configurable **Sanctioned AI Services** policy selection. |\n| | Added 🟢 **Sanctioned**, 🔴 **Unsanctioned**, and 🟠 **Mixed** governance classification. |\n| | Added consolidated **AI Compliance & Governance Review** covering browser, API/developer, non-browser network and desktop-client activity. |\n| | Added compact **Sanctioned and Unsanctioned AI Product** summaries based on distinct observed users. |\n| | Added **New AI Users** using a fixed 30-day observation window to identify users first observed during the most recent 7 days. |\n| | Added **Multi-AI Product Usage** across web and desktop-client activity. |\n| | Added **AI Agent / Tool Detection** using a public AI agent watchlist, including governance mapping and separate risk classification. |\n| | Added support for the workbook **Time Range** across applicable activity reports. |\n| | Designed as a lightweight, publicly shareable AI governance workbook using Microsoft Defender telemetry. |"
            },
            "customWidth": "50",
            "conditionalVisibility": {
              "parameterName": "Help",
              "comparison": "isEqualTo",
              "value": "Change Log"
            },
            "name": "text - 7"
          },
          {
            "type": 1,
            "content": {
              "json": "# 🤖 AI Governance\n\nThis workbook provides a high-level view of **AI usage observed through Microsoft Defender telemetry**, helping organisations understand which AI services and tools are being used and whether that activity aligns with approved AI policy.\n\n## 🟢 Sanctioned AI Services\n\nUse the **Sanctioned** selector to choose the AI products approved for use within your organisation.\n\nThe catalogue uses stable **PolicyKey** identifiers so governance can be applied consistently to web services, network activity, desktop clients and process-only AI tools.\n\nAn optional Sentinel watchlist with alias **AIGovernance** can add customer-specific products, override matching public catalogue entries and automatically select local entries marked `Sanctioned=TRUE`. Local catalogue entries are shown with **[Local]**. The public catalogue remains available when the watchlist is absent.\n\nObserved activity is classified as:\n\n- 🟢 **Sanctioned** — activity associated with a selected approved AI service.\n- 🔴 **Unsanctioned** — activity associated with another recognised AI service.\n- 🟠 **Mixed** — a user has activity involving both sanctioned and unsanctioned AI products.\n- ⚪ **Not mapped to policy** — a detected AI agent or tool could not be reliably mapped to the product catalogue.\n\nIf no services are selected, all recognised AI activity is treated as **unsanctioned**.\n\n## 📊 Reports\n\n**AI Compliance & Governance Review** provides the main view of sanctioned and unsanctioned AI activity, including browser, API/developer, non-browser network and desktop-client evidence.\n\n**AI Product Summary** highlights sanctioned and unsanctioned AI products observed in the environment and the number of distinct users associated with each product.\n\n**AI Usage & Adoption** shows active days, observed sessions, users, devices and activity volume for recognised AI products during the selected **Time Range**.\n\n**AI Usage by User** shows per-user activity patterns, observed sessions, product/provider usage and supporting activity during the selected **Time Range**.\n\n**New AI Users** identifies users first observed using AI within the last **7 days**, using a fixed **30-day observation window** to provide meaningful historical context.\n\n**Multi-AI Product Usage** identifies users accessing multiple AI products or providers and highlights whether their observed usage is sanctioned, unsanctioned or mixed.\n\n**AI Agent / Tool Detection** identifies known AI agents and agentic tools observed executing on endpoints. Governance status is shown where the tool can be mapped to the AI product catalogue; **Risk** is a separate watchlist assessment.\n\n## 🛡️ Interpreting the Results\n\nNetwork and process telemetry demonstrates observed communication or execution. It does **not** establish user intent, the content submitted to an AI service or the amount of time a user actively spent using it.\n\nObserved sessions are inferred from periods of activity separated by more than 30 minutes and should be treated as usage-pattern indicators rather than foreground time.\n\n## 🛡️ Microsoft Defender Data Requirements\n\nThe workbook primarily uses:\n\n- `DeviceNetworkEvents` — observed connections to recognised AI services.\n- `DeviceProcessEvents` — execution of recognised AI clients, agents and related processes.\n- The optional **AIGovernance** watchlist — customer-specific catalogue entries and sanctioned-policy defaults.\n\nResults depend on Microsoft Defender licensing, endpoint onboarding, available telemetry and retention.\n\n> **Tip:** Where the required Defender telemetry is not available through Microsoft Sentinel, try the workbook from **Microsoft Defender → Microsoft Sentinel → Workbooks**."
            },
            "customWidth": "50",
            "conditionalVisibility": {
              "parameterName": "Help",
              "comparison": "isEqualTo",
              "value": "Yes"
            },
            "name": "text - 7 - Copy"
          }
        ],
        "exportParameters": true
      },
      "name": "group - parameter and help"
    },
    {
      "type": 9,
      "content": {
        "version": "KqlParameterItem/1.0",
        "crossComponentResources": [
          "{ws}"
        ],
        "parameters": [
          {
            "id": "c85479ea-0dba-47b1-b8a9-1cdfca44e527",
            "version": "KqlParameterItem/1.0",
            "name": "Sanctioned",
            "label": "🌱 Sanctioned AI Services",
            "type": 2,
            "description": "Approved AI policy identities. Optional AIGovernance watchlist rows marked Sanctioned=TRUE are selected automatically.",
            "isGlobal": true,
            "multiSelect": true,
            "quote": "'",
            "delimiter": ",",
            "query": "let PublicAIData = externaldata(\n    Provider:string,\n    Product:string,\n    Domain:string,\n    Category:string,\n    Sanctioned:bool,\n    RiskType:string,\n    SourceURL:string,\n    ProcessName:string,\n    ProcessProductName:string,\n    ProcessPublisher:string\n)\n[\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\n]\nwith (\n    format=\"csv\",\n    ignoreFirstRecord=true\n)\n| extend Sanctioned=false, CatalogueSource=\"Public\", SourcePriority=1\n| extend PolicyKey=trim(@\"^-+|-+$\", replace_regex(tolower(strcat(Provider,\"-\",Product)), @\"[^a-z0-9]+\", \"-\"))\n| extend MatchKey=case(\n    isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n    isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n    strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n);\n\nlet LocalAIData =\n    Watchlist\n    | where WatchlistAlias == \"AIGovernance\"\n    | summarize arg_max(LastUpdatedTimeUTC, *) by SearchKey\n    | where isnotempty(WatchlistItem)\n    | extend W=todynamic(WatchlistItem)\n    | project\n        Key=tostring(W.Key), PolicyKey=tostring(W.PolicyKey),\n        Provider=tostring(W.Provider), Product=tostring(W.Product), Domain=tostring(W.Domain),\n        Category=tostring(W.Category), Sanctioned=tobool(W.Sanctioned), RiskType=tostring(W.RiskType),\n        SourceURL=tostring(W.SourceURL), ProcessName=tostring(W.ProcessName),\n        ProcessProductName=tostring(W.ProcessProductName), ProcessPublisher=tostring(W.ProcessPublisher)\n    | extend PolicyKey=iff(isnotempty(PolicyKey),PolicyKey,Key), CatalogueSource=\"Local Watchlist\", SourcePriority=2\n    | extend MatchKey=case(\n        isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n        isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n        strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n    );\n\nlet AIData =\n    union PublicAIData, LocalAIData\n    | where isnotempty(PolicyKey)\n    | summarize arg_max(SourcePriority, *) by MatchKey\n    | project Provider,Product,Domain,Category,Sanctioned,RiskType,SourceURL,ProcessName,ProcessProductName,ProcessPublisher,PolicyKey,CatalogueSource;\n\nAIData\n| extend DisplayPriority=iff(CatalogueSource==\"Local Watchlist\",10,0)+iff(isnotempty(Domain),1,0)\n| summarize\n    arg_max(DisplayPriority,Provider,Product,Domain),\n    HasLocal=countif(CatalogueSource==\"Local Watchlist\")>0,\n    IsSelected=countif(CatalogueSource==\"Local Watchlist\" and Sanctioned==true)>0\n  by PolicyKey\n| extend Label=strcat(Provider,\" - \",Product,iff(isnotempty(Domain),strcat(\" (\",Domain,\")\"),\" (process / local)\"),iff(HasLocal,\" [Local]\",\"\"))\n| project Value=PolicyKey, Label, selected=IsSelected\n| order by Label asc",
            "crossComponentResources": [
              "{ws}"
            ],
            "typeSettings": {
              "additionalResourceOptions": [],
              "showDefault": false
            },
            "timeContext": {
              "durationMs": 0
            },
            "timeContextFromParameter": "TimeRange",
            "queryType": 0,
            "resourceType": "microsoft.operationalinsights/workspaces"
          },
          {
            "id": "9a001a37-7139-4634-a72e-212b99ce5704",
            "version": "KqlParameterItem/1.0",
            "name": "SanctionedCount",
            "type": 1,
            "query": "resources\r\n| take 1\r\n| project SanctionedCount =\r\n    iff(\r\n        isempty(\"{Sanctioned}\"),\r\n        0,\r\n        array_length(split(\"{Sanctioned}\", \",\"))\r\n    )",
            "crossComponentResources": [
              "value::all"
            ],
            "isHiddenWhenLocked": true,
            "queryType": 1,
            "resourceType": "microsoft.resourcegraph/resources"
          }
        ],
        "style": "above",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces"
      },
      "customWidth": "25",
      "name": "parameters - 11"
    },
    {
      "type": 1,
      "content": {
        "json": "> ### ⚙️ Configure Sanctioned AI Services\n>\n> **Select the AI products approved for use within your organisation.** If a Sentinel watchlist with alias **AIGovernance** is present, local entries are merged with the public catalogue and rows marked `Sanctioned=TRUE` are selected automatically. Local catalogue entries are shown with **[Local]**.\n>\n> 🟢 **Sanctioned** — activity mapped to an approved AI policy.\n>\n> 🔴 **Unsanctioned** — recognised AI activity not mapped to an approved policy.\n>\n> 🟠 **Mixed** — a user has been observed using both sanctioned and unsanctioned AI products.\n>\n> ⚠️ **If no services are selected, all recognised AI activity will be classified as unsanctioned.**\n\nThe workbook primarily uses:\n**DeviceNetworkEvents** — observed connections to recognised AI services.\n**DeviceProcessEvents** — execution of recognised AI clients, agents and related processes.\n\nThe optional **AIGovernance** watchlist can add customer-specific AI products, override matching public catalogue evidence, and define default sanctioned policy selections. The workbook continues to operate with the public catalogue when the watchlist is absent."
      },
      "customWidth": "75",
      "name": "text - 4"
    },
    {
      "type": 12,
      "content": {
        "version": "NotebookGroup/1.0",
        "groupType": "editable",
        "items": [
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "let PublicAIData = externaldata(\n    Provider:string,\n    Product:string,\n    Domain:string,\n    Category:string,\n    Sanctioned:bool,\n    RiskType:string,\n    SourceURL:string,\n    ProcessName:string,\n    ProcessProductName:string,\n    ProcessPublisher:string\n)\n[\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\n]\nwith (\n    format=\"csv\",\n    ignoreFirstRecord=true\n)\n| extend Sanctioned=false, CatalogueSource=\"Public\", SourcePriority=1\n| extend PolicyKey=trim(@\"^-+|-+$\", replace_regex(tolower(strcat(Provider,\"-\",Product)), @\"[^a-z0-9]+\", \"-\"))\n| extend MatchKey=case(\n    isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n    isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n    strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n);\n\nlet LocalAIData =\n    Watchlist\n    | where WatchlistAlias == \"AIGovernance\"\n    | summarize arg_max(LastUpdatedTimeUTC, *) by SearchKey\n    | where isnotempty(WatchlistItem)\n    | extend W=todynamic(WatchlistItem)\n    | project\n        Key=tostring(W.Key), PolicyKey=tostring(W.PolicyKey),\n        Provider=tostring(W.Provider), Product=tostring(W.Product), Domain=tostring(W.Domain),\n        Category=tostring(W.Category), Sanctioned=tobool(W.Sanctioned), RiskType=tostring(W.RiskType),\n        SourceURL=tostring(W.SourceURL), ProcessName=tostring(W.ProcessName),\n        ProcessProductName=tostring(W.ProcessProductName), ProcessPublisher=tostring(W.ProcessPublisher)\n    | extend PolicyKey=iff(isnotempty(PolicyKey),PolicyKey,Key), CatalogueSource=\"Local Watchlist\", SourcePriority=2\n    | extend MatchKey=case(\n        isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n        isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n        strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n    );\n\nlet AIData =\n    union PublicAIData, LocalAIData\n    | where isnotempty(PolicyKey)\n    | summarize arg_max(SourcePriority, *) by MatchKey\n    | project Provider,Product,Domain,Category,Sanctioned,RiskType,SourceURL,ProcessName,ProcessProductName,ProcessPublisher,PolicyKey,CatalogueSource;\n\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | summarize\r\n            make_set(\r\n                Domain,\r\n                1000\r\n            )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED POLICY KEYS\r\n//\r\n// The parameter now contains values such as:\r\n//\r\n//   microsoft-copilot\r\n//   openai-chatgpt\r\n//   openai-codex\r\n//   github-copilot\r\n//\r\n// rather than domain names.\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// NETWORK ACTIVITY\r\n// ============================================================\r\n\r\nlet NetworkActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | where isnotempty(\r\n        RemoteUrl\r\n    )\r\n\r\n    | where RemoteUrl has_any (\r\n        AIDomains\r\n    )\r\n\r\n    | project\r\n        User =\r\n            InitiatingProcessAccountUpn,\r\n\r\n        RemoteUrl\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    // --------------------------------------------------------\r\n    // GOVERNANCE\r\n    //\r\n    // Policy membership is now based on PolicyKey rather\r\n    // than Domain.\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        User,\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        PolicyKey,\r\n        IsSanctioned;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        PolicyKey,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT ACTIVITY\r\n// ============================================================\r\n\r\nlet DesktopActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n\r\n    ) on ProcessNameLower\r\n\r\n\r\n    // --------------------------------------------------------\r\n    // VALIDATE PRODUCT\r\n    // --------------------------------------------------------\r\n\r\n    | where\r\n        isempty(\r\n            CatalogueProductName\r\n        )\r\n\r\n        or ProductNameLower\r\n            == CatalogueProductNameLower\r\n\r\n        or isempty(\r\n            ProcessVersionInfoProductName\r\n        )\r\n\r\n\r\n    // --------------------------------------------------------\r\n    // VALIDATE PUBLISHER\r\n    // --------------------------------------------------------\r\n\r\n    | where\r\n        isempty(\r\n            CataloguePublisher\r\n        )\r\n\r\n        or PublisherLower has\r\n            CataloguePublisherLower\r\n\r\n        or isempty(\r\n            ProcessVersionInfoCompanyName\r\n        )\r\n\r\n\r\n    // --------------------------------------------------------\r\n    // GOVERNANCE\r\n    //\r\n    // This is where the policy-key design matters:\r\n    //\r\n    // Process-only products such as Codex can now be\r\n    // sanctioned even when they have no Domain.\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        User =\r\n            AccountUpn,\r\n\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        PolicyKey,\r\n        IsSanctioned;\r\n\r\n\r\n// ============================================================\r\n// COMBINE AND DEDUPLICATE\r\n//\r\n// One row per:\r\n//\r\n//   User\r\n//   Provider\r\n//   Product\r\n//   PolicyKey\r\n//\r\n// Domain is deliberately not the governance identity anymore.\r\n// ============================================================\r\n\r\nlet AIUsage =\r\n    union\r\n        NetworkActivity,\r\n        DesktopActivity\r\n\r\n    | where isnotempty(User)\r\n\r\n    | summarize\r\n        IsSanctioned =\r\n            max(IsSanctioned),\r\n\r\n        Domains =\r\n            make_set_if(\r\n                Domain,\r\n                isnotempty(Domain),\r\n                20\r\n            )\r\n\r\n      by\r\n        User,\r\n        Provider,\r\n        Product,\r\n        PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// USER GOVERNANCE\r\n//\r\n// A user may be:\r\n//\r\n//   🟢 Sanctioned only\r\n//   🟠 Mixed\r\n//   🔴 Unsanctioned only\r\n// ============================================================\r\n\r\nlet UserGovernance =\r\n    AIUsage\r\n\r\n    | summarize\r\n\r\n        SanctionedProducts =\r\n            dcountif(\r\n                PolicyKey,\r\n                IsSanctioned\r\n            ),\r\n\r\n        UnsanctionedProducts =\r\n            dcountif(\r\n                PolicyKey,\r\n                not(IsSanctioned)\r\n            )\r\n\r\n      by User\r\n\r\n    | extend Governance =\r\n        case(\r\n            SanctionedProducts > 0\r\n                and UnsanctionedProducts > 0,\r\n                \"Mixed\",\r\n\r\n            UnsanctionedProducts > 0,\r\n                \"Unsanctioned only\",\r\n\r\n            SanctionedProducts > 0,\r\n                \"Sanctioned only\",\r\n\r\n            \"Review\"\r\n        );\r\n\r\n\r\n// ============================================================\r\n// HEADLINE VALUES\r\n// ============================================================\r\n\r\nlet TotalUsers =\r\n    toscalar(\r\n        UserGovernance\r\n        | summarize count()\r\n    );\r\n\r\n\r\nlet TotalProviders =\r\n    toscalar(\r\n        AIUsage\r\n\r\n        | where isnotempty(Provider)\r\n\r\n        | summarize\r\n            dcount(Provider)\r\n    );\r\n\r\n\r\nlet TotalProducts =\r\n    toscalar(\r\n        AIUsage\r\n\r\n        | where isnotempty(PolicyKey)\r\n\r\n        | summarize\r\n            dcount(PolicyKey)\r\n    );\r\n\r\n\r\nlet UnsanctionedUsers =\r\n    toscalar(\r\n        UserGovernance\r\n\r\n        | where Governance ==\r\n            \"Unsanctioned only\"\r\n\r\n        | summarize count()\r\n    );\r\n\r\n\r\nlet MixedUsers =\r\n    toscalar(\r\n        UserGovernance\r\n\r\n        | where Governance ==\r\n            \"Mixed\"\r\n\r\n        | summarize count()\r\n    );\r\n\r\n\r\nlet SanctionedUsers =\r\n    toscalar(\r\n        UserGovernance\r\n\r\n        | where Governance ==\r\n            \"Sanctioned only\"\r\n\r\n        | summarize count()\r\n    );\r\n\r\n\r\n// ============================================================\r\n// TILE OUTPUT\r\n// ============================================================\r\n\r\nunion\r\n\r\n    (\r\n        print\r\n            SortOrder = 1,\r\n\r\n            Metric =\r\n                \"👥 AI Users Observed\",\r\n\r\n            Value =\r\n                tolong(TotalUsers)\r\n    ),\r\n\r\n    (\r\n        print\r\n            SortOrder = 2,\r\n\r\n            Metric =\r\n                \"🏢 AI Providers Observed\",\r\n\r\n            Value =\r\n                tolong(TotalProviders)\r\n    ),\r\n\r\n    (\r\n        print\r\n            SortOrder = 3,\r\n\r\n            Metric =\r\n                \"🤖 AI Products Observed\",\r\n\r\n            Value =\r\n                tolong(TotalProducts)\r\n    ),\r\n\r\n    (\r\n        print\r\n            SortOrder = 4,\r\n\r\n            Metric =\r\n                \"🔴 Unsanctioned-only Users\",\r\n\r\n            Value =\r\n                tolong(\r\n                    UnsanctionedUsers\r\n                )\r\n    ),\r\n\r\n    (\r\n        print\r\n            SortOrder = 5,\r\n\r\n            Metric =\r\n                \"🟠 Mixed Users\",\r\n\r\n            Value =\r\n                tolong(\r\n                    MixedUsers\r\n                )\r\n    ),\r\n\r\n    (\r\n        print\r\n            SortOrder = 6,\r\n\r\n            Metric =\r\n                \"🟢 Sanctioned-only Users\",\r\n\r\n            Value =\r\n                tolong(\r\n                    SanctionedUsers\r\n                )\r\n    )\r\n\r\n| order by\r\n    SortOrder asc\r\n\r\n| project\r\n    Metric,\r\n    Value",
              "size": 4,
              "title": "📊 AI Governance at a Glance",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "none"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "showBorder": false
              }
            },
            "customWidth": "60",
            "name": "query - 12",
            "styleSettings": {
              "showBorder": true
            }
          },
          {
            "type": 1,
            "content": {
              "json": ""
            },
            "customWidth": "5",
            "name": "text - 15"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// SANCTIONED AI ADOPTION\r\n//\r\n// Shows how much of the customer-selected sanctioned AI\r\n// policy has actually been observed during the selected\r\n// Workbook TimeRange.\r\n//\r\n// Output:\r\n//   🏢 Providers   observed / configured\r\n//   🤖 Products    observed / configured\r\n//   ⚪ Not Observed sanctioned products not seen\r\n//\r\n// Uses:\r\n//   - Public AI catalogue\r\n//   - Optional AIGovernance watchlist\r\n//   - Customer-selected {Sanctioned} PolicyKeys\r\n//   - DeviceNetworkEvents\r\n//   - DeviceProcessEvents\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// PUBLIC AI CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData =\r\n    externaldata(\r\n        Provider:string,\r\n        Product:string,\r\n        Domain:string,\r\n        Category:string,\r\n        Sanctioned:bool,\r\n        RiskType:string,\r\n        SourceURL:string,\r\n        ProcessName:string,\r\n        ProcessProductName:string,\r\n        ProcessPublisher:string\r\n    )\r\n    [\r\n        @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n    ]\r\n    with (\r\n        format=\"csv\",\r\n        ignoreFirstRecord=true\r\n    )\r\n\r\n    | extend\r\n        Sanctioned = false,\r\n        CatalogueSource = \"Public\",\r\n        SourcePriority = 1\r\n\r\n    | extend PolicyKey =\r\n        trim(\r\n            @\"^-+|-+$\",\r\n            replace_regex(\r\n                tolower(\r\n                    strcat(\r\n                        Provider,\r\n                        \"-\",\r\n                        Product\r\n                    )\r\n                ),\r\n                @\"[^a-z0-9]+\",\r\n                \"-\"\r\n            )\r\n        )\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            Domain\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            ProcessName\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Provider\r\n                    )\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Product\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL AIGOVERNANCE WATCHLIST\r\n//\r\n// Direct Watchlist access is intentional.\r\n//\r\n// If the watchlist does not exist, this returns no local rows\r\n// and the public catalogue continues to work normally.\r\n//\r\n// The raw Watchlist table may contain historical versions,\r\n// therefore only the latest row per SearchKey is retained.\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key =\r\n            tostring(W.Key),\r\n\r\n        PolicyKey =\r\n            tostring(W.PolicyKey),\r\n\r\n        Provider =\r\n            tostring(W.Provider),\r\n\r\n        Product =\r\n            tostring(W.Product),\r\n\r\n        Domain =\r\n            tostring(W.Domain),\r\n\r\n        Category =\r\n            tostring(W.Category),\r\n\r\n        Sanctioned =\r\n            tobool(W.Sanctioned),\r\n\r\n        RiskType =\r\n            tostring(W.RiskType),\r\n\r\n        SourceURL =\r\n            tostring(W.SourceURL),\r\n\r\n        ProcessName =\r\n            tostring(W.ProcessName),\r\n\r\n        ProcessProductName =\r\n            tostring(W.ProcessProductName),\r\n\r\n        ProcessPublisher =\r\n            tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            Domain\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            ProcessName\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Provider\r\n                    )\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Product\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n//\r\n// Local evidence overrides matching public evidence.\r\n// Multiple evidence rows may share the same PolicyKey.\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        SourceURL,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED POLICIES\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// SANCTIONED POLICY INVENTORY\r\n//\r\n// One logical row per configured PolicyKey.\r\n// ============================================================\r\n\r\nlet SanctionedInventory =\r\n    AIData\r\n\r\n    | where\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n\r\n    | where set_has_element(\r\n        SanctionedPolicies,\r\n        PolicyKey\r\n    )\r\n\r\n    | summarize\r\n        Provider =\r\n            take_any(Provider),\r\n\r\n        Product =\r\n            take_any(Product)\r\n\r\n      by PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | summarize\r\n            make_set(\r\n                Domain,\r\n                1000\r\n            )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// NETWORK OBSERVATIONS\r\n// ============================================================\r\n\r\nlet NetworkObserved =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any(\r\n        AIDomains\r\n    )\r\n\r\n    | project\r\n        RemoteUrl\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    | where\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n\r\n    | where set_has_element(\r\n        SanctionedPolicies,\r\n        PolicyKey\r\n    )\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP / PROCESS CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP / PROCESS OBSERVATIONS\r\n// ============================================================\r\n\r\nlet DesktopObserved =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(\r\n            CatalogueProductName\r\n        )\r\n        or ProductNameLower\r\n            == CatalogueProductNameLower\r\n        or isempty(\r\n            ProcessVersionInfoProductName\r\n        )\r\n\r\n    | where\r\n        isempty(\r\n            CataloguePublisher\r\n        )\r\n        or PublisherLower has\r\n            CataloguePublisherLower\r\n        or isempty(\r\n            ProcessVersionInfoCompanyName\r\n        )\r\n\r\n    | where\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n\r\n    | where set_has_element(\r\n        SanctionedPolicies,\r\n        PolicyKey\r\n    )\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// OBSERVED SANCTIONED POLICIES\r\n//\r\n// Collapse network and process evidence back to the logical\r\n// PolicyKey so multiple evidence types do not inflate counts.\r\n// ============================================================\r\n\r\nlet ObservedSanctioned =\r\n    union\r\n        NetworkObserved,\r\n        DesktopObserved\r\n\r\n    | summarize\r\n        Provider =\r\n            take_any(Provider),\r\n\r\n        Product =\r\n            take_any(Product)\r\n\r\n      by PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// HEADLINE VALUES\r\n// ============================================================\r\n\r\nlet SanctionedProductsConfigured =\r\n    toscalar(\r\n        SanctionedInventory\r\n        | summarize\r\n            dcount(PolicyKey)\r\n    );\r\n\r\nlet SanctionedProvidersConfigured =\r\n    toscalar(\r\n        SanctionedInventory\r\n\r\n        | where isnotempty(Provider)\r\n\r\n        | summarize\r\n            dcount(Provider)\r\n    );\r\n\r\nlet SanctionedProductsObserved =\r\n    toscalar(\r\n        ObservedSanctioned\r\n\r\n        | summarize\r\n            dcount(PolicyKey)\r\n    );\r\n\r\nlet SanctionedProvidersObserved =\r\n    toscalar(\r\n        ObservedSanctioned\r\n\r\n        | where isnotempty(Provider)\r\n\r\n        | summarize\r\n            dcount(Provider)\r\n    );\r\n\r\nlet SanctionedProductsNotObserved =\r\n    tolong(\r\n        SanctionedProductsConfigured\r\n        -\r\n        SanctionedProductsObserved\r\n    );\r\n\r\n\r\n// ============================================================\r\n// COMPACT TILE OUTPUT\r\n// ============================================================\r\n\r\nunion\r\n    (\r\n        print\r\n            SortOrder = 1,\r\n            Metric = \"🏢 Providers\",\r\n            Value = strcat(\r\n                tostring(SanctionedProvidersObserved),\r\n                \" / \",\r\n                tostring(SanctionedProvidersConfigured)\r\n            ),\r\n            Detail = \"Observed / Configured\"\r\n    ),\r\n    (\r\n        print\r\n            SortOrder = 2,\r\n            Metric = \"🤖 Products\",\r\n            Value = strcat(\r\n                tostring(SanctionedProductsObserved),\r\n                \" / \",\r\n                tostring(SanctionedProductsConfigured)\r\n            ),\r\n            Detail = \"Observed / Configured\"\r\n    ),\r\n    (\r\n        print\r\n            SortOrder = 3,\r\n            Metric = \"⚪ Not Observed\",\r\n            Value = tostring(SanctionedProductsNotObserved),\r\n            Detail = iff(\r\n                SanctionedProductsNotObserved == 1,\r\n                \"Sanctioned product\",\r\n                \"Sanctioned products\"\r\n            )\r\n    )\r\n\r\n| order by SortOrder asc\r\n\r\n| project\r\n    Metric,\r\n    Value,\r\n    Detail",
              "size": 4,
              "title": "📋 Sanctioned AI Coverage",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Metric",
                  "formatter": 1
                },
                "leftContent": {
                  "columnMatch": "Value",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "none"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 2,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "secondaryContent": {
                  "columnMatch": "Detail"
                },
                "showBorder": false
              }
            },
            "customWidth": "35",
            "name": "query - 12 - Copy",
            "styleSettings": {
              "showBorder": true
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// AI PROVIDERS & PRODUCTS OBSERVED - TILE SUMMARY\r\n//\r\n// One row per provider.\r\n//\r\n// Product governance is based ONLY on the customer-selected\r\n// {Sanctioned} services.\r\n//\r\n// Provider governance:\r\n//   🟢 Sanctioned only\r\n//   🟠 Mixed\r\n//   🔴 Unsanctioned only\r\n//\r\n// Individual products are also prefixed with 🟢 / 🔴.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// AI SERVICE CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData = externaldata(\n    Provider:string,\n    Product:string,\n    Domain:string,\n    Category:string,\n    Sanctioned:bool,\n    RiskType:string,\n    SourceURL:string,\n    ProcessName:string,\n    ProcessProductName:string,\n    ProcessPublisher:string\n)\n[\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\n]\nwith (\n    format=\"csv\",\n    ignoreFirstRecord=true\n)\n| extend Sanctioned=false, CatalogueSource=\"Public\", SourcePriority=1\n| extend PolicyKey=trim(@\"^-+|-+$\", replace_regex(tolower(strcat(Provider,\"-\",Product)), @\"[^a-z0-9]+\", \"-\"))\n| extend MatchKey=case(\n    isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n    isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n    strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n);\n\nlet LocalAIData =\n    Watchlist\n    | where WatchlistAlias == \"AIGovernance\"\n    | summarize arg_max(LastUpdatedTimeUTC, *) by SearchKey\n    | where isnotempty(WatchlistItem)\n    | extend W=todynamic(WatchlistItem)\n    | project\n        Key=tostring(W.Key), PolicyKey=tostring(W.PolicyKey),\n        Provider=tostring(W.Provider), Product=tostring(W.Product), Domain=tostring(W.Domain),\n        Category=tostring(W.Category), Sanctioned=tobool(W.Sanctioned), RiskType=tostring(W.RiskType),\n        SourceURL=tostring(W.SourceURL), ProcessName=tostring(W.ProcessName),\n        ProcessProductName=tostring(W.ProcessProductName), ProcessPublisher=tostring(W.ProcessPublisher)\n    | extend PolicyKey=iff(isnotempty(PolicyKey),PolicyKey,Key), CatalogueSource=\"Local Watchlist\", SourcePriority=2\n    | extend MatchKey=case(\n        isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n        isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n        strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n    );\n\nlet AIData =\n    union PublicAIData, LocalAIData\n    | where isnotempty(PolicyKey)\n    | summarize arg_max(SourcePriority, *) by MatchKey\n    | project Provider,Product,Domain,Category,Sanctioned,RiskType,SourceURL,ProcessName,ProcessProductName,ProcessPublisher,PolicyKey,CatalogueSource;\n\nlet AIDomainData = AIData;\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIDomainData\r\n        | where isnotempty(Domain)\r\n        | summarize make_set(Domain)\r\n    );\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED SERVICES\r\n//\r\n// IMPORTANT:\r\n// Governance is based on this Workbook parameter only.\r\n//\r\n// If no services are selected, no recognised AI service is\r\n// treated as sanctioned.\r\n// ============================================================\r\n\r\nlet SanctionedPolicies = dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// KNOWN BROWSERS\r\n// ============================================================\r\n\r\nlet Browsers = dynamic([\r\n    \"msedge.exe\",\r\n    \"chrome.exe\",\r\n    \"firefox.exe\",\r\n    \"brave.exe\",\r\n    \"opera.exe\",\r\n    \"iexplore.exe\"\r\n]);\r\n\r\n\r\n// ============================================================\r\n// NETWORK ACTIVITY\r\n// ============================================================\r\n\r\nlet NetworkActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n\r\n    | where isnotempty(InitiatingProcessAccountUpn)\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any (AIDomains)\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl,\r\n        Process = InitiatingProcessFileName\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIDomainData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\n            PolicyKey,\r\n            Category,\r\n            RiskType\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    // --------------------------------------------------------\r\n    // GOVERNANCE\r\n    //\r\n    // Exact membership check.\r\n    //\r\n    // Do NOT use:\r\n    //     set_has_element(SanctionedPolicies, PolicyKey)\r\n    //\r\n    // set_has_element() checks whether this exact domain is\r\n    // present in the customer-selected sanctioned array.\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    // --------------------------------------------------------\r\n    // ACCESS TYPE\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsBrowser =\r\n        Process in~ (Browsers)\r\n\r\n    | extend IsAPI =\r\n        RiskType =~ \"API\"\r\n        or Category =~ \"API\"\r\n        or Product has \"API\"\r\n\r\n    | extend IsDeveloper =\r\n        RiskType =~ \"Developer\"\r\n        or Category =~ \"Developer\"\r\n\r\n    | extend AccessType =\r\n        case(\r\n            IsBrowser,\r\n                \"Web / Browser\",\r\n\r\n            IsAPI or IsDeveloper,\r\n                \"API / Developer\",\r\n\r\n            \"Non-browser Network\"\r\n        )\r\n\r\n    | project\r\n        Timestamp,\r\n        Provider,\r\n        Product,\r\n        Domain,\n        PolicyKey,\r\n        IsSanctioned,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        AccessType;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIDomainData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\n        PolicyKey,\r\n        CatalogueProcessName = ProcessName,\r\n        CatalogueProductName = ProcessProductName,\r\n        CataloguePublisher = ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT ACTIVITY\r\n// ============================================================\r\n\r\nlet DesktopActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(ProcessVersionInfoProductName),\r\n\r\n        PublisherLower =\r\n            tolower(ProcessVersionInfoCompanyName)\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(CatalogueProcessName),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(CatalogueProductName),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(CataloguePublisher)\r\n\r\n    ) on ProcessNameLower\r\n\r\n    // --------------------------------------------------------\r\n    // VALIDATE PRODUCT\r\n    // --------------------------------------------------------\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower == CatalogueProductNameLower\r\n        or isempty(ProcessVersionInfoProductName)\r\n\r\n    // --------------------------------------------------------\r\n    // VALIDATE PUBLISHER\r\n    // --------------------------------------------------------\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has CataloguePublisherLower\r\n        or isempty(ProcessVersionInfoCompanyName)\r\n\r\n    // --------------------------------------------------------\r\n    // GOVERNANCE\r\n    //\r\n    // Same exact selection logic as network activity.\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | extend AccessType =\r\n        \"Desktop Client\"\r\n\r\n    | project\r\n        Timestamp,\r\n        Provider,\r\n        Product,\r\n        Domain,\n        PolicyKey,\r\n        IsSanctioned,\r\n        User = AccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        AccessType;\r\n\r\n\r\n// ============================================================\r\n// COMBINE ACTIVITY\r\n// ============================================================\r\n\r\nlet CombinedActivity =\r\n    union\r\n        NetworkActivity,\r\n        DesktopActivity;\r\n\r\n\r\n// ============================================================\r\n// PRODUCT-LEVEL GOVERNANCE\r\n//\r\n// Create one row per Provider / Product / Domain before rolling\r\n// up to provider level.\r\n//\r\n// The governance indicator comes directly from the exact\r\n// {Sanctioned} policy selection.\r\n// ============================================================\r\n\r\nlet ProductSummary =\r\n    CombinedActivity\r\n\r\n    | summarize\r\n        ProductUsers =\r\n            dcount(User),\r\n\r\n        ProductDevices =\r\n            dcount(DeviceId),\r\n\r\n        ProductActivity =\r\n            count(),\r\n\r\n        FirstSeen =\r\n            min(Timestamp),\r\n\r\n        LastSeen =\r\n            max(Timestamp)\r\n\r\n      by\r\n        Provider,\r\n        Product,\r\n        Domain,\n        PolicyKey,\r\n        IsSanctioned\r\n\r\n    | extend ProductGovernance =\r\n        iff(\r\n            IsSanctioned,\r\n            \"🟢\",\r\n            \"🔴\"\r\n        )\r\n\r\n    | extend ProductLabel =\r\n        strcat(\r\n            ProductGovernance,\r\n            \" \",\r\n            Product\r\n        );\r\n\r\n\r\n// ============================================================\r\n// PROVIDER-LEVEL USER / DEVICE SUMMARY\r\n//\r\n// Calculated directly from CombinedActivity so users are not\r\n// double-counted when they use multiple products from the same\r\n// provider.\r\n// ============================================================\r\n\r\nlet ProviderUsage =\r\n    CombinedActivity\r\n\r\n    | summarize\r\n        Users =\r\n            dcount(User),\r\n\r\n        Devices =\r\n            dcount(DeviceId),\r\n\r\n        Activity =\r\n            count(),\r\n\r\n        AccessTypes =\r\n            make_set_if(\r\n                AccessType,\r\n                isnotempty(AccessType),\r\n                10\r\n            ),\r\n\r\n        UserList =\r\n            make_set_if(\r\n                User,\r\n                isnotempty(User),\r\n                50\r\n            ),\r\n\r\n        DeviceList =\r\n            make_set_if(\r\n                DeviceName,\r\n                isnotempty(DeviceName),\r\n                50\r\n            ),\r\n\r\n        FirstSeen =\r\n            min(Timestamp),\r\n\r\n        LastSeen =\r\n            max(Timestamp)\r\n\r\n      by Provider;\r\n\r\n\r\n// ============================================================\r\n// PROVIDER PRODUCT SUMMARY\r\n// ============================================================\r\n\r\nlet ProviderProducts =\r\n    ProductSummary\r\n\r\n    | summarize\r\n\r\n        Products =\r\n            dcount(PolicyKey),\r\n\r\n        SanctionedProducts =\r\n            dcountif(\r\n                PolicyKey,\r\n                IsSanctioned\r\n            ),\r\n\r\n        UnsanctionedProducts =\r\n            dcountif(\r\n                PolicyKey,\r\n                not(IsSanctioned)\r\n            ),\r\n\r\n        ProductsUsed =\r\n            make_set(\r\n                ProductLabel,\r\n                50\r\n            ),\r\n\r\n        Domains =\r\n            make_set_if(\r\n                Domain,\r\n                isnotempty(Domain),\r\n                50\r\n            )\r\n\r\n      by Provider\r\n\r\n    // --------------------------------------------------------\r\n    // PROVIDER GOVERNANCE\r\n    // --------------------------------------------------------\r\n\r\n    | extend Governance =\r\n        case(\r\n            SanctionedProducts > 0\r\n                and UnsanctionedProducts > 0,\r\n                \"🟠 Mixed\",\r\n\r\n            UnsanctionedProducts > 0,\r\n                \"🔴 Unsanctioned only\",\r\n\r\n            SanctionedProducts > 0,\r\n                \"🟢 Sanctioned only\",\r\n\r\n            \"⚪ Review\"\r\n        )\r\n\r\n    // --------------------------------------------------------\r\n    // FRIENDLY PRODUCT LIST\r\n    // --------------------------------------------------------\r\n\r\n    | extend ProductList =\r\n        strcat_array(\r\n            array_sort_asc(ProductsUsed),\r\n            \", \"\r\n        )\r\n\r\n    | extend ProductDisplay =\r\n        strcat(\r\n            tostring(Products),\r\n            iff(\r\n                Products == 1,\r\n                \" product\",\r\n                \" products\"\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// JOIN PROVIDER METRICS\r\n// ============================================================\r\n\r\nProviderProducts\r\n\r\n| join kind=inner (\r\n    ProviderUsage\r\n) on Provider\r\n\r\n\r\n// ============================================================\r\n// DISPLAY VALUES\r\n// ============================================================\r\n\r\n| extend UserDisplay =\r\n    strcat(\r\n        tostring(Users),\r\n        iff(\r\n            Users == 1,\r\n            \" user\",\r\n            \" users\"\r\n        )\r\n    )\r\n\r\n| extend AccessTypeList =\r\n    strcat_array(\r\n        array_sort_asc(AccessTypes),\r\n        \", \"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORT\r\n// ============================================================\r\n\r\n| extend GovernanceSort =\r\n    case(\r\n        Governance == \"🔴 Unsanctioned only\", 1,\r\n        Governance == \"🟠 Mixed\", 2,\r\n        Governance == \"🟢 Sanctioned only\", 3,\r\n        4\r\n    )\r\n\r\n| order by\r\n    GovernanceSort asc,\r\n    Users desc,\r\n    Products desc,\r\n    Activity desc\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    Provider,\r\n\r\n    Governance,\r\n\r\n    Products,\r\n\r\n    ['Product List'] =\r\n        ProductList,\r\n\r\n    Users,\r\n\r\n    UserDisplay,\r\n\r\n    ['Sanctioned Products'] =\r\n        SanctionedProducts,\r\n\r\n    ['Unsanctioned Products'] =\r\n        UnsanctionedProducts,\r\n\r\n    Devices,\r\n\r\n    Activity,\r\n\r\n    ['Access Type List'] =\r\n        AccessTypeList,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen\r\n\r\n| order by\r\n    Provider asc",
              "size": 4,
              "title": "🛡️ AI Providers & Products Observed - {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Provider"
                },
                "subtitleContent": {
                  "columnMatch": "Product List"
                },
                "leftContent": {
                  "columnMatch": "Products",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "none"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "secondaryContent": {
                  "columnMatch": "UserDisplay"
                },
                "showBorder": false
              }
            },
            "name": "query - Provider / Product ",
            "styleSettings": {
              "showBorder": true
            }
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// SANCTIONED AI PRODUCTS OBSERVED\r\n//\r\n// Rolls observed activity up by PolicyKey so governance counts\r\n// align with the Sanctioned AI Coverage panel.\r\n//\r\n// Multiple evidence rows for the same governed product, such as\r\n// ChatGPT web + ChatGPT desktop, are shown as one logical\r\n// sanctioned product.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// PUBLIC AI CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData =\r\n    externaldata(\r\n        Provider:string,\r\n        Product:string,\r\n        Domain:string,\r\n        Category:string,\r\n        Sanctioned:bool,\r\n        RiskType:string,\r\n        SourceURL:string,\r\n        ProcessName:string,\r\n        ProcessProductName:string,\r\n        ProcessPublisher:string\r\n    )\r\n    [\r\n        @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n    ]\r\n    with (\r\n        format=\"csv\",\r\n        ignoreFirstRecord=true\r\n    )\r\n    | extend\r\n        Sanctioned = false,\r\n        CatalogueSource = \"Public\",\r\n        SourcePriority = 1\r\n    | extend PolicyKey =\r\n        trim(\r\n            @\"^-+|-+$\",\r\n            replace_regex(\r\n                tolower(\r\n                    strcat(\r\n                        Provider,\r\n                        \"-\",\r\n                        Product\r\n                    )\r\n                ),\r\n                @\"[^a-z0-9]+\",\r\n                \"-\"\r\n            )\r\n        )\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", Domain)\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", ProcessName)\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Provider)\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Product)\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL WATCHLIST\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key = tostring(W.Key),\r\n        PolicyKey = tostring(W.PolicyKey),\r\n        Provider = tostring(W.Provider),\r\n        Product = tostring(W.Product),\r\n        Domain = tostring(W.Domain),\r\n        Category = tostring(W.Category),\r\n        Sanctioned = tobool(W.Sanctioned),\r\n        RiskType = tostring(W.RiskType),\r\n        SourceURL = tostring(W.SourceURL),\r\n        ProcessName = tostring(W.ProcessName),\r\n        ProcessProductName = tostring(W.ProcessProductName),\r\n        ProcessPublisher = tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", Domain)\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", ProcessName)\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Provider)\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Product)\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\n\r\n// ============================================================\r\n// SANCTIONED POLICY KEYS\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n        | where isnotempty(Domain)\r\n        | summarize make_set(Domain, 1000)\r\n    );\r\n\r\n\r\n// ============================================================\r\n// NETWORK ACTIVITY\r\n// ============================================================\r\n\r\nlet NetworkActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any(\r\n        AIDomains\r\n    )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl,\r\n        Process = InitiatingProcessFileName\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n        | where isnotempty(Domain)\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey\r\n        | extend JoinKey = 1\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | where IsSanctioned\r\n\r\n    | project\r\n        Timestamp,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        AccessType = \"Network\";\r\n\r\n\r\n// ============================================================\r\n// PROCESS CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP ACTIVITY\r\n// ============================================================\r\n\r\nlet DesktopActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower == CatalogueProductNameLower\r\n        or isempty(ProcessVersionInfoProductName)\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has CataloguePublisherLower\r\n        or isempty(ProcessVersionInfoCompanyName)\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | where IsSanctioned\r\n\r\n    | project\r\n        Timestamp,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n        User = AccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        AccessType = \"Desktop Client\";\r\n\r\n\r\n// ============================================================\r\n// COMBINE ACTIVITY\r\n// ============================================================\r\n\r\nlet CombinedActivity =\r\n    union\r\n        NetworkActivity,\r\n        DesktopActivity;\r\n\r\n\r\n// ============================================================\r\n// ROLL UP TO GOVERNANCE PRODUCT\r\n//\r\n// PolicyKey is the logical sanctioned product identity.\r\n// ============================================================\r\n\r\nCombinedActivity\r\n\r\n| summarize\r\n    Users =\r\n        dcount(User),\r\n\r\n    Devices =\r\n        dcount(DeviceId),\r\n\r\n    Activity =\r\n        count(),\r\n\r\n    ProductNames =\r\n        make_set(\r\n            Product,\r\n            20\r\n        ),\r\n\r\n    Domains =\r\n        make_set_if(\r\n            Domain,\r\n            isnotempty(Domain),\r\n            20\r\n        ),\r\n\r\n    AccessTypes =\r\n        make_set(\r\n            AccessType,\r\n            10\r\n        ),\r\n\r\n    UserList =\r\n        make_set(\r\n            User,\r\n            20\r\n        ),\r\n\r\n    DeviceList =\r\n        make_set(\r\n            DeviceName,\r\n            20\r\n        ),\r\n\r\n    FirstSeen =\r\n        min(Timestamp),\r\n\r\n    LastSeen =\r\n        max(Timestamp)\r\n\r\n  by\r\n    PolicyKey,\r\n    Provider\r\n\r\n\r\n// ============================================================\r\n// FRIENDLY DISPLAY\r\n// ============================================================\r\n\r\n| extend ProductList =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProductNames\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ProductTitle =\r\n    strcat(\r\n        Provider,\r\n        \" - \",\r\n        ProductList\r\n    )\r\n\r\n| extend AccessTypeList =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            AccessTypes\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| order by\r\n    Users desc,\r\n    Activity desc\r\n\r\n| project\r\n    ProductTitle,\r\n    Users,\r\n    Provider,\r\n    ['Products Observed'] =\r\n        ProductList,\r\n    PolicyKey,\r\n    Devices,\r\n    Activity,\r\n    ['Access Types'] =\r\n        AccessTypeList,\r\n    Domains,\r\n    ['Last Seen'] =\r\n        LastSeen,\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n    UserList,\r\n    DeviceList",
              "size": 4,
              "title": "🟢 Sanctioned AI Products Observed  - {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "ProductTitle"
                },
                "leftContent": {
                  "columnMatch": "Users",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "none"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "showBorder": false
              }
            },
            "customWidth": "50",
            "name": "query - Sanctioned AI Product Tiles"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// SANCTIONED AI PRODUCTS NOT OBSERVED\r\n//\r\n// Shows customer-sanctioned AI products that were NOT observed\r\n// during the selected Workbook TimeRange.\r\n//\r\n// Uses PolicyKey as the logical governance identity so multiple\r\n// evidence rows for the same product do not inflate counts.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// PUBLIC AI CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData =\r\n    externaldata(\r\n        Provider:string,\r\n        Product:string,\r\n        Domain:string,\r\n        Category:string,\r\n        Sanctioned:bool,\r\n        RiskType:string,\r\n        SourceURL:string,\r\n        ProcessName:string,\r\n        ProcessProductName:string,\r\n        ProcessPublisher:string\r\n    )\r\n    [\r\n        @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n    ]\r\n    with (\r\n        format=\"csv\",\r\n        ignoreFirstRecord=true\r\n    )\r\n    | extend\r\n        Sanctioned = false,\r\n        CatalogueSource = \"Public\",\r\n        SourcePriority = 1\r\n    | extend PolicyKey =\r\n        trim(\r\n            @\"^-+|-+$\",\r\n            replace_regex(\r\n                tolower(\r\n                    strcat(\r\n                        Provider,\r\n                        \"-\",\r\n                        Product\r\n                    )\r\n                ),\r\n                @\"[^a-z0-9]+\",\r\n                \"-\"\r\n            )\r\n        )\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(trim(@\"^\\s+|\\s+$\", Domain))\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(trim(@\"^\\s+|\\s+$\", ProcessName))\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(trim(@\"^\\s+|\\s+$\", Provider)),\r\n                \"|\",\r\n                tolower(trim(@\"^\\s+|\\s+$\", Product))\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL WATCHLIST\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key = tostring(W.Key),\r\n        PolicyKey = tostring(W.PolicyKey),\r\n        Provider = tostring(W.Provider),\r\n        Product = tostring(W.Product),\r\n        Domain = tostring(W.Domain),\r\n        Category = tostring(W.Category),\r\n        Sanctioned = tobool(W.Sanctioned),\r\n        RiskType = tostring(W.RiskType),\r\n        SourceURL = tostring(W.SourceURL),\r\n        ProcessName = tostring(W.ProcessName),\r\n        ProcessProductName = tostring(W.ProcessProductName),\r\n        ProcessPublisher = tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(trim(@\"^\\s+|\\s+$\", Domain))\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(trim(@\"^\\s+|\\s+$\", ProcessName))\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(trim(@\"^\\s+|\\s+$\", Provider)),\r\n                \"|\",\r\n                tolower(trim(@\"^\\s+|\\s+$\", Product))\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\n\r\n// ============================================================\r\n// SANCTIONED POLICY KEYS\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// CONFIGURED SANCTIONED INVENTORY\r\n//\r\n// One logical row per PolicyKey.\r\n// ============================================================\r\n\r\nlet SanctionedInventory =\r\n    AIData\r\n\r\n    | where\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n\r\n    | where set_has_element(\r\n        SanctionedPolicies,\r\n        PolicyKey\r\n    )\r\n\r\n    | summarize\r\n        Provider =\r\n            take_any(Provider),\r\n\r\n        ProductNames =\r\n            make_set(\r\n                Product,\r\n                20\r\n            ),\r\n\r\n        Domains =\r\n            make_set_if(\r\n                Domain,\r\n                isnotempty(Domain),\r\n                20\r\n            ),\r\n\r\n        Processes =\r\n            make_set_if(\r\n                ProcessName,\r\n                isnotempty(ProcessName),\r\n                20\r\n            ),\r\n\r\n        CatalogueSources =\r\n            make_set(\r\n                CatalogueSource,\r\n                10\r\n            )\r\n\r\n      by PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n        | where isnotempty(Domain)\r\n        | summarize make_set(Domain, 1000)\r\n    );\r\n\r\n\r\n// ============================================================\r\n// NETWORK OBSERVATIONS\r\n// ============================================================\r\n\r\nlet NetworkObserved =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any(\r\n        AIDomains\r\n    )\r\n\r\n    | project RemoteUrl\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n        | where isnotempty(Domain)\r\n        | distinct\r\n            Domain,\r\n            PolicyKey\r\n        | extend JoinKey = 1\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    | where set_has_element(\r\n        SanctionedPolicies,\r\n        PolicyKey\r\n    )\r\n\r\n    | project PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP / PROCESS CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        PolicyKey,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP / PROCESS OBSERVATIONS\r\n// ============================================================\r\n\r\nlet DesktopObserved =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower ==\r\n            CatalogueProductNameLower\r\n        or isempty(\r\n            ProcessVersionInfoProductName\r\n        )\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has\r\n            CataloguePublisherLower\r\n        or isempty(\r\n            ProcessVersionInfoCompanyName\r\n        )\r\n\r\n    | where set_has_element(\r\n        SanctionedPolicies,\r\n        PolicyKey\r\n    )\r\n\r\n    | project PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// OBSERVED SANCTIONED POLICIES\r\n// ============================================================\r\n\r\nlet ObservedSanctioned =\r\n    union\r\n        NetworkObserved,\r\n        DesktopObserved\r\n\r\n    | distinct PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// SANCTIONED BUT NOT OBSERVED\r\n// ============================================================\r\n\r\nSanctionedInventory\r\n\r\n| join kind=leftanti (\r\n    ObservedSanctioned\r\n) on PolicyKey\r\n\r\n\r\n// ============================================================\r\n// FRIENDLY DISPLAY\r\n// ============================================================\r\n\r\n| extend ['Products Configured'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProductNames\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Domains / Indicators'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            Domains\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Processes'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            Processes\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Catalogue Source'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            CatalogueSources\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ProductTitle =\r\n    strcat(\r\n        \"⚪ \",\r\n        Provider,\r\n        \" - \",\r\n        ['Products Configured']\r\n    )\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    ProductTitle,\r\n\r\n    Provider,\r\n\r\n    ['Products Configured'],\r\n\r\n    PolicyKey,\r\n\r\n    ['Domains / Indicators'],\r\n\r\n    ['Processes'],\r\n\r\n    ['Catalogue Source']\r\n\r\n| order by\r\n    Provider asc,\r\n    ProductTitle asc",
              "size": 4,
              "title": "⚪ Sanctioned AI Products Not Observed - {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "visualization": "table",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "Products Configured"
                },
                "showBorder": false
              }
            },
            "customWidth": "50",
            "name": "query - Sanctioned AI Product Tiles - Copy"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// Unsanctioned AI Products Observed - Tile Summary\r\n// ============================================================\r\n\r\nlet PublicAIData = externaldata(\n    Provider:string,\n    Product:string,\n    Domain:string,\n    Category:string,\n    Sanctioned:bool,\n    RiskType:string,\n    SourceURL:string,\n    ProcessName:string,\n    ProcessProductName:string,\n    ProcessPublisher:string\n)\n[\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\n]\nwith (\n    format=\"csv\",\n    ignoreFirstRecord=true\n)\n| extend Sanctioned=false, CatalogueSource=\"Public\", SourcePriority=1\n| extend PolicyKey=trim(@\"^-+|-+$\", replace_regex(tolower(strcat(Provider,\"-\",Product)), @\"[^a-z0-9]+\", \"-\"))\n| extend MatchKey=case(\n    isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n    isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n    strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n);\n\nlet LocalAIData =\n    Watchlist\n    | where WatchlistAlias == \"AIGovernance\"\n    | summarize arg_max(LastUpdatedTimeUTC, *) by SearchKey\n    | where isnotempty(WatchlistItem)\n    | extend W=todynamic(WatchlistItem)\n    | project\n        Key=tostring(W.Key), PolicyKey=tostring(W.PolicyKey),\n        Provider=tostring(W.Provider), Product=tostring(W.Product), Domain=tostring(W.Domain),\n        Category=tostring(W.Category), Sanctioned=tobool(W.Sanctioned), RiskType=tostring(W.RiskType),\n        SourceURL=tostring(W.SourceURL), ProcessName=tostring(W.ProcessName),\n        ProcessProductName=tostring(W.ProcessProductName), ProcessPublisher=tostring(W.ProcessPublisher)\n    | extend PolicyKey=iff(isnotempty(PolicyKey),PolicyKey,Key), CatalogueSource=\"Local Watchlist\", SourcePriority=2\n    | extend MatchKey=case(\n        isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n        isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n        strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n    );\n\nlet AIData =\n    union PublicAIData, LocalAIData\n    | where isnotempty(PolicyKey)\n    | summarize arg_max(SourcePriority, *) by MatchKey\n    | project Provider,Product,Domain,Category,Sanctioned,RiskType,SourceURL,ProcessName,ProcessProductName,ProcessPublisher,PolicyKey,CatalogueSource;\n\nlet AIDomainData = AIData;\r\n\r\nlet AIDomains = toscalar(\r\n    AIDomainData\r\n    | where isnotempty(Domain)\r\n    | summarize make_set(Domain)\r\n);\r\n\r\nlet SanctionedPolicies = dynamic([{Sanctioned}]);\r\n\r\nlet Browsers = dynamic([\r\n    \"msedge.exe\",\r\n    \"chrome.exe\",\r\n    \"firefox.exe\",\r\n    \"brave.exe\",\r\n    \"opera.exe\",\r\n    \"iexplore.exe\"\r\n]);\r\n\r\n\r\n// ============================================================\r\n// NETWORK ACTIVITY\r\n// ============================================================\r\n\r\nlet NetworkActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n\r\n    | where isnotempty(InitiatingProcessAccountUpn)\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any (AIDomains)\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl,\r\n        Process = InitiatingProcessFileName\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIDomainData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\n            PolicyKey,\r\n            Category,\r\n            RiskType\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    // Exact sanctioned membership\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | extend IsBrowser =\r\n        Process in~ (Browsers)\r\n\r\n    | extend IsAPI =\r\n        RiskType =~ \"API\"\r\n        or Category =~ \"API\"\r\n        or Product has \"API\"\r\n\r\n    | extend IsDeveloper =\r\n        RiskType =~ \"Developer\"\r\n        or Category =~ \"Developer\"\r\n\r\n    | extend AccessType =\r\n        case(\r\n            IsBrowser,\r\n                \"Web / Browser\",\r\n\r\n            IsAPI or IsDeveloper,\r\n                \"API / Developer\",\r\n\r\n            \"Non-browser Network\"\r\n        )\r\n\r\n    | where not(IsSanctioned)\r\n\r\n    | project\r\n        Timestamp,\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        PolicyKey,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        AccessType;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIDomainData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\n        PolicyKey,\r\n        CatalogueProcessName = ProcessName,\r\n        CatalogueProductName = ProcessProductName,\r\n        CataloguePublisher = ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT ACTIVITY\r\n// ============================================================\r\n\r\nlet DesktopActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(ProcessVersionInfoProductName),\r\n\r\n        PublisherLower =\r\n            tolower(ProcessVersionInfoCompanyName)\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(CatalogueProcessName),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(CatalogueProductName),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(CataloguePublisher)\r\n\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower == CatalogueProductNameLower\r\n        or isempty(ProcessVersionInfoProductName)\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has CataloguePublisherLower\r\n        or isempty(ProcessVersionInfoCompanyName)\r\n\r\n    // Exact sanctioned membership\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | where not(IsSanctioned)\r\n\r\n    | extend AccessType =\r\n        \"Desktop Client\"\r\n\r\n    | project\r\n        Timestamp,\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        User = AccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        AccessType;\r\n\r\n\r\n// ============================================================\r\n// COMBINED SUMMARY\r\n// ============================================================\r\n\r\nunion\r\n    NetworkActivity,\r\n    DesktopActivity\r\n\r\n| summarize\r\n    Users =\r\n        dcount(User),\r\n\r\n    Devices =\r\n        dcount(DeviceId),\r\n\r\n    Activity =\r\n        count(),\r\n\r\n    AccessTypes =\r\n        make_set(\r\n            AccessType,\r\n            10\r\n        ),\r\n\r\n    UserList =\r\n        make_set(\r\n            User,\r\n            20\r\n        ),\r\n\r\n    DeviceList =\r\n        make_set(\r\n            DeviceName,\r\n            20\r\n        ),\r\n\r\n    FirstSeen =\r\n        min(Timestamp),\r\n\r\n    LastSeen =\r\n        max(Timestamp)\r\n\r\n  by\r\n    Provider,\r\n    Product,\r\n    PolicyKey\r\n\r\n| extend ProductTitle =\r\n    strcat(\r\n        Provider,\r\n        \" - \",\r\n        Product\r\n    )\r\n\r\n| order by\r\n    Users desc,\r\n    Activity desc\r\n\r\n| project\r\n    ProductTitle,\r\n    Users,\r\n    Provider,\r\n    Product,\r\n    PolicyKey,\r\n    Devices,\r\n    Activity,\r\n    AccessTypes,\r\n    LastSeen,\r\n    FirstSeen,\r\n    UserList,\r\n    DeviceList",
              "size": 1,
              "title": "🔴 Unsanctioned AI Products Observed - {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "visualization": "tiles",
              "tileSettings": {
                "titleContent": {
                  "columnMatch": "ProductTitle"
                },
                "leftContent": {
                  "columnMatch": "Users",
                  "formatter": 12,
                  "formatOptions": {
                    "palette": "none"
                  },
                  "numberFormat": {
                    "unit": 17,
                    "options": {
                      "style": "decimal",
                      "maximumFractionDigits": 0,
                      "maximumSignificantDigits": 3
                    }
                  }
                },
                "showBorder": false
              }
            },
            "name": "query - Unsanctioned AI Product Tiles"
          },
          {
            "type": 1,
            "content": {
              "json": "This report provides a consolidated view of **AI usage observed across users and devices**, classifying activity as either 🟢 **Sanctioned** or 🔴 **Unsanctioned** based on the AI policies selected as approved above. Activity is further separated by how the service was accessed: **Web / Browser** for browser-based use, **API / Developer** for developer or API services, **Non-browser Network** for AI network connections originating from other processes, and **Desktop Client** for known AI applications observed executing on endpoints. Use the grouped results and column filters to identify unsanctioned AI adoption, understand how approved services are being consumed, and investigate the supporting users, devices, processes, URLs, and execution evidence. Results reflect activity within the selected **Time Range**."
            },
            "name": "text - 22"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// AI Compliance & Governance Review\r\n//\r\n// Governance:\r\n//   🟢 Sanctioned\r\n//   🔴 Unsanctioned\r\n//\r\n// Access Type:\r\n//   Web / Browser\r\n//   API / Developer\r\n//   Non-browser Network\r\n//   Desktop Client\r\n//\r\n// Evidence Type:\r\n//   Network\r\n//   Desktop Execution\r\n//\r\n// Workbook TimeRange applies explicitly.\r\n//\r\n// IMPORTANT:\r\n// If no sanctioned applications are selected, all detected\r\n// AI activity is classified as Unsanctioned.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// AI SERVICE CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData = externaldata(\n    Provider:string,\n    Product:string,\n    Domain:string,\n    Category:string,\n    Sanctioned:bool,\n    RiskType:string,\n    SourceURL:string,\n    ProcessName:string,\n    ProcessProductName:string,\n    ProcessPublisher:string\n)\n[\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\n]\nwith (\n    format=\"csv\",\n    ignoreFirstRecord=true\n)\n| extend Sanctioned=false, CatalogueSource=\"Public\", SourcePriority=1\n| extend PolicyKey=trim(@\"^-+|-+$\", replace_regex(tolower(strcat(Provider,\"-\",Product)), @\"[^a-z0-9]+\", \"-\"))\n| extend MatchKey=case(\n    isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n    isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n    strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n);\n\nlet LocalAIData =\n    Watchlist\n    | where WatchlistAlias == \"AIGovernance\"\n    | summarize arg_max(LastUpdatedTimeUTC, *) by SearchKey\n    | where isnotempty(WatchlistItem)\n    | extend W=todynamic(WatchlistItem)\n    | project\n        Key=tostring(W.Key), PolicyKey=tostring(W.PolicyKey),\n        Provider=tostring(W.Provider), Product=tostring(W.Product), Domain=tostring(W.Domain),\n        Category=tostring(W.Category), Sanctioned=tobool(W.Sanctioned), RiskType=tostring(W.RiskType),\n        SourceURL=tostring(W.SourceURL), ProcessName=tostring(W.ProcessName),\n        ProcessProductName=tostring(W.ProcessProductName), ProcessPublisher=tostring(W.ProcessPublisher)\n    | extend PolicyKey=iff(isnotempty(PolicyKey),PolicyKey,Key), CatalogueSource=\"Local Watchlist\", SourcePriority=2\n    | extend MatchKey=case(\n        isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n        isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n        strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n    );\n\nlet AIData =\n    union PublicAIData, LocalAIData\n    | where isnotempty(PolicyKey)\n    | summarize arg_max(SourcePriority, *) by MatchKey\n    | project Provider,Product,Domain,Category,Sanctioned,RiskType,SourceURL,ProcessName,ProcessProductName,ProcessPublisher,PolicyKey,CatalogueSource;\n\nlet AIDomainData = AIData;\r\n\r\n\r\n// ============================================================\r\n// ALL KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains = toscalar(\r\n    AIDomainData\r\n    | where isnotempty(Domain)\r\n    | summarize make_set(Domain)\r\n);\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED SERVICES\r\n//\r\n// Empty selection becomes dynamic([]).\r\n// In that state no observed AI service is sanctioned.\r\n// ============================================================\r\n\r\nlet SanctionedPolicies = dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// KNOWN BROWSERS\r\n// ============================================================\r\n\r\nlet Browsers = dynamic([\r\n    \"msedge.exe\",\r\n    \"chrome.exe\",\r\n    \"firefox.exe\",\r\n    \"brave.exe\",\r\n    \"opera.exe\",\r\n    \"iexplore.exe\"\r\n]);\r\n\r\n\r\n// ============================================================\r\n// NETWORK EVIDENCE\r\n// ============================================================\r\n\r\nlet NetworkEvidenceRaw =\r\n    DeviceNetworkEvents\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n    | where isnotempty(InitiatingProcessAccountUpn)\r\n    | where isnotempty(RemoteUrl)\r\n    | where RemoteUrl has_any (AIDomains)\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl,\r\n        Process = InitiatingProcessFileName\r\n\r\n    // --------------------------------------------------------\r\n    // Match observed URLs against AI catalogue\r\n    // --------------------------------------------------------\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIDomainData\r\n        | where isnotempty(Domain)\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\n            PolicyKey,\r\n            Category,\r\n            RiskType,\r\n            SourceURL\r\n        | extend JoinKey = 1\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    // --------------------------------------------------------\r\n    // GOVERNANCE\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | extend Governance =\r\n        iff(\r\n            IsSanctioned,\r\n            \"🟢 Sanctioned\",\r\n            \"🔴 Unsanctioned\"\r\n        )\r\n\r\n    // --------------------------------------------------------\r\n    // ACCESS CLASSIFICATION\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsBrowser =\r\n        Process in~ (Browsers)\r\n\r\n    | extend IsAPI =\r\n        RiskType =~ \"API\"\r\n        or Category =~ \"API\"\r\n        or Product has \"API\"\r\n\r\n    | extend IsDeveloper =\r\n        RiskType =~ \"Developer\"\r\n        or Category =~ \"Developer\"\r\n\r\n    | extend AccessType =\r\n        case(\r\n            IsBrowser,\r\n                \"Web / Browser\",\r\n\r\n            IsAPI or IsDeveloper,\r\n                \"API / Developer\",\r\n\r\n            \"Non-browser Network\"\r\n        )\r\n\r\n    | extend EvidenceType =\r\n        \"Network\"\r\n\r\n    // --------------------------------------------------------\r\n    // NORMALISE NETWORK SCHEMA\r\n    // --------------------------------------------------------\r\n\r\n    | project\r\n        Timestamp,\r\n        Governance,\r\n        AccessType,\r\n        EvidenceType,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        Process,\r\n        RemoteUrl,\r\n        InstallationType = \"\",\r\n        EvidenceDetail = RemoteUrl,\r\n        Version = \"\",\r\n        Publisher = \"\",\r\n        FolderPath = \"\",\r\n        SourceURL;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIDomainData\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\n        PolicyKey,\r\n        Category,\r\n        RiskType,\r\n        SourceURL,\r\n        CatalogueProcessName = ProcessName,\r\n        CatalogueProductName = ProcessProductName,\r\n        CataloguePublisher = ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP CLIENT EXECUTION EVIDENCE\r\n// ============================================================\r\n\r\nlet DesktopEvidenceRaw =\r\n    DeviceProcessEvents\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(ProcessVersionInfoProductName),\r\n\r\n        PublisherLower =\r\n            tolower(ProcessVersionInfoCompanyName)\r\n\r\n    // --------------------------------------------------------\r\n    // Match process against AI client catalogue\r\n    // --------------------------------------------------------\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(CatalogueProcessName),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(CatalogueProductName),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(CataloguePublisher)\r\n    ) on ProcessNameLower\r\n\r\n    // --------------------------------------------------------\r\n    // Validate product metadata where available\r\n    // --------------------------------------------------------\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower == CatalogueProductNameLower\r\n        or isempty(ProcessVersionInfoProductName)\r\n\r\n    // --------------------------------------------------------\r\n    // Validate publisher metadata where available\r\n    // --------------------------------------------------------\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has CataloguePublisherLower\r\n        or isempty(ProcessVersionInfoCompanyName)\r\n\r\n    // --------------------------------------------------------\r\n    // INSTALLATION TYPE\r\n    // --------------------------------------------------------\r\n\r\n    | extend InstallationType =\r\n        case(\r\n            FolderPath has @\"\\Program Files\\WindowsApps\\\",\r\n                \"Microsoft Store / MSIX\",\r\n\r\n            FolderPath has @\"\\AppData\\Local\\Packages\\\",\r\n                \"User / Packaged Application\",\r\n\r\n            FolderPath has @\"\\AppData\\Local\\Programs\\\",\r\n                \"Per-user Installation\",\r\n\r\n            FolderPath has @\"\\Program Files (x86)\\\",\r\n                \"System Installation (x86)\",\r\n\r\n            FolderPath has @\"\\Program Files\\\",\r\n                \"System Installation\",\r\n\r\n            FolderPath has @\"\\AppData\\\",\r\n                \"User Profile\",\r\n\r\n            \"Other / Unknown\"\r\n        )\r\n\r\n    // --------------------------------------------------------\r\n    // DESKTOP EVIDENCE DESCRIPTION\r\n    // --------------------------------------------------------\r\n\r\n    | extend EvidenceDetail =\r\n        case(\r\n            InstallationType == \"Microsoft Store / MSIX\",\r\n                \"Executed from Store / MSIX package\",\r\n\r\n            InstallationType == \"User / Packaged Application\",\r\n                \"Executed from user package\",\r\n\r\n            InstallationType == \"Per-user Installation\",\r\n                \"Executed from per-user installation\",\r\n\r\n            InstallationType startswith \"System Installation\",\r\n                \"Executed from system installation\",\r\n\r\n            \"Client execution observed\"\r\n        )\r\n\r\n    // --------------------------------------------------------\r\n    // GOVERNANCE\r\n    // --------------------------------------------------------\r\n\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | extend Governance =\r\n        iff(\r\n            IsSanctioned,\r\n            \"🟢 Sanctioned\",\r\n            \"🔴 Unsanctioned\"\r\n        )\r\n\r\n    // --------------------------------------------------------\r\n    // ACCESS / EVIDENCE TYPE\r\n    // --------------------------------------------------------\r\n\r\n    | extend AccessType =\r\n        \"Desktop Client\"\r\n\r\n    | extend EvidenceType =\r\n        \"Desktop Execution\"\r\n\r\n    // --------------------------------------------------------\r\n    // NORMALISE DESKTOP SCHEMA\r\n    // --------------------------------------------------------\r\n\r\n    | project\r\n        Timestamp,\r\n        Governance,\r\n        AccessType,\r\n        EvidenceType,\r\n        User = AccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        Process = FileName,\r\n        RemoteUrl = \"\",\r\n        InstallationType,\r\n        EvidenceDetail,\r\n        Version = ProcessVersionInfoProductVersion,\r\n        Publisher = ProcessVersionInfoCompanyName,\r\n        FolderPath,\r\n        SourceURL;\r\n\r\n\r\n// ============================================================\r\n// COMBINE NETWORK + DESKTOP EVIDENCE\r\n// ============================================================\r\n\r\nunion\r\n    NetworkEvidenceRaw,\r\n    DesktopEvidenceRaw\r\n\r\n\r\n// ============================================================\r\n// AGGREGATE BY\r\n//\r\n// Governance\r\n// Access Type\r\n// Evidence Type\r\n// User\r\n// AI Product\r\n// ============================================================\r\n\r\n| summarize\r\n\r\n    Events =\r\n        count(),\r\n\r\n    Devices =\r\n        dcount(DeviceId),\r\n\r\n    DeviceList =\r\n        make_set_if(\r\n            DeviceName,\r\n            isnotempty(DeviceName),\r\n            30\r\n        ),\r\n\r\n    Processes =\r\n        make_set_if(\r\n            Process,\r\n            isnotempty(Process),\r\n            30\r\n        ),\r\n\r\n    RemoteURLs =\r\n        make_set_if(\r\n            RemoteUrl,\r\n            isnotempty(RemoteUrl),\r\n            30\r\n        ),\r\n\r\n    InstallationTypes =\r\n        make_set_if(\r\n            InstallationType,\r\n            isnotempty(InstallationType),\r\n            10\r\n        ),\r\n\r\n    EvidenceDetails =\r\n        make_set_if(\r\n            EvidenceDetail,\r\n            isnotempty(EvidenceDetail),\r\n            20\r\n        ),\r\n\r\n    Versions =\r\n        make_set_if(\r\n            Version,\r\n            isnotempty(Version),\r\n            20\r\n        ),\r\n\r\n    Publishers =\r\n        make_set_if(\r\n            Publisher,\r\n            isnotempty(Publisher),\r\n            20\r\n        ),\r\n\r\n    Paths =\r\n        make_set_if(\r\n            FolderPath,\r\n            isnotempty(FolderPath),\r\n            30\r\n        ),\r\n\r\n    FirstSeen =\r\n        min(Timestamp),\r\n\r\n    LastSeen =\r\n        max(Timestamp)\r\n\r\n  by\r\n    Governance,\r\n    AccessType,\r\n    EvidenceType,\r\n    User,\r\n    Provider,\r\n    Product,\r\n    Domain,\r\n    Category,\r\n    RiskType,\r\n    SourceURL\r\n\r\n\r\n// ============================================================\r\n// DISPLAY FIELDS\r\n// ============================================================\r\n\r\n| extend AIService =\r\n    strcat(\r\n        Provider,\r\n        \" - \",\r\n        Product\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORTING\r\n//\r\n// Unsanctioned first.\r\n// ============================================================\r\n\r\n| extend GovernanceSort =\r\n    case(\r\n        Governance == \"🔴 Unsanctioned\", 1,\r\n        Governance == \"🟢 Sanctioned\", 2,\r\n        3\r\n    )\r\n\r\n| extend AccessSort =\r\n    case(\r\n        AccessType == \"API / Developer\", 1,\r\n        AccessType == \"Non-browser Network\", 2,\r\n        AccessType == \"Desktop Client\", 3,\r\n        AccessType == \"Web / Browser\", 4,\r\n        5\r\n    )\r\n\r\n| order by\r\n    GovernanceSort asc,\r\n    AccessSort asc,\r\n    Events desc,\r\n    User asc,\r\n    Provider asc,\r\n    Product asc\r\n\r\n\r\n// ============================================================\r\n// FINAL COLUMN ORDER\r\n// ============================================================\r\n\r\n| project\r\n    Governance,\r\n\r\n    ['Access Type'] =\r\n        AccessType,\r\n\r\n    ['Evidence Type'] =\r\n        EvidenceType,\r\n\r\n    User,\r\n\r\n    ['AI Service'] =\r\n        AIService,\r\n\r\n    Provider,\r\n\r\n    Product,\r\n\r\n    Domain,\r\n\r\n    Category,\r\n\r\n    ['Risk Type'] =\r\n        RiskType,\r\n\r\n    Devices,\r\n\r\n    ['Device List'] =\r\n        DeviceList,\r\n\r\n    Events,\r\n\r\n    Processes,\r\n\r\n    ['Remote URLs'] =\r\n        RemoteURLs,\r\n\r\n    ['Installation Types'] =\r\n        InstallationTypes,\r\n\r\n    ['Evidence Details'] =\r\n        EvidenceDetails,\r\n\r\n    Versions,\r\n\r\n    Publishers,\r\n\r\n    Paths,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen,\r\n\r\n    SourceURL",
              "size": 0,
              "title": "AI Compliance & Governance Review — {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "gridSettings": {
                "formatters": [
                  {
                    "columnMatch": "$gen_group",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "33.8571ch"
                    }
                  },
                  {
                    "columnMatch": "$gen_group",
                    "formatter": 0,
                    "formatOptions": {
                      "customColumnWidthSetting": "33.8571ch"
                    }
                  }
                ],
                "rowLimit": 5000,
                "filter": true,
                "hierarchySettings": {
                  "treeType": 1,
                  "groupBy": [
                    "Governance",
                    "Access Type"
                  ],
                  "expandTopLevel": true
                }
              },
              "sortBy": []
            },
            "name": "query - AI Compliance Governance Review"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// NEW AI USERS\r\n//\r\n// Observation window: fixed 30 days\r\n// New user: first observed AI activity in last 7 days\r\n//\r\n// Governance:\r\n//   🟢 Sanctioned only\r\n//   🟠 Mixed\r\n//   🔴 Unsanctioned only\r\n//\r\n// If no sanctioned products are selected, all observed\r\n// products are treated as unsanctioned.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// AI SERVICE CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData = externaldata(\r\n    Provider:string,\r\n    Product:string,\r\n    Domain:string,\r\n    Category:string,\r\n    Sanctioned:bool,\r\n    RiskType:string,\r\n    SourceURL:string,\r\n    ProcessName:string,\r\n    ProcessProductName:string,\r\n    ProcessPublisher:string\r\n)\r\n[\r\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n]\r\nwith (\r\n    format=\"csv\",\r\n    ignoreFirstRecord=true\r\n)\r\n| extend\r\n    Sanctioned = false,\r\n    CatalogueSource = \"Public\",\r\n    SourcePriority = 1\r\n| extend PolicyKey =\r\n    trim(\r\n        @\"^-+|-+$\",\r\n        replace_regex(\r\n            tolower(\r\n                strcat(\r\n                    Provider,\r\n                    \"-\",\r\n                    Product\r\n                )\r\n            ),\r\n            @\"[^a-z0-9]+\",\r\n            \"-\"\r\n        )\r\n    )\r\n| extend MatchKey =\r\n    case(\r\n        isnotempty(Domain),\r\n            strcat(\r\n                \"domain:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Domain\r\n                    )\r\n                )\r\n            ),\r\n\r\n        isnotempty(ProcessName),\r\n            strcat(\r\n                \"process:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        ProcessName\r\n                    )\r\n                )\r\n            ),\r\n\r\n        strcat(\r\n            \"product:\",\r\n            tolower(\r\n                trim(\r\n                    @\"^\\s+|\\s+$\",\r\n                    Provider\r\n                )\r\n            ),\r\n            \"|\",\r\n            tolower(\r\n                trim(\r\n                    @\"^\\s+|\\s+$\",\r\n                    Product\r\n                )\r\n            )\r\n        )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL WATCHLIST\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key =\r\n            tostring(W.Key),\r\n\r\n        PolicyKey =\r\n            tostring(W.PolicyKey),\r\n\r\n        Provider =\r\n            tostring(W.Provider),\r\n\r\n        Product =\r\n            tostring(W.Product),\r\n\r\n        Domain =\r\n            tostring(W.Domain),\r\n\r\n        Category =\r\n            tostring(W.Category),\r\n\r\n        Sanctioned =\r\n            tobool(W.Sanctioned),\r\n\r\n        RiskType =\r\n            tostring(W.RiskType),\r\n\r\n        SourceURL =\r\n            tostring(W.SourceURL),\r\n\r\n        ProcessName =\r\n            tostring(W.ProcessName),\r\n\r\n        ProcessProductName =\r\n            tostring(W.ProcessProductName),\r\n\r\n        ProcessPublisher =\r\n            tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            Domain\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            ProcessName\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Provider\r\n                    )\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Product\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        Sanctioned,\r\n        RiskType,\r\n        SourceURL,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\nlet AIDomainData = AIData;\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIDomainData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | summarize\r\n            make_set(\r\n                Domain,\r\n                1000\r\n            )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED SERVICES\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// BROWSERS\r\n// ============================================================\r\n\r\nlet Browsers =\r\n    dynamic([\r\n        \"msedge.exe\",\r\n        \"chrome.exe\",\r\n        \"firefox.exe\",\r\n        \"brave.exe\",\r\n        \"opera.exe\",\r\n        \"iexplore.exe\"\r\n    ]);\r\n\r\n\r\n// ============================================================\r\n// OBSERVED AI ACTIVITY\r\n//\r\n// Fixed 30-day window intentionally used here rather than\r\n// Workbook TimeRange so \"new\" has useful historical context.\r\n// ============================================================\r\n\r\nlet AIActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp >= ago(30d)\r\n\r\n    | where RemoteUrl has_any (\r\n        AIDomains\r\n    )\r\n\r\n    | where InitiatingProcessFileName in~ (\r\n        Browsers\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl;\r\n\r\n\r\n// ============================================================\r\n// MAP ACTIVITY TO AI PRODUCTS\r\n// ============================================================\r\n\r\nlet MappedAIActivity =\r\n    AIActivity\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIDomainData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    // Workbook selection is the governance authority.\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    // Preserve governance directly in the product label.\r\n    | extend ProductDisplay =\r\n        strcat(\r\n            iff(\r\n                IsSanctioned,\r\n                \"🟢 \",\r\n                \"🔴 \"\r\n            ),\r\n            Product\r\n        )\r\n\r\n    | project\r\n        Timestamp,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        ProductDisplay,\r\n        Domain,\r\n        PolicyKey,\r\n        IsSanctioned;\r\n\r\n\r\n// ============================================================\r\n// USER SUMMARY\r\n// ============================================================\r\n\r\nMappedAIActivity\r\n\r\n| summarize\r\n\r\n    FirstSeen =\r\n        min(Timestamp),\r\n\r\n    LastSeen =\r\n        max(Timestamp),\r\n\r\n    Providers =\r\n        dcount(Provider),\r\n\r\n    Products =\r\n        dcount(PolicyKey),\r\n\r\n    SanctionedProducts =\r\n        dcountif(\r\n            PolicyKey,\r\n            IsSanctioned\r\n        ),\r\n\r\n    UnsanctionedProducts =\r\n        dcountif(\r\n            PolicyKey,\r\n            not(IsSanctioned)\r\n        ),\r\n\r\n    ProductsObserved =\r\n        make_set(\r\n            ProductDisplay,\r\n            20\r\n        ),\r\n\r\n    ProvidersUsed =\r\n        make_set(\r\n            Provider,\r\n            20\r\n        ),\r\n\r\n    Devices =\r\n        dcount(DeviceId)\r\n\r\n  by User\r\n\r\n\r\n// ============================================================\r\n// NEW USERS\r\n//\r\n// First observed during the most recent 7 days of the fixed\r\n// 30-day observation window.\r\n// ============================================================\r\n\r\n| where FirstSeen >= ago(7d)\r\n\r\n\r\n// ============================================================\r\n// GOVERNANCE STATUS\r\n// ============================================================\r\n\r\n| extend Governance =\r\n    case(\r\n        SanctionedProducts > 0\r\n            and UnsanctionedProducts > 0,\r\n            \"🟠 Mixed\",\r\n\r\n        UnsanctionedProducts > 0,\r\n            \"🔴 Unsanctioned only\",\r\n\r\n        SanctionedProducts > 0,\r\n            \"🟢 Sanctioned only\",\r\n\r\n        \"⚪ Review\"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// FRIENDLY LISTS\r\n// ============================================================\r\n\r\n| extend ['Products Observed'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProductsObserved\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Providers Used'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProvidersUsed\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORT\r\n//\r\n// Unsanctioned first, then mixed, then sanctioned.\r\n// ============================================================\r\n\r\n| extend GovernanceSort =\r\n    case(\r\n        Governance == \"🔴 Unsanctioned only\", 1,\r\n        Governance == \"🟠 Mixed\", 2,\r\n        Governance == \"🟢 Sanctioned only\", 3,\r\n        4\r\n    )\r\n\r\n| order by\r\n    GovernanceSort asc,\r\n    FirstSeen desc\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    Governance,\r\n\r\n    User,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n\r\n    ['Sanctioned Products'] =\r\n        SanctionedProducts,\r\n\r\n    ['Unsanctioned Products'] =\r\n        UnsanctionedProducts,\r\n\r\n    ['Total Products'] =\r\n        Products,\r\n\r\n    ['Products Observed'],\r\n\r\n    Providers,\r\n\r\n    ['Providers Used'],\r\n\r\n    Devices,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen",
              "size": 1,
              "title": "🆕 New AI Users — First Observed in Last 7 Days (30-Day Observation Window), count: {$rowCount}",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "gridSettings": {
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Governance",
                    "sortOrder": 1
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "Governance",
                  "sortOrder": 1
                }
              ],
              "chartSettings": {
                "createOtherGroup": 25
              }
            },
            "name": "query - Observed in 7days"
          },
          {
            "type": 1,
            "content": {
              "json": "**New AI Users** identifies users whose first observed AI activity occurred within the most recent **7 days**, using a fixed **30-day observation window** to provide sufficient historical context. Users are classified as 🟢 **Sanctioned only**, 🟠 **Mixed**, or 🔴 **Unsanctioned only** based on the AI products observed and the sanctioned AI policies selected above. This view helps highlight new AI adoption and whether that adoption aligns with the organisation's approved AI services."
            },
            "name": "text - New AI Users Summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// MULTI-AI PRODUCT USAGE\r\n//\r\n// Uses Workbook TimeRange.\r\n//\r\n// Governance:\r\n//   🟢 Sanctioned only\r\n//   🟠 Mixed\r\n//   🔴 Unsanctioned only\r\n//\r\n// Includes:\r\n//   - Web / browser activity\r\n//   - Desktop / client activity\r\n//\r\n// Output:\r\n//   One row per user where more than one AI product\r\n//   was observed during the selected TimeRange.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// AI SERVICE CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData = externaldata(\r\n    Provider:string,\r\n    Product:string,\r\n    Domain:string,\r\n    Category:string,\r\n    Sanctioned:bool,\r\n    RiskType:string,\r\n    SourceURL:string,\r\n    ProcessName:string,\r\n    ProcessProductName:string,\r\n    ProcessPublisher:string\r\n)\r\n[\r\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n]\r\nwith (\r\n    format=\"csv\",\r\n    ignoreFirstRecord=true\r\n)\r\n| extend\r\n    Sanctioned = false,\r\n    CatalogueSource = \"Public\",\r\n    SourcePriority = 1\r\n| extend PolicyKey =\r\n    trim(\r\n        @\"^-+|-+$\",\r\n        replace_regex(\r\n            tolower(\r\n                strcat(\r\n                    Provider,\r\n                    \"-\",\r\n                    Product\r\n                )\r\n            ),\r\n            @\"[^a-z0-9]+\",\r\n            \"-\"\r\n        )\r\n    )\r\n| extend MatchKey =\r\n    case(\r\n        isnotempty(Domain),\r\n            strcat(\r\n                \"domain:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Domain\r\n                    )\r\n                )\r\n            ),\r\n\r\n        isnotempty(ProcessName),\r\n            strcat(\r\n                \"process:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        ProcessName\r\n                    )\r\n                )\r\n            ),\r\n\r\n        strcat(\r\n            \"product:\",\r\n            tolower(\r\n                trim(\r\n                    @\"^\\s+|\\s+$\",\r\n                    Provider\r\n                )\r\n            ),\r\n            \"|\",\r\n            tolower(\r\n                trim(\r\n                    @\"^\\s+|\\s+$\",\r\n                    Product\r\n                )\r\n            )\r\n        )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL WATCHLIST\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    // Raw Watchlist can retain historical item versions.\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key =\r\n            tostring(W.Key),\r\n\r\n        PolicyKey =\r\n            tostring(W.PolicyKey),\r\n\r\n        Provider =\r\n            tostring(W.Provider),\r\n\r\n        Product =\r\n            tostring(W.Product),\r\n\r\n        Domain =\r\n            tostring(W.Domain),\r\n\r\n        Category =\r\n            tostring(W.Category),\r\n\r\n        Sanctioned =\r\n            tobool(W.Sanctioned),\r\n\r\n        RiskType =\r\n            tostring(W.RiskType),\r\n\r\n        SourceURL =\r\n            tostring(W.SourceURL),\r\n\r\n        ProcessName =\r\n            tostring(W.ProcessName),\r\n\r\n        ProcessProductName =\r\n            tostring(W.ProcessProductName),\r\n\r\n        ProcessPublisher =\r\n            tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            Domain\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            ProcessName\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Provider\r\n                    )\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Product\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        Sanctioned,\r\n        RiskType,\r\n        SourceURL,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | summarize\r\n            make_set(\r\n                Domain,\r\n                1000\r\n            )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED SERVICES\r\n//\r\n// Empty selection means all observed AI is unsanctioned.\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// KNOWN BROWSERS\r\n// ============================================================\r\n\r\nlet Browsers = dynamic([\r\n    \"msedge.exe\",\r\n    \"chrome.exe\",\r\n    \"firefox.exe\",\r\n    \"brave.exe\",\r\n    \"opera.exe\",\r\n    \"iexplore.exe\"\r\n]);\r\n\r\n\r\n// ============================================================\r\n// WEB / DOMAIN ACTIVITY\r\n// ============================================================\r\n\r\nlet WebActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where RemoteUrl has_any (\r\n        AIDomains\r\n    )\r\n\r\n    | where InitiatingProcessFileName in~ (\r\n        Browsers\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceName,\r\n        RemoteUrl\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey,\r\n            Category,\r\n            RiskType\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | summarize\r\n        Events = count(),\r\n        FirstSeen = min(Timestamp),\r\n        LastSeen = max(Timestamp)\r\n\r\n      by\r\n        User,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        IsSanctioned\r\n\r\n    | project\r\n        User,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        IsSanctioned,\r\n        ActivityType = \"Web / Browser\",\r\n        Events,\r\n        FirstSeen,\r\n        LastSeen;\r\n\r\n\r\n// ============================================================\r\n// PROCESS / CLIENT CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        PolicyKey,\r\n        Category,\r\n        RiskType,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// PROCESS / CLIENT ACTIVITY\r\n// ============================================================\r\n\r\nlet ProcessActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        {TimeRange:start}\r\n        ..\r\n        {TimeRange:end}\r\n    )\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(\r\n            CatalogueProductName\r\n        )\r\n        or ProductNameLower\r\n            == CatalogueProductNameLower\r\n        or isempty(\r\n            ProcessVersionInfoProductName\r\n        )\r\n\r\n    | where\r\n        isempty(\r\n            CataloguePublisher\r\n        )\r\n        or PublisherLower has\r\n            CataloguePublisherLower\r\n        or isempty(\r\n            ProcessVersionInfoCompanyName\r\n        )\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | summarize\r\n        Events = count(),\r\n        FirstSeen = min(Timestamp),\r\n        LastSeen = max(Timestamp)\r\n\r\n      by\r\n        User = AccountUpn,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        IsSanctioned\r\n\r\n    | project\r\n        User,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        IsSanctioned,\r\n        ActivityType = \"Desktop Client\",\r\n        Events,\r\n        FirstSeen,\r\n        LastSeen;\r\n\r\n\r\n// ============================================================\r\n// COMBINED AI USAGE\r\n// ============================================================\r\n\r\nunion\r\n    WebActivity,\r\n    ProcessActivity\r\n\r\n// Decorate each observed product before aggregation so\r\n// governance remains visible in the final product list.\r\n| extend ProductDisplay =\r\n    strcat(\r\n        iff(\r\n            IsSanctioned,\r\n            \"🟢 \",\r\n            \"🔴 \"\r\n        ),\r\n        Product\r\n    )\r\n\r\n| summarize\r\n\r\n    AIProducts =\r\n        dcount(PolicyKey),\r\n\r\n    AIProviders =\r\n        dcount(Provider),\r\n\r\n    SanctionedProducts =\r\n        dcountif(\r\n            PolicyKey,\r\n            IsSanctioned\r\n        ),\r\n\r\n    UnsanctionedProducts =\r\n        dcountif(\r\n            PolicyKey,\r\n            not(IsSanctioned)\r\n        ),\r\n\r\n    ProductsObserved =\r\n        make_set(\r\n            ProductDisplay,\r\n            50\r\n        ),\r\n\r\n    ProvidersUsed =\r\n        make_set(\r\n            Provider,\r\n            50\r\n        ),\r\n\r\n    ActivityTypes =\r\n        make_set(\r\n            ActivityType,\r\n            10\r\n        ),\r\n\r\n    RiskTypes =\r\n        make_set(\r\n            RiskType,\r\n            20\r\n        ),\r\n\r\n    Categories =\r\n        make_set(\r\n            Category,\r\n            20\r\n        ),\r\n\r\n    Devices =\r\n        dcount(DeviceName),\r\n\r\n    DeviceList =\r\n        make_set(\r\n            DeviceName,\r\n            50\r\n        ),\r\n\r\n    Events =\r\n        sum(Events),\r\n\r\n    FirstSeen =\r\n        min(FirstSeen),\r\n\r\n    LastSeen =\r\n        max(LastSeen)\r\n\r\n  by User\r\n\r\n\r\n// ============================================================\r\n// ONLY USERS WITH MULTIPLE AI PRODUCTS\r\n// ============================================================\r\n\r\n| where AIProducts > 1\r\n\r\n\r\n// ============================================================\r\n// GOVERNANCE\r\n// ============================================================\r\n\r\n| extend Governance =\r\n    case(\r\n        SanctionedProducts > 0\r\n            and UnsanctionedProducts > 0,\r\n            \"🟠 Mixed\",\r\n\r\n        UnsanctionedProducts > 0,\r\n            \"🔴 Unsanctioned only\",\r\n\r\n        SanctionedProducts > 0,\r\n            \"🟢 Sanctioned only\",\r\n\r\n        \"⚪ Review\"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// USAGE PROFILE\r\n// ============================================================\r\n\r\n| extend UsageProfile =\r\n    case(\r\n        AIProducts >= 5,\r\n            \"5+ AI products\",\r\n\r\n        AIProducts >= 3,\r\n            \"3-4 AI products\",\r\n\r\n        \"2 AI products\"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// FRIENDLY LISTS\r\n// ============================================================\r\n\r\n| extend ['Products Observed'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProductsObserved\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Providers Used'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProvidersUsed\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Activity Types'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ActivityTypes\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORT\r\n// ============================================================\r\n\r\n| extend GovernanceSort =\r\n    case(\r\n        Governance == \"🔴 Unsanctioned only\", 1,\r\n        Governance == \"🟠 Mixed\", 2,\r\n        Governance == \"🟢 Sanctioned only\", 3,\r\n        4\r\n    )\r\n\r\n| order by\r\n    GovernanceSort asc,\r\n    AIProducts desc,\r\n    AIProviders desc,\r\n    Events desc\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    Governance,\r\n\r\n    User,\r\n\r\n    ['AI Products'] =\r\n        AIProducts,\r\n\r\n    ['Sanctioned Products'] =\r\n        SanctionedProducts,\r\n\r\n    ['Unsanctioned Products'] =\r\n        UnsanctionedProducts,\r\n\r\n    ['AI Providers'] =\r\n        AIProviders,\r\n\r\n    ['Usage Profile'] =\r\n        UsageProfile,\r\n\r\n    ['Products Observed'],\r\n\r\n    ['Providers Used'],\r\n\r\n    ['Activity Types'],\r\n\r\n    ['Risk Types'] =\r\n        RiskTypes,\r\n\r\n    Categories,\r\n\r\n    Devices,\r\n\r\n    ['Device List'] =\r\n        DeviceList,\r\n\r\n    Events,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen",
              "size": 0,
              "title": "🔀 Multi-AI Product Usage, count: {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "gridSettings": {
                "rowLimit": 1000,
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Governance",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "Governance",
                  "sortOrder": 2
                }
              ]
            },
            "name": "query - 23"
          },
          {
            "type": 1,
            "content": {
              "json": "**Multi-AI Product Usage** identifies users observed accessing **multiple different AI products or providers** across web and desktop client activity within the selected **Time Range**. Users are classified as 🟢 **Sanctioned only**, 🟠 **Mixed**, or 🔴 **Unsanctioned only**, with separate counts showing sanctioned and unsanctioned products. Use this view to identify broad AI adoption, use of multiple competing services, and potentially unmanaged or duplicated AI tooling."
            },
            "name": "text - Multi AI Usage Summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// AI AGENT / TOOL DETECTION\r\n//\r\n// Uses Workbook TimeRange.\r\n//\r\n// Governance:\r\n//   🟢 Sanctioned\r\n//   🔴 Unsanctioned\r\n//   ⚪ Not mapped to policy\r\n//\r\n// Agent/tool detection comes from ai_agent_watchlist.csv.\r\n//\r\n// Where possible, detected executable names are mapped back to\r\n// ai_domains_expanded.csv so the customer-selected {Sanctioned}\r\n// policy can also be applied.\r\n//\r\n// Tools that cannot be mapped to the AI product catalogue are\r\n// retained as \"Not mapped to policy\".\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// AI PRODUCT CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData = externaldata(\n    Provider:string,\n    Product:string,\n    Domain:string,\n    Category:string,\n    Sanctioned:bool,\n    RiskType:string,\n    SourceURL:string,\n    ProcessName:string,\n    ProcessProductName:string,\n    ProcessPublisher:string\n)\n[\n    @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\n]\nwith (\n    format=\"csv\",\n    ignoreFirstRecord=true\n)\n| extend Sanctioned=false, CatalogueSource=\"Public\", SourcePriority=1\n| extend PolicyKey=trim(@\"^-+|-+$\", replace_regex(tolower(strcat(Provider,\"-\",Product)), @\"[^a-z0-9]+\", \"-\"))\n| extend MatchKey=case(\n    isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n    isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n    strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n);\n\nlet LocalAIData =\n    Watchlist\n    | where WatchlistAlias == \"AIGovernance\"\n    | summarize arg_max(LastUpdatedTimeUTC, *) by SearchKey\n    | where isnotempty(WatchlistItem)\n    | extend W=todynamic(WatchlistItem)\n    | project\n        Key=tostring(W.Key), PolicyKey=tostring(W.PolicyKey),\n        Provider=tostring(W.Provider), Product=tostring(W.Product), Domain=tostring(W.Domain),\n        Category=tostring(W.Category), Sanctioned=tobool(W.Sanctioned), RiskType=tostring(W.RiskType),\n        SourceURL=tostring(W.SourceURL), ProcessName=tostring(W.ProcessName),\n        ProcessProductName=tostring(W.ProcessProductName), ProcessPublisher=tostring(W.ProcessPublisher)\n    | extend PolicyKey=iff(isnotempty(PolicyKey),PolicyKey,Key), CatalogueSource=\"Local Watchlist\", SourcePriority=2\n    | extend MatchKey=case(\n        isnotempty(Domain), strcat(\"domain:\",tolower(trim(@\"^\\s+|\\s+$\",Domain))),\n        isnotempty(ProcessName), strcat(\"process:\",tolower(trim(@\"^\\s+|\\s+$\",ProcessName))),\n        strcat(\"product:\",tolower(trim(@\"^\\s+|\\s+$\",Provider)),\"|\",tolower(trim(@\"^\\s+|\\s+$\",Product)))\n    );\n\nlet AIData =\n    union PublicAIData, LocalAIData\n    | where isnotempty(PolicyKey)\n    | summarize arg_max(SourcePriority, *) by MatchKey\n    | project Provider,Product,Domain,Category,Sanctioned,RiskType,SourceURL,ProcessName,ProcessProductName,ProcessPublisher,PolicyKey,CatalogueSource;\n\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED SERVICES\r\n//\r\n// If nothing is selected, mapped products are unsanctioned.\r\n// ============================================================\r\n\r\nlet SanctionedPolicies = dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// PROCESS -> AI PRODUCT POLICY MAP\r\n//\r\n// Rename ProcessName to FileNameLower so the later join can\r\n// use the same join-column name on both sides.\r\n// ============================================================\r\n\r\nlet AIProcessPolicy =\r\n    AIData\r\n    | where isnotempty(ProcessName)\r\n\r\n    | extend FileNameLower =\r\n        tolower(ProcessName)\r\n\r\n    | extend IsSanctioned =\r\n        array_length(SanctionedPolicies) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        FileNameLower,\r\n        AIProvider = Provider,\r\n        AIProduct = Product,\r\n        PolicyKey,\r\n        AIDomain = Domain,\r\n        IsSanctioned;\r\n\r\n\r\n// ============================================================\r\n// AI AGENT WATCHLIST\r\n// ============================================================\r\n\r\nlet AgentWatchlist =\r\n    externaldata(\r\n        Name:string,\r\n        Category:string,\r\n        MatchField:string,\r\n        Pattern:string,\r\n        MatchType:string,\r\n        RiskLevel:string,\r\n        DefaultAction:string,\r\n        Reason:string,\r\n        SourceURL:string\r\n    )\r\n    [\r\n        @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_agent_watchlist.csv\"\r\n    ]\r\n    with (\r\n        format=\"csv\",\r\n        ignoreFirstRecord=true\r\n    )\r\n\r\n    | extend SearchPattern =\r\n        tolower(\r\n            case(\r\n                MatchType =~ \"Wildcard\",\r\n                    replace_string(Pattern, \"*\", \"\"),\r\n\r\n                Pattern\r\n            )\r\n        )\r\n\r\n    | where isnotempty(SearchPattern);\r\n\r\n\r\n// ============================================================\r\n// BUILD SMALL SEARCH LIST\r\n//\r\n// Used to reduce DeviceProcessEvents before performing the\r\n// more expensive watchlist matching.\r\n// ============================================================\r\n\r\nlet WatchPatterns =\r\n    toscalar(\r\n        AgentWatchlist\r\n        | summarize make_set(SearchPattern, 500)\r\n    );\r\n\r\n\r\n// ============================================================\r\n// FILTER PROCESS EVENTS FIRST\r\n// ============================================================\r\n\r\nlet CandidateProcesses =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between ({TimeRange:start} .. {TimeRange:end})\r\n\r\n    | where isnotempty(DeviceName)\r\n\r\n    | extend\r\n        FileNameLower =\r\n            tolower(FileName),\r\n\r\n        CommandLineLower =\r\n            tolower(ProcessCommandLine)\r\n\r\n    | where\r\n        FileNameLower has_any (WatchPatterns)\r\n        or\r\n        CommandLineLower has_any (WatchPatterns)\r\n\r\n    | project\r\n        Timestamp,\r\n        DeviceId,\r\n        DeviceName,\r\n        User = InitiatingProcessAccountUpn,\r\n        FileName,\r\n        FileNameLower,\r\n        FolderPath,\r\n        ProcessCommandLine,\r\n        CommandLineLower,\r\n        SHA1,\r\n        SHA256;\r\n\r\n\r\n// ============================================================\r\n// FILENAME WATCHLIST\r\n// ============================================================\r\n\r\nlet FileNameWatchlist =\r\n    AgentWatchlist\r\n\r\n    | where MatchField =~ \"FileName\"\r\n\r\n    | project\r\n        Name,\r\n        Category,\r\n        Pattern,\r\n        SearchPattern,\r\n        MatchType,\r\n        RiskLevel,\r\n        DefaultAction,\r\n        Reason;\r\n\r\n\r\n// ============================================================\r\n// COMMAND-LINE WATCHLIST\r\n// ============================================================\r\n\r\nlet CommandLineWatchlist =\r\n    AgentWatchlist\r\n\r\n    | where MatchField =~ \"ProcessCommandLine\"\r\n\r\n    | project\r\n        Name,\r\n        Category,\r\n        Pattern,\r\n        SearchPattern,\r\n        MatchType,\r\n        RiskLevel,\r\n        DefaultAction,\r\n        Reason;\r\n\r\n\r\n// ============================================================\r\n// FILENAME MATCHES\r\n// ============================================================\r\n\r\nlet FileNameMatches =\r\n    CandidateProcesses\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        FileNameWatchlist\r\n        | extend JoinKey = 1\r\n    ) on JoinKey\r\n\r\n    | extend IsMatch =\r\n        case(\r\n            MatchType =~ \"Exact\",\r\n                FileNameLower == SearchPattern,\r\n\r\n            MatchType =~ \"Contains\",\r\n                FileNameLower contains SearchPattern,\r\n\r\n            MatchType =~ \"Wildcard\",\r\n                FileNameLower contains SearchPattern,\r\n\r\n            false\r\n        )\r\n\r\n    | where IsMatch\r\n\r\n    | extend MatchedOn =\r\n        \"FileName\"\r\n\r\n    | project\r\n        Timestamp,\r\n        DeviceId,\r\n        DeviceName,\r\n        User,\r\n        Name,\r\n        Category,\r\n        RiskLevel,\r\n        DefaultAction,\r\n        Reason,\r\n        MatchedOn,\r\n        Pattern,\r\n        FileName,\r\n        FileNameLower,\r\n        FolderPath,\r\n        ProcessCommandLine,\r\n        SHA256;\r\n\r\n\r\n// ============================================================\r\n// COMMAND-LINE MATCHES\r\n// ============================================================\r\n\r\nlet CommandLineMatches =\r\n    CandidateProcesses\r\n\r\n    | where isnotempty(ProcessCommandLine)\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        CommandLineWatchlist\r\n        | extend JoinKey = 1\r\n    ) on JoinKey\r\n\r\n    | extend IsMatch =\r\n        case(\r\n            MatchType =~ \"Exact\",\r\n                CommandLineLower == SearchPattern,\r\n\r\n            MatchType =~ \"Contains\",\r\n                CommandLineLower contains SearchPattern,\r\n\r\n            MatchType =~ \"Wildcard\",\r\n                CommandLineLower contains SearchPattern,\r\n\r\n            false\r\n        )\r\n\r\n    | where IsMatch\r\n\r\n    | extend MatchedOn =\r\n        \"ProcessCommandLine\"\r\n\r\n    | project\r\n        Timestamp,\r\n        DeviceId,\r\n        DeviceName,\r\n        User,\r\n        Name,\r\n        Category,\r\n        RiskLevel,\r\n        DefaultAction,\r\n        Reason,\r\n        MatchedOn,\r\n        Pattern,\r\n        FileName,\r\n        FileNameLower,\r\n        FolderPath,\r\n        ProcessCommandLine,\r\n        SHA256;\r\n\r\n\r\n// ============================================================\r\n// COMBINE WATCHLIST MATCHES\r\n// ============================================================\r\n\r\nlet AllMatches =\r\n    union\r\n        FileNameMatches,\r\n        CommandLineMatches;\r\n\r\n\r\n// ============================================================\r\n// APPLY GOVERNANCE POLICY\r\n//\r\n// Because both sides now contain FileNameLower, this is a\r\n// simple same-column leftouter join.\r\n// ============================================================\r\n\r\nlet GovernedMatches =\r\n    AllMatches\r\n\r\n    | join kind=leftouter (\r\n        AIProcessPolicy\r\n    ) on FileNameLower\r\n\r\n    | extend Governance =\r\n        case(\r\n            isnull(IsSanctioned),\r\n                \"⚪ Not mapped to policy\",\r\n\r\n            IsSanctioned == true,\r\n                \"🟢 Sanctioned\",\r\n\r\n            \"🔴 Unsanctioned\"\r\n        );\r\n\r\n\r\n// ============================================================\r\n// SUMMARISE\r\n//\r\n// One row per detected tool / watchlist match.\r\n// ============================================================\r\n\r\nGovernedMatches\r\n\r\n| summarize\r\n\r\n    FirstSeen =\r\n        min(Timestamp),\r\n\r\n    LastSeen =\r\n        max(Timestamp),\r\n\r\n    Events =\r\n        count(),\r\n\r\n    Users =\r\n        dcount(User),\r\n\r\n    Devices =\r\n        dcount(DeviceId),\r\n\r\n    UserList =\r\n        make_set_if(\r\n            User,\r\n            isnotempty(User),\r\n            30\r\n        ),\r\n\r\n    DeviceList =\r\n        make_set_if(\r\n            DeviceName,\r\n            isnotempty(DeviceName),\r\n            30\r\n        ),\r\n\r\n    ExampleUser =\r\n        any(User),\r\n\r\n    ExampleProcess =\r\n        any(FileName),\r\n\r\n    ExamplePath =\r\n        any(FolderPath),\r\n\r\n    ExampleCommandLine =\r\n        any(ProcessCommandLine),\r\n\r\n    ExampleSHA256 =\r\n        any(SHA256),\r\n\r\n    Reason =\r\n        any(Reason),\r\n\r\n    AIProvider =\r\n        any(AIProvider),\r\n\r\n    AIProduct =\r\n        any(AIProduct),\r\n\r\n    AIDomain =\r\n        any(AIDomain)\r\n\r\n  by\r\n    Governance,\r\n    Name,\r\n    Category,\r\n    RiskLevel,\r\n    DefaultAction,\r\n    MatchedOn,\r\n    Pattern\r\n\r\n\r\n// ============================================================\r\n// RISK DISPLAY\r\n// ============================================================\r\n\r\n| extend RiskOrder =\r\n    case(\r\n        RiskLevel =~ \"High\",\r\n            1,\r\n\r\n        RiskLevel =~ \"Medium\",\r\n            2,\r\n\r\n        RiskLevel =~ \"Low\",\r\n            3,\r\n\r\n        4\r\n    )\r\n\r\n| extend Risk =\r\n    case(\r\n        RiskLevel =~ \"High\",\r\n            \"🔴 High\",\r\n\r\n        RiskLevel =~ \"Medium\",\r\n            \"🟠 Medium\",\r\n\r\n        RiskLevel =~ \"Low\",\r\n            \"🟡 Low\",\r\n\r\n        strcat(\r\n            \"⚪ \",\r\n            tostring(RiskLevel)\r\n        )\r\n    )\r\n\r\n\r\n// ============================================================\r\n// GOVERNANCE SORT\r\n// ============================================================\r\n\r\n| extend GovernanceSort =\r\n    case(\r\n        Governance == \"🔴 Unsanctioned\",\r\n            1,\r\n\r\n        Governance == \"⚪ Not mapped to policy\",\r\n            2,\r\n\r\n        Governance == \"🟢 Sanctioned\",\r\n            3,\r\n\r\n        4\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORT\r\n// ============================================================\r\n\r\n| order by\r\n    GovernanceSort asc,\r\n    RiskOrder asc,\r\n    Users desc,\r\n    Events desc,\r\n    LastSeen desc\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    Governance,\r\n\r\n    Risk,\r\n\r\n    Tool =\r\n        Name,\r\n\r\n    ['AI Provider'] =\r\n        AIProvider,\r\n\r\n    ['AI Product'] =\r\n        AIProduct,\r\n\r\n    Category,\r\n\r\n    Users,\r\n\r\n    Devices,\r\n\r\n    ['User List'] =\r\n        UserList,\r\n\r\n    ['Device List'] =\r\n        DeviceList,\r\n\r\n    Match =\r\n        MatchedOn,\r\n\r\n    Process =\r\n        ExampleProcess,\r\n\r\n    CommandLine =\r\n        ExampleCommandLine,\r\n\r\n    Events,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen,\r\n\r\n    DefaultAction,\r\n\r\n    Reason",
              "size": 1,
              "title": "🤖 AI Agent / Tool Detection, count: {$rowCount}",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "gridSettings": {
                "rowLimit": 1000,
                "filter": true,
                "hierarchySettings": {
                  "idColumn": "Risk",
                  "parentColumn": "Tool",
                  "treeType": 0,
                  "expanderColumn": "Tool",
                  "expandTopLevel": false
                }
              },
              "chartSettings": {
                "createOtherGroup": 25
              }
            },
            "name": "query - 3 - Copy"
          },
          {
            "type": 1,
            "content": {
              "json": "**AI Agent / Tool Detection** identifies known AI agents and agentic tools observed executing on managed endpoints during the selected **Time Range**. Where a detected tool can be mapped to the AI product catalogue, it is classified as 🟢 **Sanctioned** or 🔴 **Unsanctioned** using the approved AI policies selected above. Tools that cannot be reliably mapped to that policy are shown as ⚪ **Not mapped to policy**. **Risk** reflects the watchlist classification of the detected tool and is separate from its governance status."
            },
            "name": "text - AI Agent Tool Summary"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// AI USAGE & ADOPTION\r\n//\r\n// Shows how regularly recognised AI products are being used\r\n// during the selected Workbook TimeRange.\r\n//\r\n// Measures:\r\n//   - Users\r\n//   - Devices\r\n//   - Active Days\r\n//   - Observed Sessions\r\n//   - Activity Events\r\n//   - First / Last Seen\r\n//\r\n// IMPORTANT:\r\n// \"Observed Sessions\" are inferred from telemetry.\r\n// A new session starts where more than 30 minutes has elapsed\r\n// since the previous observation for the same user/product.\r\n//\r\n// This is NOT a measure of foreground application time or\r\n// actual time spent using an AI service.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// TIME RANGE\r\n// ============================================================\r\n\r\nlet RangeStart =\r\n    todatetime({TimeRange:start});\r\n\r\nlet RangeEnd =\r\n    todatetime({TimeRange:end});\r\n\r\nlet RangeDays =\r\n    datetime_diff(\r\n        \"day\",\r\n        startofday(RangeEnd),\r\n        startofday(RangeStart)\r\n    ) + 1;\r\n\r\n\r\n// ============================================================\r\n// PUBLIC AI CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData =\r\n    externaldata(\r\n        Provider:string,\r\n        Product:string,\r\n        Domain:string,\r\n        Category:string,\r\n        Sanctioned:bool,\r\n        RiskType:string,\r\n        SourceURL:string,\r\n        ProcessName:string,\r\n        ProcessProductName:string,\r\n        ProcessPublisher:string\r\n    )\r\n    [\r\n        @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n    ]\r\n    with (\r\n        format=\"csv\",\r\n        ignoreFirstRecord=true\r\n    )\r\n\r\n    | extend\r\n        Sanctioned = false,\r\n        CatalogueSource = \"Public\",\r\n        SourcePriority = 1\r\n\r\n    | extend PolicyKey =\r\n        trim(\r\n            @\"^-+|-+$\",\r\n            replace_regex(\r\n                tolower(\r\n                    strcat(\r\n                        Provider,\r\n                        \"-\",\r\n                        Product\r\n                    )\r\n                ),\r\n                @\"[^a-z0-9]+\",\r\n                \"-\"\r\n            )\r\n        )\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", Domain)\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", ProcessName)\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Provider)\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Product)\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL AIGOVERNANCE WATCHLIST\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    // Raw Watchlist may contain historical versions.\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key =\r\n            tostring(W.Key),\r\n\r\n        PolicyKey =\r\n            tostring(W.PolicyKey),\r\n\r\n        Provider =\r\n            tostring(W.Provider),\r\n\r\n        Product =\r\n            tostring(W.Product),\r\n\r\n        Domain =\r\n            tostring(W.Domain),\r\n\r\n        Category =\r\n            tostring(W.Category),\r\n\r\n        Sanctioned =\r\n            tobool(W.Sanctioned),\r\n\r\n        RiskType =\r\n            tostring(W.RiskType),\r\n\r\n        SourceURL =\r\n            tostring(W.SourceURL),\r\n\r\n        ProcessName =\r\n            tostring(W.ProcessName),\r\n\r\n        ProcessProductName =\r\n            tostring(W.ProcessProductName),\r\n\r\n        ProcessPublisher =\r\n            tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", Domain)\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(@\"^\\s+|\\s+$\", ProcessName)\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Provider)\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(@\"^\\s+|\\s+$\", Product)\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED POLICIES\r\n//\r\n// JSON formatting is used because Sanctioned is a multi-select\r\n// Workbook parameter containing PolicyKey values.\r\n// ============================================================\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED POLICIES\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | summarize\r\n            make_set(\r\n                Domain,\r\n                1000\r\n            )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// NETWORK ACTIVITY\r\n// ============================================================\r\n\r\nlet NetworkActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        RangeStart\r\n        ..\r\n        RangeEnd\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any(\r\n        AIDomains\r\n    )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        Timestamp,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        IsSanctioned,\r\n        EvidenceType = \"Network\";\r\n\r\n\r\n// ============================================================\r\n// PROCESS CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP / CLIENT ACTIVITY\r\n// ============================================================\r\n\r\nlet DesktopActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        RangeStart\r\n        ..\r\n        RangeEnd\r\n    )\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower\r\n            == CatalogueProductNameLower\r\n        or isempty(\r\n            ProcessVersionInfoProductName\r\n        )\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has\r\n            CataloguePublisherLower\r\n        or isempty(\r\n            ProcessVersionInfoCompanyName\r\n        )\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = AccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        IsSanctioned,\r\n        EvidenceType = \"Desktop Client\";\r\n\r\n\r\n// ============================================================\r\n// COMBINED OBSERVATIONS\r\n// ============================================================\r\n\r\nlet Observations =\r\n    union\r\n        NetworkActivity,\r\n        DesktopActivity\r\n\r\n    | where isnotempty(User)\r\n        and isnotempty(PolicyKey)\r\n\r\n    // Remove duplicate matches for the same telemetry moment.\r\n    | summarize\r\n        Provider =\r\n            take_any(Provider),\r\n\r\n        Product =\r\n            take_any(Product),\r\n\r\n        IsSanctioned =\r\n            max(IsSanctioned)\r\n\r\n      by\r\n        Timestamp,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// SESSION DETECTION\r\n//\r\n// New session where:\r\n//   - user changes, OR\r\n//   - PolicyKey changes, OR\r\n//   - previous event was more than 30 minutes ago.\r\n//\r\n// This represents an observed telemetry session only.\r\n// ============================================================\r\n\r\nlet SessionActivity =\r\n    Observations\r\n\r\n    | sort by\r\n        User asc,\r\n        PolicyKey asc,\r\n        Timestamp asc\r\n\r\n    | serialize\r\n\r\n    | extend\r\n        PreviousUser =\r\n            prev(User),\r\n\r\n        PreviousPolicyKey =\r\n            prev(PolicyKey),\r\n\r\n        PreviousTimestamp =\r\n            prev(Timestamp)\r\n\r\n    | extend IsNewSession =\r\n        iff(\r\n            User != PreviousUser\r\n            or PolicyKey != PreviousPolicyKey\r\n            or isnull(PreviousTimestamp)\r\n            or Timestamp >\r\n                PreviousTimestamp + 30m,\r\n            1,\r\n            0\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EVIDENCE TYPE SUMMARY\r\n//\r\n// Kept separately from the session calculation so evidence\r\n// types do not duplicate session rows.\r\n// ============================================================\r\n\r\nlet EvidenceSummary =\r\n    union\r\n        NetworkActivity,\r\n        DesktopActivity\r\n\r\n    | summarize\r\n        EvidenceTypes =\r\n            make_set(\r\n                EvidenceType,\r\n                10\r\n            )\r\n\r\n      by PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// PRODUCT / POLICY SUMMARY\r\n// ============================================================\r\n\r\nlet ProductSummary =\r\n    SessionActivity\r\n\r\n    | summarize\r\n        Users =\r\n            dcount(User),\r\n\r\n        Devices =\r\n            dcount(DeviceId),\r\n\r\n        ActiveDays =\r\n            dcount(\r\n                startofday(Timestamp)\r\n            ),\r\n\r\n        ObservedSessions =\r\n            sum(IsNewSession),\r\n\r\n        ActivityEvents =\r\n            count(),\r\n\r\n        ProductNames =\r\n            make_set(\r\n                Product,\r\n                20\r\n            ),\r\n\r\n        FirstSeen =\r\n            min(Timestamp),\r\n\r\n        LastSeen =\r\n            max(Timestamp),\r\n\r\n        IsSanctioned =\r\n            max(IsSanctioned)\r\n\r\n      by\r\n        PolicyKey,\r\n        Provider;\r\n\r\n\r\n// ============================================================\r\n// JOIN EVIDENCE TYPES\r\n// ============================================================\r\n\r\nProductSummary\r\n\r\n| join kind=leftouter (\r\n    EvidenceSummary\r\n) on PolicyKey\r\n\r\n\r\n// ============================================================\r\n// FRIENDLY DISPLAY\r\n// ============================================================\r\n\r\n| extend Governance =\r\n    iff(\r\n        IsSanctioned,\r\n        \"🟢 Sanctioned\",\r\n        \"🔴 Unsanctioned\"\r\n    )\r\n\r\n| extend ProductList =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProductNames\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend AIProduct =\r\n    strcat(\r\n        Provider,\r\n        \" - \",\r\n        ProductList\r\n    )\r\n\r\n| extend ActiveDaysDisplay =\r\n    strcat(\r\n        tostring(ActiveDays),\r\n        \" of \",\r\n        tostring(RangeDays),\r\n        iff(\r\n            RangeDays == 1,\r\n            \" day\",\r\n            \" days\"\r\n        )\r\n    )\r\n\r\n| extend Evidence =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            EvidenceTypes\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// ADOPTION PERCENT\r\n//\r\n// Useful for sorting/filtering while retaining the friendly\r\n// \"12 of 30 days\" display.\r\n// ============================================================\r\n\r\n| extend ActiveDayPercent =\r\n    round(\r\n        100.0\r\n        *\r\n        todouble(ActiveDays)\r\n        /\r\n        todouble(RangeDays),\r\n        1\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORT\r\n// ============================================================\r\n\r\n| order by\r\n    ActiveDayPercent desc,\r\n    Users desc,\r\n    ObservedSessions desc,\r\n    ActivityEvents desc\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    Governance,\r\n\r\n    ['AI Product'] =\r\n        AIProduct,\r\n\r\n    Provider,\r\n\r\n    ['Active Days'] =\r\n        ActiveDaysDisplay,\r\n\r\n    ['Active Day %'] =\r\n        ActiveDayPercent,\r\n\r\n    Users,\r\n\r\n    Devices,\r\n\r\n    ['Observed Sessions'] =\r\n        ObservedSessions,\r\n\r\n    ['Activity Events'] =\r\n        ActivityEvents,\r\n\r\n    Evidence,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen,\r\n\r\n    PolicyKey",
              "size": 0,
              "title": "📈 AI Usage & Adoption - {$rowCount} Products",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "gridSettings": {
                "filter": true,
                "sortBy": [
                  {
                    "itemKey": "Users",
                    "sortOrder": 2
                  }
                ]
              },
              "sortBy": [
                {
                  "itemKey": "Users",
                  "sortOrder": 2
                }
              ]
            },
            "name": "query - 2"
          },
          {
            "type": 1,
            "content": {
              "json": "**AI Usage & Adoption** shows how regularly recognised AI products were observed during the selected **Time Range**, including active days, users, devices, observed sessions and activity volume. **Active Days** shows the number of days with observed activity against the total selected period (for example, *12 of 30 days*). **Observed Sessions** are inferred from telemetry using periods of activity separated by more than 30 minutes and should be treated as an indication of usage patterns rather than actual time spent using a service."
            },
            "name": "text - 19"
          },
          {
            "type": 3,
            "content": {
              "version": "KqlItem/1.0",
              "query": "// ============================================================\r\n// AI USAGE BY USER\r\n//\r\n// Shows how regularly each user has been observed using AI\r\n// during the selected Workbook TimeRange.\r\n//\r\n// Measures:\r\n//   - Governance\r\n//   - Active Days\r\n//   - AI Products\r\n//   - AI Providers\r\n//   - Sanctioned / Unsanctioned Products\r\n//   - Observed Sessions\r\n//   - Activity Events\r\n//   - Devices\r\n//   - First / Last Seen\r\n//\r\n// IMPORTANT:\r\n// \"Observed Sessions\" are inferred from telemetry.\r\n// A new session starts where more than 30 minutes has elapsed\r\n// since the previous observation for the same user/product.\r\n//\r\n// This is NOT a measure of foreground application time or\r\n// actual time spent using an AI service.\r\n// ============================================================\r\n\r\n\r\n// ============================================================\r\n// TIME RANGE\r\n// ============================================================\r\n\r\nlet RangeStart =\r\n    todatetime({TimeRange:start});\r\n\r\nlet RangeEnd =\r\n    todatetime({TimeRange:end});\r\n\r\nlet RangeDays =\r\n    datetime_diff(\r\n        \"day\",\r\n        startofday(RangeEnd),\r\n        startofday(RangeStart)\r\n    ) + 1;\r\n\r\n\r\n// ============================================================\r\n// PUBLIC AI CATALOGUE\r\n// ============================================================\r\n\r\nlet PublicAIData =\r\n    externaldata(\r\n        Provider:string,\r\n        Product:string,\r\n        Domain:string,\r\n        Category:string,\r\n        Sanctioned:bool,\r\n        RiskType:string,\r\n        SourceURL:string,\r\n        ProcessName:string,\r\n        ProcessProductName:string,\r\n        ProcessPublisher:string\r\n    )\r\n    [\r\n        @\"https://raw.githubusercontent.com/quorumcyber-workbooks/workbooks/main/Files/QCDataTypes/ai_domains_expanded.csv\"\r\n    ]\r\n    with (\r\n        format=\"csv\",\r\n        ignoreFirstRecord=true\r\n    )\r\n\r\n    | extend\r\n        Sanctioned = false,\r\n        CatalogueSource = \"Public\",\r\n        SourcePriority = 1\r\n\r\n    | extend PolicyKey =\r\n        trim(\r\n            @\"^-+|-+$\",\r\n            replace_regex(\r\n                tolower(\r\n                    strcat(\r\n                        Provider,\r\n                        \"-\",\r\n                        Product\r\n                    )\r\n                ),\r\n                @\"[^a-z0-9]+\",\r\n                \"-\"\r\n            )\r\n        )\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            Domain\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            ProcessName\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Provider\r\n                    )\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Product\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// OPTIONAL LOCAL AIGOVERNANCE WATCHLIST\r\n// ============================================================\r\n\r\nlet LocalAIData =\r\n    Watchlist\r\n\r\n    | where WatchlistAlias == \"AIGovernance\"\r\n\r\n    // Raw Watchlist may contain historical versions.\r\n    | summarize\r\n        arg_max(\r\n            LastUpdatedTimeUTC,\r\n            *\r\n        )\r\n      by SearchKey\r\n\r\n    | where isnotempty(WatchlistItem)\r\n\r\n    | extend W =\r\n        todynamic(WatchlistItem)\r\n\r\n    | project\r\n        Key =\r\n            tostring(W.Key),\r\n\r\n        PolicyKey =\r\n            tostring(W.PolicyKey),\r\n\r\n        Provider =\r\n            tostring(W.Provider),\r\n\r\n        Product =\r\n            tostring(W.Product),\r\n\r\n        Domain =\r\n            tostring(W.Domain),\r\n\r\n        Category =\r\n            tostring(W.Category),\r\n\r\n        Sanctioned =\r\n            tobool(W.Sanctioned),\r\n\r\n        RiskType =\r\n            tostring(W.RiskType),\r\n\r\n        SourceURL =\r\n            tostring(W.SourceURL),\r\n\r\n        ProcessName =\r\n            tostring(W.ProcessName),\r\n\r\n        ProcessProductName =\r\n            tostring(W.ProcessProductName),\r\n\r\n        ProcessPublisher =\r\n            tostring(W.ProcessPublisher)\r\n\r\n    | extend PolicyKey =\r\n        iff(\r\n            isnotempty(PolicyKey),\r\n            PolicyKey,\r\n            Key\r\n        )\r\n\r\n    | extend\r\n        CatalogueSource = \"Local Watchlist\",\r\n        SourcePriority = 2\r\n\r\n    | extend MatchKey =\r\n        case(\r\n            isnotempty(Domain),\r\n                strcat(\r\n                    \"domain:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            Domain\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            isnotempty(ProcessName),\r\n                strcat(\r\n                    \"process:\",\r\n                    tolower(\r\n                        trim(\r\n                            @\"^\\s+|\\s+$\",\r\n                            ProcessName\r\n                        )\r\n                    )\r\n                ),\r\n\r\n            strcat(\r\n                \"product:\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Provider\r\n                    )\r\n                ),\r\n                \"|\",\r\n                tolower(\r\n                    trim(\r\n                        @\"^\\s+|\\s+$\",\r\n                        Product\r\n                    )\r\n                )\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// EFFECTIVE AI CATALOGUE\r\n// ============================================================\r\n\r\nlet AIData =\r\n    union\r\n        PublicAIData,\r\n        LocalAIData\r\n\r\n    | where isnotempty(PolicyKey)\r\n\r\n    | summarize\r\n        arg_max(\r\n            SourcePriority,\r\n            *\r\n        )\r\n      by MatchKey\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        Domain,\r\n        Category,\r\n        RiskType,\r\n        ProcessName,\r\n        ProcessProductName,\r\n        ProcessPublisher,\r\n        PolicyKey,\r\n        CatalogueSource;\r\n\r\n\r\n// ============================================================\r\n// CUSTOMER-SELECTED SANCTIONED POLICIES\r\n// ============================================================\r\n\r\nlet SanctionedPolicies =\r\n    dynamic([{Sanctioned}]);\r\n\r\n\r\n// ============================================================\r\n// KNOWN AI DOMAINS\r\n// ============================================================\r\n\r\nlet AIDomains =\r\n    toscalar(\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | summarize\r\n            make_set(\r\n                Domain,\r\n                1000\r\n            )\r\n    );\r\n\r\n\r\n// ============================================================\r\n// NETWORK ACTIVITY\r\n// ============================================================\r\n\r\nlet NetworkActivity =\r\n    DeviceNetworkEvents\r\n\r\n    | where Timestamp between (\r\n        RangeStart\r\n        ..\r\n        RangeEnd\r\n    )\r\n\r\n    | where isnotempty(\r\n        InitiatingProcessAccountUpn\r\n    )\r\n\r\n    | where isnotempty(RemoteUrl)\r\n\r\n    | where RemoteUrl has_any(\r\n        AIDomains\r\n    )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = InitiatingProcessAccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        RemoteUrl\r\n\r\n    | extend JoinKey = 1\r\n\r\n    | join kind=inner (\r\n        AIData\r\n\r\n        | where isnotempty(Domain)\r\n\r\n        | distinct\r\n            Provider,\r\n            Product,\r\n            Domain,\r\n            PolicyKey\r\n\r\n        | extend JoinKey = 1\r\n\r\n    ) on JoinKey\r\n\r\n    | where RemoteUrl has Domain\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        Timestamp,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        IsSanctioned,\r\n        EvidenceType = \"Network\";\r\n\r\n\r\n// ============================================================\r\n// PROCESS CATALOGUE\r\n// ============================================================\r\n\r\nlet AIProcesses =\r\n    AIData\r\n\r\n    | where isnotempty(ProcessName)\r\n        or isnotempty(ProcessProductName)\r\n        or isnotempty(ProcessPublisher)\r\n\r\n    | project\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n\r\n        CatalogueProcessName =\r\n            ProcessName,\r\n\r\n        CatalogueProductName =\r\n            ProcessProductName,\r\n\r\n        CataloguePublisher =\r\n            ProcessPublisher;\r\n\r\n\r\n// ============================================================\r\n// DESKTOP / CLIENT ACTIVITY\r\n// ============================================================\r\n\r\nlet DesktopActivity =\r\n    DeviceProcessEvents\r\n\r\n    | where Timestamp between (\r\n        RangeStart\r\n        ..\r\n        RangeEnd\r\n    )\r\n\r\n    | where isnotempty(AccountUpn)\r\n\r\n    | extend\r\n        ProcessNameLower =\r\n            tolower(FileName),\r\n\r\n        ProductNameLower =\r\n            tolower(\r\n                ProcessVersionInfoProductName\r\n            ),\r\n\r\n        PublisherLower =\r\n            tolower(\r\n                ProcessVersionInfoCompanyName\r\n            )\r\n\r\n    | join kind=inner (\r\n        AIProcesses\r\n\r\n        | extend\r\n            ProcessNameLower =\r\n                tolower(\r\n                    CatalogueProcessName\r\n                ),\r\n\r\n            CatalogueProductNameLower =\r\n                tolower(\r\n                    CatalogueProductName\r\n                ),\r\n\r\n            CataloguePublisherLower =\r\n                tolower(\r\n                    CataloguePublisher\r\n                )\r\n\r\n    ) on ProcessNameLower\r\n\r\n    | where\r\n        isempty(CatalogueProductName)\r\n        or ProductNameLower\r\n            == CatalogueProductNameLower\r\n        or isempty(\r\n            ProcessVersionInfoProductName\r\n        )\r\n\r\n    | where\r\n        isempty(CataloguePublisher)\r\n        or PublisherLower has\r\n            CataloguePublisherLower\r\n        or isempty(\r\n            ProcessVersionInfoCompanyName\r\n        )\r\n\r\n    | extend IsSanctioned =\r\n        array_length(\r\n            SanctionedPolicies\r\n        ) > 0\r\n        and set_has_element(\r\n            SanctionedPolicies,\r\n            PolicyKey\r\n        )\r\n\r\n    | project\r\n        Timestamp,\r\n        User = AccountUpn,\r\n        DeviceId,\r\n        DeviceName,\r\n        Provider,\r\n        Product,\r\n        PolicyKey,\r\n        IsSanctioned,\r\n        EvidenceType = \"Desktop Client\";\r\n\r\n\r\n// ============================================================\r\n// COMBINED OBSERVATIONS\r\n// ============================================================\r\n\r\nlet Observations =\r\n    union\r\n        NetworkActivity,\r\n        DesktopActivity\r\n\r\n    | where isnotempty(User)\r\n        and isnotempty(PolicyKey)\r\n\r\n    // Remove duplicate catalogue/evidence matches for the same\r\n    // telemetry moment.\r\n    | summarize\r\n        Provider =\r\n            take_any(Provider),\r\n\r\n        Product =\r\n            take_any(Product),\r\n\r\n        IsSanctioned =\r\n            max(IsSanctioned),\r\n\r\n        EvidenceTypes =\r\n            make_set(\r\n                EvidenceType,\r\n                10\r\n            )\r\n\r\n      by\r\n        Timestamp,\r\n        User,\r\n        DeviceId,\r\n        DeviceName,\r\n        PolicyKey;\r\n\r\n\r\n// ============================================================\r\n// SESSION DETECTION\r\n//\r\n// Sessions are calculated separately for each User + PolicyKey.\r\n//\r\n// A new observed session begins if:\r\n//   - this is the first observation, OR\r\n//   - more than 30 minutes elapsed since the previous event.\r\n//\r\n// This is telemetry-based sessionisation, NOT measured\r\n// foreground usage duration.\r\n// ============================================================\r\n\r\nlet SessionActivity =\r\n    Observations\r\n\r\n    | sort by\r\n        User asc,\r\n        PolicyKey asc,\r\n        Timestamp asc\r\n\r\n    | serialize\r\n\r\n    | extend\r\n        PreviousUser =\r\n            prev(User),\r\n\r\n        PreviousPolicyKey =\r\n            prev(PolicyKey),\r\n\r\n        PreviousTimestamp =\r\n            prev(Timestamp)\r\n\r\n    | extend IsNewSession =\r\n        iff(\r\n            User != PreviousUser\r\n            or PolicyKey != PreviousPolicyKey\r\n            or isnull(PreviousTimestamp)\r\n            or Timestamp >\r\n                PreviousTimestamp + 30m,\r\n            1,\r\n            0\r\n        );\r\n\r\n\r\n// ============================================================\r\n// USER / PRODUCT SUMMARY\r\n//\r\n// Collapse evidence into one logical PolicyKey per user.\r\n// ============================================================\r\n\r\nlet UserProducts =\r\n    SessionActivity\r\n\r\n    | summarize\r\n        Provider =\r\n            take_any(Provider),\r\n\r\n        ProductNames =\r\n            make_set(\r\n                Product,\r\n                20\r\n            ),\r\n\r\n        IsSanctioned =\r\n            max(IsSanctioned),\r\n\r\n        ActiveDays =\r\n            dcount(\r\n                startofday(Timestamp)\r\n            ),\r\n\r\n        Sessions =\r\n            sum(IsNewSession),\r\n\r\n        Events =\r\n            count(),\r\n\r\n        FirstSeen =\r\n            min(Timestamp),\r\n\r\n        LastSeen =\r\n            max(Timestamp),\r\n\r\n        Devices =\r\n            dcount(DeviceId),\r\n\r\n        DeviceList =\r\n            make_set_if(\r\n                DeviceName,\r\n                isnotempty(DeviceName),\r\n                50\r\n            ),\r\n\r\n        EvidenceTypes =\r\n            make_set(\r\n                EvidenceTypes,\r\n                20\r\n            )\r\n\r\n      by\r\n        User,\r\n        PolicyKey\r\n\r\n    | extend ProductLabel =\r\n        strcat(\r\n            iff(\r\n                IsSanctioned,\r\n                \"🟢 \",\r\n                \"🔴 \"\r\n            ),\r\n            strcat_array(\r\n                array_sort_asc(\r\n                    ProductNames\r\n                ),\r\n                \" / \"\r\n            )\r\n        );\r\n\r\n\r\n// ============================================================\r\n// USER SUMMARY\r\n// ============================================================\r\n\r\nUserProducts\r\n\r\n| summarize\r\n\r\n    AIProducts =\r\n        dcount(PolicyKey),\r\n\r\n    AIProviders =\r\n        dcount(Provider),\r\n\r\n    SanctionedProducts =\r\n        dcountif(\r\n            PolicyKey,\r\n            IsSanctioned\r\n        ),\r\n\r\n    UnsanctionedProducts =\r\n        dcountif(\r\n            PolicyKey,\r\n            not(IsSanctioned)\r\n        ),\r\n\r\n    ProductsObserved =\r\n        make_set(\r\n            ProductLabel,\r\n            50\r\n        ),\r\n\r\n    ProvidersUsed =\r\n        make_set(\r\n            Provider,\r\n            50\r\n        ),\r\n\r\n    ActiveDays =\r\n        dcount(\r\n            startofday(FirstSeen)\r\n        ),\r\n\r\n    ObservedSessions =\r\n        sum(Sessions),\r\n\r\n    ActivityEvents =\r\n        sum(Events),\r\n\r\n    Devices =\r\n        max(Devices),\r\n\r\n    DeviceList =\r\n        make_set(\r\n            DeviceList,\r\n            50\r\n        ),\r\n\r\n    FirstSeen =\r\n        min(FirstSeen),\r\n\r\n    LastSeen =\r\n        max(LastSeen)\r\n\r\n  by User\r\n\r\n\r\n// ============================================================\r\n// ACTIVE DAYS\r\n//\r\n// Calculate true distinct user activity dates directly from\r\n// the original observations, because a user may use multiple\r\n// products on the same day.\r\n// ============================================================\r\n\r\n| join kind=leftouter (\r\n    Observations\r\n\r\n    | summarize\r\n        TrueActiveDays =\r\n            dcount(\r\n                startofday(Timestamp)\r\n            )\r\n\r\n      by User\r\n\r\n) on User\r\n\r\n| extend ActiveDays =\r\n    coalesce(\r\n        TrueActiveDays,\r\n        0\r\n    )\r\n\r\n\r\n// ============================================================\r\n// GOVERNANCE\r\n// ============================================================\r\n\r\n| extend Governance =\r\n    case(\r\n        SanctionedProducts > 0\r\n            and UnsanctionedProducts > 0,\r\n            \"🟠 Mixed\",\r\n\r\n        UnsanctionedProducts > 0,\r\n            \"🔴 Unsanctioned only\",\r\n\r\n        SanctionedProducts > 0,\r\n            \"🟢 Sanctioned only\",\r\n\r\n        \"⚪ Review\"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// FRIENDLY DISPLAY\r\n// ============================================================\r\n\r\n| extend ['Active Days'] =\r\n    strcat(\r\n        tostring(ActiveDays),\r\n        \" of \",\r\n        tostring(RangeDays),\r\n        iff(\r\n            RangeDays == 1,\r\n            \" day\",\r\n            \" days\"\r\n        )\r\n    )\r\n\r\n| extend ['Active Day %'] =\r\n    round(\r\n        100.0\r\n        *\r\n        todouble(ActiveDays)\r\n        /\r\n        todouble(RangeDays),\r\n        1\r\n    )\r\n\r\n| extend ['Products Observed'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProductsObserved\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n| extend ['Providers Used'] =\r\n    strcat_array(\r\n        array_sort_asc(\r\n            ProvidersUsed\r\n        ),\r\n        \", \"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// USAGE PROFILE\r\n// ============================================================\r\n\r\n| extend UsageProfile =\r\n    case(\r\n        ['Active Day %'] >= 75,\r\n            \"Frequent\",\r\n\r\n        ['Active Day %'] >= 40,\r\n            \"Regular\",\r\n\r\n        ['Active Day %'] >= 10,\r\n            \"Occasional\",\r\n\r\n        \"Limited\"\r\n    )\r\n\r\n\r\n// ============================================================\r\n// SORT\r\n// ============================================================\r\n\r\n| extend GovernanceSort =\r\n    case(\r\n        Governance == \"🔴 Unsanctioned only\", 1,\r\n        Governance == \"🟠 Mixed\", 2,\r\n        Governance == \"🟢 Sanctioned only\", 3,\r\n        4\r\n    )\r\n\r\n| order by\r\n    ['Active Day %'] desc,\r\n    AIProducts desc,\r\n    ObservedSessions desc,\r\n    ActivityEvents desc\r\n\r\n\r\n// ============================================================\r\n// OUTPUT\r\n// ============================================================\r\n\r\n| project\r\n    Governance,\r\n\r\n    User,\r\n\r\n    ['Active Days'],\r\n\r\n    ['Active Day %'],\r\n\r\n    ['Usage Profile'] =\r\n        UsageProfile,\r\n\r\n    ['AI Products'] =\r\n        AIProducts,\r\n\r\n    ['Sanctioned Products'] =\r\n        SanctionedProducts,\r\n\r\n    ['Unsanctioned Products'] =\r\n        UnsanctionedProducts,\r\n\r\n    ['Products Observed'],\r\n\r\n    ['AI Providers'] =\r\n        AIProviders,\r\n\r\n    ['Providers Used'],\r\n\r\n    ['Observed Sessions'] =\r\n        ObservedSessions,\r\n\r\n    ['Activity Events'] =\r\n        ActivityEvents,\r\n\r\n    Devices,\r\n\r\n    ['First Seen'] =\r\n        FirstSeen,\r\n\r\n    ['Last Seen'] =\r\n        LastSeen",
              "size": 0,
              "title": "👤 AI Usage by User - {$rowCount} ",
              "timeContextFromParameter": "TimeRange",
              "showExportToExcel": true,
              "queryType": 0,
              "resourceType": "microsoft.operationalinsights/workspaces",
              "crossComponentResources": [
                "{ws}"
              ],
              "gridSettings": {
                "filter": true
              }
            },
            "name": "query - 2 - Copy"
          },
          {
            "type": 1,
            "content": {
              "json": "**AI Usage by User** shows how regularly individual users were observed accessing AI services during the selected **Time Range**. Products are marked 🟢 **Sanctioned** or 🔴 **Unsanctioned**, with active days, observed sessions, product/provider usage and supporting activity shown for each user. Session and activity measures indicate observed usage patterns and do not represent actual foreground time spent using an AI service."
            },
            "name": "text - 20"
          }
        ]
      },
      "name": "group - AI "
    }
  ],
  "fromTemplateId": "sentinel-UserWorkbook",
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json"
}